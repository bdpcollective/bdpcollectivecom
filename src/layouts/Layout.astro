---
import Footer from '../components/Footer.astro';
import { baseUrl } from '../config';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<title>Brian Pope | bdpcollective</title>
		<!-- Google Analytics -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-8B6D7GXRG2"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				// @ts-ignore
				dataLayer.push(arguments);
			}
			// @ts-ignore
			gtag('js', new Date());
			// @ts-ignore
			gtag('config', 'G-8B6D7GXRG2');
		</script>
		<slot name="head" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="min-h-screen flex flex-col font-franklin">
		<nav class="bg-white shadow-sm">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between h-16">
					<div class="flex">
						<a href={`${baseUrl}/`} class="flex items-center">
							<span class="text-xl font-bold">BRIAN POPE</span>
						</a>
					</div>
					<div class="hidden md:flex items-center space-x-4">
						<a href={`${baseUrl}/`} class="text-gray-700 hover:text-gray-900">Home</a>
						<a href={`${baseUrl}/ux-portfolio`} class="text-gray-700 hover:text-gray-900">UX Portfolio</a>
						<a href={`${baseUrl}/logos`} class="text-gray-700 hover:text-gray-900">Logos</a>
						<a href={`${baseUrl}/data-visualization`} class="text-gray-700 hover:text-gray-900">Data Visualization</a>
						<a href={`${baseUrl}/images`} class="text-gray-700 hover:text-gray-900">Images</a>
					</div>
					<div class="md:hidden flex items-center">
						<button id="mobile-menu-button" class="text-gray-700 hover:text-gray-900 focus:outline-none">
							<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
							</svg>
						</button>
					</div>
				</div>
			</div>
			<!-- Mobile menu -->
			<div id="mobile-menu" class="hidden md:hidden fixed inset-0 z-50 bg-white overflow-y-auto">
				<div class="flex justify-end p-4">
					<button id="close-menu-button" class="text-gray-700 hover:text-gray-900 focus:outline-none">
						<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
						</svg>
					</button>
				</div>
				<div class="flex flex-col items-center space-y-6 py-8">
					<a href={`${baseUrl}/`} class="text-xl text-gray-700 hover:text-gray-900">Home</a>
					<a href={`${baseUrl}/ux-portfolio`} class="text-xl text-gray-700 hover:text-gray-900">UX Portfolio</a>
					<a href={`${baseUrl}/logos`} class="text-xl text-gray-700 hover:text-gray-900">Logos</a>
					<a href={`${baseUrl}/data-visualization`} class="text-xl text-gray-700 hover:text-gray-900">Data Visualization</a>
					<a href={`${baseUrl}/images`} class="text-xl text-gray-700 hover:text-gray-900">Images</a>
				</div>
			</div>
		</nav>

		<main class="flex-grow">
			<slot />
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}
	html {
		font-family: "Libre Franklin", "Franklin Gothic", "ITC Franklin Gothic", "Franklin Gothic Medium", "Franklin Gothic Book", "Franklin Gothic Demi", "Franklin Gothic Heavy", system-ui, sans-serif;
		background: #f6f6f6;
		background-size: 224px;
	}
	body {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
		overflow-x: hidden;
		overflow-y: auto !important;
	}
	
	/* Override any global overflow:hidden that might be preventing scrolling */
	html, body {
		overflow: auto !important;
		height: auto !important;
	}
	code {
		font-family: Menlo, Monaco, Lucida Console, Liberation Mono, DejaVu Sans Mono,
			Bitstream Vera Sans Mono, Courier New, monospace;
	}
</style>

<script>
	// Mobile menu functionality
	const mobileMenuButton = document.getElementById('mobile-menu-button');
	const closeMenuButton = document.getElementById('close-menu-button');
	const mobileMenu = document.getElementById('mobile-menu');

	function openMobileMenu() {
		if (mobileMenu) {
			mobileMenu.classList.remove('hidden');
			document.body.style.overflow = 'hidden';
		}
	}

	function closeMobileMenu() {
		if (mobileMenu) {
			mobileMenu.classList.add('hidden');
			document.body.style.overflow = '';
		}
	}

	mobileMenuButton?.addEventListener('click', openMobileMenu);
	closeMenuButton?.addEventListener('click', closeMobileMenu);

	// Close menu when clicking a link
	mobileMenu?.querySelectorAll('a').forEach(link => {
		link.addEventListener('click', closeMobileMenu);
	});

	// Close menu when clicking outside
	mobileMenu?.addEventListener('click', (e) => {
		if (e.target === mobileMenu) {
			closeMobileMenu();
		}
	});

	// Ensure scrolling is restored on page load/refresh
	document.addEventListener('DOMContentLoaded', () => {
		document.body.style.overflow = '';
	});

	// Handle escape key
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && mobileMenu && !mobileMenu.classList.contains('hidden')) {
			closeMobileMenu();
		}
	});
</script>
