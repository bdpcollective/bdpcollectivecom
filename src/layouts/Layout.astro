---
import Footer from '../components/Footer.astro';
import { baseUrl } from '../config';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title: string;
}
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<title>Brian Pope | bdpcollective</title>

		<!-- DNS prefetch for external domains -->
		<link rel="dns-prefetch" href="https://fonts.googleapis.com">
		<link rel="dns-prefetch" href="https://fonts.gstatic.com">
		<link rel="dns-prefetch" href="https://www.googletagmanager.com">

		<!-- Preconnect to critical domains ASAP -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preconnect" href="https://www.googletagmanager.com">

		<!-- Preload critical font file for faster rendering -->
		<link rel="preload" as="font" type="font/woff2" href="https://fonts.gstatic.com/s/librefranklin/v14/jizDREVItHgc8qDIbSTKq4XkRg8T88bjFuXOnduhLsSUB9rIb-JH1g.woff2" crossorigin>

		<!-- Async Google Fonts with font-display: swap for non-blocking load -->
		<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'; this.onload=null;">
		<noscript>
			<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;600;700&display=swap" rel="stylesheet">
		</noscript>

		<!-- Inline Critical CSS for faster initial render -->
		<style>
			:root {
				--accent: 136, 58, 234;
				--accent-light: 224, 204, 250;
				--accent-dark: 49, 10, 101;
				--accent-gradient: linear-gradient(45deg, rgb(var(--accent)), rgb(var(--accent-light)) 30%, white 60%);
			}
			html {
				font-family: "Libre Franklin", "Franklin Gothic", "ITC Franklin Gothic", "Franklin Gothic Medium", "Franklin Gothic Book", "Franklin Gothic Demi", "Franklin Gothic Heavy", system-ui, sans-serif;
				background: #f6f6f6;
				background-size: 224px;
				width: 100%;
				max-width: 100%;
			}
			body {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
				overflow-x: hidden;
				width: 100%;
				max-width: 100%;
			}
			* {
				box-sizing: border-box;
			}
			main {
				overflow-x: hidden;
				width: 100%;
				max-width: 100%;
			}
			/* Page Transitions */
			::view-transition-old(root),
			::view-transition-new(root) {
				animation-duration: 0.5s;
				animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
			}
			::view-transition-old(root) {
				animation-name: slide-out;
			}
			::view-transition-new(root) {
				animation-name: slide-in;
			}
			@keyframes slide-out {
				to {
					opacity: 0;
					transform: translateX(-20px);
				}
			}
			@keyframes slide-in {
				from {
					opacity: 0;
					transform: translateX(20px);
				}
			}
			/* Prevent layout shift for images */
			img {
				max-width: 100%;
				height: auto;
			}
			/* Critical navigation styles */
			nav {
				background-color: white;
				box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
			}
			/* Critical button and link styles */
			button {
				cursor: pointer;
				border: none;
				background: transparent;
			}
			a {
				text-decoration: none;
				color: inherit;
			}
			/* Creative Navigation Styles */
			.nav-link {
				position: relative;
				display: inline-block;
			}
			.nav-link::before {
				content: attr(data-text);
				font-weight: 600;
				height: 0;
				visibility: hidden;
				overflow: hidden;
				user-select: none;
				pointer-events: none;
				display: block;
			}
			.nav-link::after {
				content: '';
				position: absolute;
				bottom: 0;
				left: 50%;
				width: 0;
				height: 2px;
				background: currentColor;
				transition: all 0.3s ease-out;
				transform: translateX(-50%);
			}
			.nav-link span {
				display: block;
			}
			.nav-link:hover::after {
				width: 100%;
			}
			.nav-link.active::after {
				width: 100%;
			}
			/* Morphing Menu Icon */
			#mobile-menu-button.active .hamburger-line:nth-child(1) {
				transform: rotate(45deg) translate(5px, 5px);
			}
			#mobile-menu-button.active .hamburger-line:nth-child(2) {
				opacity: 0;
			}
			#mobile-menu-button.active .hamburger-line:nth-child(3) {
				transform: rotate(-45deg) translate(5px, -5px);
			}
			/* Custom Cursor */
			.custom-cursor-enabled {
				cursor: none;
			}
			.custom-cursor {
				position: fixed;
				width: 8px;
				height: 8px;
				background: rgba(255, 255, 255, 0.9);
				border-radius: 50%;
				pointer-events: none;
				transform: translate(-50%, -50%);
				transition: width 0.15s ease-out, height 0.15s ease-out, background 0.15s ease-out;
				z-index: 99999;
				opacity: 0;
				will-change: left, top;
				mix-blend-mode: difference;
			}
			.custom-cursor.visible {
				opacity: 1;
			}
			.custom-cursor.hover {
				width: 32px;
				height: 32px;
				background: rgba(59, 130, 246, 0.6);
			}
			.custom-cursor.click {
				width: 6px;
				height: 6px;
			}
			/* Scroll Progress Indicator */
			.scroll-progress-bar {
				position: fixed;
				top: 0;
				left: 0;
				width: 0%;
				height: 3px;
				background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899);
				z-index: 10001;
				transition: width 0.1s ease-out;
				box-shadow: 0 0 10px rgba(59, 130, 246, 0.5);
			}
			/* Ensure link hover is visible */
			a.nav-link:hover {
				color: rgb(0, 0, 0) !important;
			}
			a.nav-link:hover span {
				font-weight: 600;
			}
			/* Critical above-fold styles for mobile */
			@media (max-width: 768px) {
				h1 {
					font-size: 2.25rem;
					line-height: 2.5rem;
				}
				.container {
					padding-left: 1rem;
					padding-right: 1rem;
				}
			}
		</style>

		<!-- Google Analytics - Loaded with requestIdleCallback for better performance -->
		<script is:inline>
			// Load Google Analytics during browser idle time to avoid blocking main thread
			(function() {
				var loadGA = function() {
					var script = document.createElement('script');
					script.async = true;
					script.src = 'https://www.googletagmanager.com/gtag/js?id=G-8B6D7GXRG2';
					document.head.appendChild(script);

					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', 'G-8B6D7GXRG2');
				};

				// Use requestIdleCallback if available, otherwise fallback to setTimeout
				if ('requestIdleCallback' in window) {
					requestIdleCallback(loadGA, { timeout: 3000 });
				} else {
					setTimeout(loadGA, 3000);
				}
			})();
		</script>

		<slot name="head" />
		<ClientRouter />
	</head>
	<body class="min-h-screen flex flex-col font-franklin custom-cursor-enabled overflow-x-hidden">
		<div id="custom-cursor" class="custom-cursor" transition:persist></div>
		<div id="scroll-progress" class="scroll-progress-bar"></div>
		<nav class="bg-white/80 backdrop-blur-md shadow-sm glass-nav w-full overflow-x-hidden">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
				<div class="flex justify-between h-16">
					<div class="flex">
						<a href={`${baseUrl}/`} class="flex items-center">
							<span class="text-xl font-bold">BRIAN POPE</span>
						</a>
					</div>
					<div class="hidden md:flex items-center space-x-4 relative">
						<a href={`${baseUrl}/`} class="nav-link text-gray-700 hover:text-black relative px-2 py-1 font-medium transition-colors" data-path="/" data-text="Home"><span>Home</span></a>
						<a href={`${baseUrl}/ux-portfolio`} class="nav-link text-gray-700 hover:text-black relative px-2 py-1 font-medium transition-colors" data-path="/ux-portfolio" data-text="UX Portfolio"><span>UX Portfolio</span></a>
						<a href={`${baseUrl}/apps`} class="nav-link text-gray-700 hover:text-black relative px-2 py-1 font-medium transition-colors" data-path="/apps" data-text="Apps"><span>Apps</span></a>
						<a href={`${baseUrl}/logos`} class="nav-link text-gray-700 hover:text-black relative px-2 py-1 font-medium transition-colors" data-path="/logos" data-text="Logos"><span>Logos</span></a>
						<a href={`${baseUrl}/images`} class="nav-link text-gray-700 hover:text-black relative px-2 py-1 font-medium transition-colors" data-path="/images" data-text="Images"><span>Images</span></a>
						<div id="nav-underline" class="absolute bottom-0 h-0.5 bg-gray-900 transition-all duration-300 ease-out"></div>
					</div>
					<div class="md:hidden flex items-center">
						<button id="mobile-menu-button" class="text-gray-700 hover:text-black focus:outline-none relative w-6 h-6 transition-colors" aria-label="Open menu">
							<span class="hamburger-line absolute top-0 left-0 w-full h-0.5 bg-current transition-all duration-300"></span>
							<span class="hamburger-line absolute top-1/2 left-0 w-full h-0.5 bg-current -translate-y-1/2 transition-all duration-300"></span>
							<span class="hamburger-line absolute bottom-0 left-0 w-full h-0.5 bg-current transition-all duration-300"></span>
						</button>
					</div>
				</div>
			</div>
		</nav>

		<!-- Mobile menu - outside nav to avoid z-index issues -->
		<div id="mobile-menu" class="hidden fixed inset-0 z-[9998] bg-white overflow-y-auto md:hidden">
			<div class="flex justify-end p-4">
				<button id="close-menu-button" class="text-gray-700 hover:text-black focus:outline-none transition-colors p-2" aria-label="Close menu">
					<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</button>
			</div>
			<div class="flex flex-col items-center space-y-6 py-8">
				<a href={`${baseUrl}/`} class="text-xl text-gray-700 hover:text-black hover:font-bold font-medium transition-all">Home</a>
				<a href={`${baseUrl}/ux-portfolio`} class="text-xl text-gray-700 hover:text-black hover:font-bold font-medium transition-all">UX Portfolio</a>
				<a href={`${baseUrl}/apps`} class="text-xl text-gray-700 hover:text-black hover:font-bold font-medium transition-all">Apps</a>
				<a href={`${baseUrl}/logos`} class="text-xl text-gray-700 hover:text-black hover:font-bold font-medium transition-all">Logos</a>
				<a href={`${baseUrl}/images`} class="text-xl text-gray-700 hover:text-black hover:font-bold font-medium transition-all">Images</a>
			</div>
		</div>

		<script is:inline>
			(function() {
				function setupMobileMenu() {
					var menuBtn = document.getElementById('mobile-menu-button');
					var closeBtn = document.getElementById('close-menu-button');
					var menu = document.getElementById('mobile-menu');

					if (!menuBtn || !closeBtn || !menu) return;

					menuBtn.onclick = function(e) {
						e.preventDefault();
						menu.classList.remove('hidden');
						document.body.style.overflow = 'hidden';
					};

					closeBtn.onclick = function(e) {
						e.preventDefault();
						menu.classList.add('hidden');
						document.body.style.overflow = '';
					};

					var links = menu.querySelectorAll('a');
					for (var i = 0; i < links.length; i++) {
						links[i].onclick = function() {
							menu.classList.add('hidden');
							document.body.style.overflow = '';
						};
					}
				}

				// Run on initial load
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', setupMobileMenu);
				} else {
					setupMobileMenu();
				}

				// Run after View Transitions
				document.addEventListener('astro:page-load', setupMobileMenu);
			})();
		</script>

		<main class="flex-grow overflow-x-hidden w-full max-w-full">
			<slot />
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	/* Non-critical styles loaded after initial render */
	code {
		font-family: Menlo, Monaco, Lucida Console, Liberation Mono, DejaVu Sans Mono,
			Bitstream Vera Sans Mono, Courier New, monospace;
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		// Creative Navigation - Animated Underline
		const navLinks = document.querySelectorAll('.nav-link');
		const navUnderline = document.getElementById('nav-underline');
		const currentPath = window.location.pathname;

		function updateUnderline(link: HTMLElement) {
			if (!navUnderline) return;
			const rect = link.getBoundingClientRect();
			const nav = link.closest('nav')?.querySelector('.max-w-7xl');
			if (!nav) return;
			const navRect = nav.getBoundingClientRect();

			navUnderline.style.left = `${rect.left - navRect.left}px`;
			navUnderline.style.width = `${rect.width}px`;
		}

		// Set active link based on current path
		navLinks.forEach((link) => {
			const linkElement = link as HTMLElement;
			const linkPath = linkElement.dataset.path || '';

			if (currentPath === linkPath || (linkPath !== '/' && currentPath.startsWith(linkPath))) {
				linkElement.classList.add('active');
				updateUnderline(linkElement);
			}

			// Animate underline on hover
			linkElement.addEventListener('mouseenter', () => {
				updateUnderline(linkElement);
			});
		});

		// Custom Cursor Effects
		const customCursor = document.getElementById('custom-cursor');

		if (customCursor) {
			// Only enable on non-touch devices
			if (window.matchMedia('(pointer: fine)').matches) {
				// Re-bind hover effects on interactive elements for new page content
				const interactiveElements = document.querySelectorAll('a, button, .magnetic-card, .nav-link, .gallery-image');
				interactiveElements.forEach((el) => {
					el.addEventListener('mouseenter', () => {
						customCursor.classList.add('hover');
					});
					el.addEventListener('mouseleave', () => {
						customCursor.classList.remove('hover');
					});
				});
			}
		}

		// Scroll Progress Indicator
		const scrollProgress = document.getElementById('scroll-progress');
		if (scrollProgress) {
			let ticking = false;

			function updateScrollProgress() {
				const windowHeight = window.innerHeight;
				const documentHeight = document.documentElement.scrollHeight;
				const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
				const scrollPercent = (scrollTop / (documentHeight - windowHeight)) * 100;

				scrollProgress.style.width = `${Math.min(scrollPercent, 100)}%`;
				ticking = false;
			}

			function requestProgressTick() {
				if (!ticking) {
					requestAnimationFrame(updateScrollProgress);
					ticking = true;
				}
			}

			window.addEventListener('scroll', requestProgressTick, { passive: true });
			updateScrollProgress();
		}
	});

	// Cursor state stored globally to persist across View Transitions
	declare global {
		interface Window {
			cursorState?: {
				mouseX: number;
				mouseY: number;
				initialized: boolean;
			};
		}
	}

	// Initialize cursor on page load and after View Transitions
	function initCursor() {
		const customCursor = document.getElementById('custom-cursor');

		if (!customCursor) return;
		if (!window.matchMedia('(pointer: fine)').matches) {
			customCursor.style.display = 'none';
			return;
		}

		// Initialize state if not exists
		if (!window.cursorState) {
			window.cursorState = {
				mouseX: 0,
				mouseY: 0,
				initialized: false
			};
		}

		const state = window.cursorState;

		// Only add mousemove listener once
		if (!state.initialized) {
			document.addEventListener('mousemove', (e) => {
				state.mouseX = e.clientX;
				state.mouseY = e.clientY;
				state.initialized = true;

				// Update cursor position directly (no trailing)
				const cursor = document.getElementById('custom-cursor');
				if (cursor) {
					cursor.style.left = `${e.clientX}px`;
					cursor.style.top = `${e.clientY}px`;
					cursor.classList.add('visible');
				}
			});

			document.addEventListener('mousedown', () => {
				const cursor = document.getElementById('custom-cursor');
				if (cursor) cursor.classList.add('click');
			});

			document.addEventListener('mouseup', () => {
				const cursor = document.getElementById('custom-cursor');
				if (cursor) cursor.classList.remove('click');
			});
		}

		// If cursor was already visible, make sure new elements are too
		if (state.initialized) {
			customCursor.classList.add('visible');
			customCursor.style.left = `${state.mouseX}px`;
			customCursor.style.top = `${state.mouseY}px`;
		}
	}

	// Run on initial load
	initCursor();

	// Also run after View Transitions
	document.addEventListener('astro:page-load', initCursor);
</script>
