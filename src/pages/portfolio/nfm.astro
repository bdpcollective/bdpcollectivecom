---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

const content = {
  projectDescription: {
    text: [
      "NFM's Vendor Portal needed a clearer roadmap for vendors and more control for the internal team to keep everything on track.",
      "The project focused on improving the user experience for both vendors and internal team members, making it easier to manage resources and maintain project timelines.",
      "Through careful analysis of user needs and pain points, we developed a solution that streamlined the vendor management process while enhancing internal team capabilities."
    ],
    images: [
      "/portfolio/nfm/1_VendorPortal-Splash.png",
      "/portfolio/nfm/2_VendorPortal-Home.png",
      "/portfolio/nfm/3_VendorPortal-Dashboard.png"
    ]
  },
  userResearch: {
    text: [
      "Our research revealed that vendors often struggled to find and access necessary resources, while internal team members needed better tools to manage vendor relationships and track project progress.",
      "Key findings included the need for improved navigation, better resource organization, and enhanced communication channels between vendors and internal teams."
    ],
    image: "/portfolio/nfm/4_VendorPortal-Research.png"
  },
  informationArchitecture: {
    text: [
      "We developed a clear information architecture that organized resources logically and created intuitive navigation paths for both vendors and internal team members.",
      "The structure prioritized quick access to frequently used resources while maintaining clear hierarchies for more detailed information.",
      "This organization helped reduce confusion and improved efficiency in accessing and managing vendor-related information."
    ],
    image: "/portfolio/nfm/5_VendorPortal-IA.png"
  },
  wireframeMockups: {
    text: [
      "Initial wireframes focused on creating a clean, organized interface that would make it easy for users to find what they needed.",
      "We iterated on these designs based on user feedback, ensuring the layout supported both vendor and internal team workflows."
    ],
    images: [
      "/portfolio/nfm/6_1-Wireframes.png",
      "/portfolio/nfm/6_2-Wireframes.png",
      "/portfolio/nfm/6_3-Wireframes.png",
      "/portfolio/nfm/6_4-Wireframes.png",
      "/portfolio/nfm/6_5-Wireframes.png",
      "/portfolio/nfm/6_6-Wireframes.png"
    ]
  },
  highFidelityMockups: {
    text: [
      "The final design incorporated NFM's brand guidelines while maintaining a professional and efficient interface.",
      "We added interactive elements and clear visual hierarchies to improve usability and make the portal more engaging."
    ],
    images: [
      "/portfolio/nfm/7_1-HighFidelity.png",
      "/portfolio/nfm/7_2-HighFidelity.png",
      "/portfolio/nfm/7_3-HighFidelity.png",
      "/portfolio/nfm/7_4-HighFidelity.png",
      "/portfolio/nfm/7_5-HighFidelity.png",
      "/portfolio/nfm/7_6-HighFidelity.png"
    ]
  }
};
---

<Layout title="Vendor Portal - UX Portfolio">
  <main>
    {/* Hero Section */}
    <section class="relative h-[25vh] bg-black pt-16">
      <div class="relative z-10 flex flex-col justify-center h-full px-4 container mx-auto">
        <div class="max-w-7xl mx-auto w-full">
          <div class="w-24 h-24 flex items-center mb-6">
            <img
              src="/logos/nfm-logo.png"
              alt="NFM logo"
              width="96"
              height="96"
              class="object-contain"
            />
          </div>
          <h1 class="text-4xl md:text-6xl font-bold mb-4 text-white">
            Vendor Portal
          </h1>
          <p class="text-lg md:text-xl text-gray-300 mb-4 max-w-2xl">
            A clearer roadmap for vendors and more control for the internal team
          </p>
        </div>
      </div>
    </section>

    {/* Content Section */}
    <section class="container mx-auto px-4 py-20">
      <div class="max-w-3xl mx-auto space-y-16">
        {/* Back Button */}
        <a 
          href="/ux-portfolio" 
          class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors mb-8"
        >
          <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to UX Portfolio
        </a>

        {/* Project Description */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Project Description</h2>
          <div class="prose max-w-none mb-8">
            {content.projectDescription.text.map((paragraph) => (
              <p class="mb-4">{paragraph}</p>
            ))}
          </div>
          <div class="grid grid-cols-3 gap-4">
            {content.projectDescription.images.map((image) => (
              <div class="rounded-lg overflow-hidden shadow-lg">
                <img
                  src={image}
                  alt="Project description"
                  width="400"
                  height="300"
                  class="object-cover"
                />
              </div>
            ))}
          </div>
        </div>

        {/* User Research */}
        <div>
          <h2 class="text-3xl font-bold mb-6">User Research</h2>
          <div class="prose max-w-none mb-8">
            {content.userResearch.text.map((paragraph) => (
              <p class="mb-4">{paragraph}</p>
            ))}
          </div>
          <div class="rounded-lg overflow-hidden shadow-lg">
            <img
              src={content.userResearch.image}
              alt="User research"
              width="800"
              height="600"
              class="object-contain"
            />
          </div>
        </div>

        {/* Information Architecture */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Information Architecture</h2>
          <div class="prose max-w-none mb-8">
            {content.informationArchitecture.text.map((paragraph) => (
              <p class="mb-4">{paragraph}</p>
            ))}
          </div>
          <div class="rounded-lg overflow-hidden shadow-lg">
            <img
              src={content.informationArchitecture.image}
              alt="Information architecture"
              width="800"
              height="600"
              class="object-contain"
            />
          </div>
        </div>

        {/* Wireframe Mockups */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Wireframe Mockups</h2>
          <div class="prose max-w-none mb-8">
            {content.wireframeMockups.text.map((paragraph) => (
              <p class="mb-4">{paragraph}</p>
            ))}
          </div>
          <div class="grid grid-cols-3 gap-4">
            {content.wireframeMockups.images.map((image) => (
              <div class="rounded-lg overflow-hidden shadow-lg">
                <img
                  src={image}
                  alt="Wireframe mockup"
                  width="400"
                  height="300"
                  class="object-cover"
                />
              </div>
            ))}
          </div>
        </div>

        {/* High-Fidelity Mockups */}
        <div>
          <h2 class="text-3xl font-bold mb-6">High-Fidelity Mockups</h2>
          <div class="prose max-w-none mb-8">
            {content.highFidelityMockups.text.map((paragraph) => (
              <p class="mb-4">{paragraph}</p>
            ))}
          </div>
          <div class="grid grid-cols-3 gap-4">
            {content.highFidelityMockups.images.map((image) => (
              <div class="rounded-lg overflow-hidden shadow-lg">
                <img
                  src={image}
                  alt="High-fidelity mockup"
                  width="400"
                  height="300"
                  class="object-cover"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout> 