---
import Layout from '../../layouts/Layout.astro';
import { baseUrl } from '../../config';

// Helper function to get random number between min and max (inclusive)
function getRandomInt(min: number, max: number): number {
  return Math.floor(Math.random() * (max - min + 1)) + min;
}

const events = [
  {
    title: "2025 Omaha Lacrosse Club",
    events: [
      {
        name: "Blue vs Thunderbirds",
        date: "May 05, 2025",
        image: `/images/olc/20250504-Blue-vs-Thunderbirds/20250504_Thunderbirds - ${getRandomInt(1, 27)}.jpeg`,
        link: "/images/olc/20250504_2_BluevsThunderbirds"
      },
      {
        name: "Blue vs Elkhorn",
        date: "May 04, 2025",
        image: `/images/olc/20250504-Blue-vs-Elkhorn/20250504_Elkhorn - ${getRandomInt(1, 27)}.jpeg`,
        link: "/images/olc/20250504_1_BluevsElkhorn"
      },
      {
        name: "Blue vs Westside",
        date: "April 27, 2025",
        image: `/images/olc/20250427-Blue-vs-Westside/OLC_BluevsWestside - ${getRandomInt(1, 37)}.jpeg`,
        link: "/images/olc/20250427_1_BluevsWestside"
      },
      {
        name: "Blue vs Creighton Prep",
        date: "April 27, 2025",
        image: `/images/olc/20250427-Blue-vs-CreightonPrep/OLC_BluevsCreightonPrep - ${getRandomInt(1, 29)}.jpeg`,
        link: "/images/olc/20250427_2_BluevsCreightonPrep"
      },
      {
        name: "Blue vs Sarpy",
        date: "April 13, 2025",
        image: `/images/olc/20250413-Blue-vs-Sarpy/20250413_BluevsSarpy - ${getRandomInt(1, 29)}.jpeg`,
        link: "/images/olc/20250413_1_BluevsSarpy"
      },
      {
        name: "Blue vs Elkhorn",
        date: "March 30, 2025",
        image: `/images/olc/20250330_2_BluevsElkhorn/20250330_BluevsElkhorn - ${getRandomInt(1, 47)}.jpeg`,
        link: "/images/olc/20250330_2_BluevsElkhorn"
      },
      {
        name: "Blue vs Rampage",
        date: "March 30, 2025",
        image: `/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - ${getRandomInt(1, 16)}.jpeg`,
        link: "/images/olc/20250330_1_BluevsRampage"
      }
    ]
  }
];
---

<Layout title="Omaha Lacrosse Club">
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="text-4xl font-bold text-gray-900 mb-8">Omaha Lacrosse Club</h1>
      
      <a href="/images" class="inline-flex items-center text-gray-600 hover:text-gray-900 mb-8">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Images
      </a>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {events.flatMap((category) => 
          category.events.map((event) => (
            <a href={event.link} class="group relative overflow-hidden rounded-lg">
              <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
                <div class="relative h-64">
                  <img
                    src={event.image}
                    alt={event.name}
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-300"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent">
                    <div class="absolute bottom-0 left-0 right-0 p-4">
                      <h3 class="text-white text-xl font-semibold mb-2">{event.name}</h3>
                      <div class="text-sm text-gray-300">
                        <span>{event.date}</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          ))
        )}
      </div>
    </div>
  </div>
</Layout> 