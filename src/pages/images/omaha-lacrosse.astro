---
import Layout from '../../layouts/Layout.astro';

const events = [
  {
    title: "Blue vs Lincoln Rampage",
    date: "March 30, 2025",
    image: "/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - 1.jpeg",
    slug: "20250330-blue-vs-rampage"
  },
  {
    title: "Blue vs Elkhorn",
    date: "March 30, 2025",
    image: "/images/olc/20250330_2_BluevsElkhorn/20250330_BluevsElkhorn - 1.jpeg",
    slug: "blue-vs-elkhorn"
  }
];
---

<Layout title="Omaha Lacrosse Club">
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <a href="/images" class="inline-flex items-center text-gray-600 hover:text-gray-900 mb-4">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Images
      </a>
      <h1 class="text-4xl font-bold text-gray-900 mb-8">Omaha Lacrosse Club</h1>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {events.map((event) => (
          <a 
            href={`/images/omaha-lacrosse/${event.slug}`}
            class="group relative overflow-hidden rounded-lg"
          >
            <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
              <div class="relative h-64">
                <img
                  src={event.image}
                  alt={event.title}
                  class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent">
                  <div class="absolute bottom-0 left-0 right-0 p-4">
                    <h3 class="text-white text-xl font-semibold">{event.title}</h3>
                    <p class="text-white/80 text-sm">{event.date}</p>
                  </div>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout> 