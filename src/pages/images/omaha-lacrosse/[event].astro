const { title, date, images } = Astro.props;
---

<Layout title={`${title} - Omaha Lacrosse Club`}>
  <div class="bg-white" data-images={JSON.stringify(images.map((src, i) => ({ id: i + 1, src, alt: `${title} - Image ${i + 1}` })))}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <a href="/images/omaha-lacrosse" class="inline-flex items-center text-gray-600 hover:text-gray-900 mb-4">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Omaha Lacrosse Club
      </a>
      <h1 class="text-4xl font-bold text-gray-900 mb-4">{title}</h1>
      <p class="text-gray-600 mb-8">{date}</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {images.map((image, index) => (
          <div 
            class="group relative overflow-hidden rounded-lg cursor-pointer"
            data-index={index}
          >
            <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
              <div class="relative h-64">
                <img
                  src={image}
                  alt={`${title} - Image ${index + 1}`}
                  class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-300"
                />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* Lightbox */}
    <div 
      id="lightbox" 
      class="fixed inset-0 bg-black bg-opacity-90 z-50 hidden"
    >
      <div class="absolute top-4 right-4">
        <button 
          class="text-white hover:text-gray-300 transition-colors"
          id="close-lightbox"
        >
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-4xl px-4">
        <img
          id="lightbox-image"
          src=""
          alt=""
          class="w-full h-auto max-h-[80vh] object-contain rounded-lg shadow-xl"
        />
      </div>

      <button 
        class="absolute left-4 top-1/2 transform -translate-y-1/2 text-white hover:text-gray-300 transition-colors"
        id="prev-photo"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button 
        class="absolute right-4 top-1/2 transform -translate-y-1/2 text-white hover:text-gray-300 transition-colors"
        id="next-photo"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>
</Layout>

<script>
  // Make images data available to client-side script
  declare global {
    interface Window {
      images: Array<{
        id: number;
        src: string;
        alt: string;
      }>;
      currentPhotoIndex: number;
    }
  }

  // Get images data from the data attribute
  const mainElement = document.querySelector('div[data-images]');
  if (mainElement) {
    const imagesData = mainElement.getAttribute('data-images');
    if (imagesData) {
      window.images = JSON.parse(imagesData);
    }
  }

  // Lightbox functionality
  const lightbox = document.getElementById('lightbox');
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
  const closeButton = document.getElementById('close-lightbox');
  const prevButton = document.getElementById('prev-photo');
  const nextButton = document.getElementById('next-photo');

  // Function to update lightbox content
  function updateLightboxContent(index: number) {
    const image = window.images[index];
    if (lightboxImage) {
      lightboxImage.src = image.src;
      lightboxImage.alt = image.alt;
    }
  }

  // Open lightbox when clicking an image
  document.querySelectorAll('.group').forEach((image, index) => {
    image.addEventListener('click', () => {
      window.currentPhotoIndex = index;
      updateLightboxContent(index);
      if (lightbox) lightbox.classList.remove('hidden');
    });
  });

  // Close lightbox when clicking outside
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      lightbox.classList.add('hidden');
    }
  });

  // Close lightbox when clicking close button
  closeButton?.addEventListener('click', () => {
    if (lightbox) lightbox.classList.add('hidden');
  });

  // Navigate between photos
  prevButton?.addEventListener('click', () => {
    window.currentPhotoIndex = (window.currentPhotoIndex - 1 + window.images.length) % window.images.length;
    updateLightboxContent(window.currentPhotoIndex);
  });

  nextButton?.addEventListener('click', () => {
    window.currentPhotoIndex = (window.currentPhotoIndex + 1) % window.images.length;
    updateLightboxContent(window.currentPhotoIndex);
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (lightbox && !lightbox.classList.contains('hidden')) {
      if (e.key === 'ArrowLeft') {
        window.currentPhotoIndex = (window.currentPhotoIndex - 1 + window.images.length) % window.images.length;
        updateLightboxContent(window.currentPhotoIndex);
      } else if (e.key === 'ArrowRight') {
        window.currentPhotoIndex = (window.currentPhotoIndex + 1) % window.images.length;
        updateLightboxContent(window.currentPhotoIndex);
      } else if (e.key === 'Escape') {
        lightbox.classList.add('hidden');
      }
    }
  });
</script> 