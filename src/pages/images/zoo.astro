---
import Layout from '../../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL;

const zooPhotos = [
  {
    id: "zoo-3417",
    title: "Zoo Exhibit",
    date: "December 9, 2010",
    location: "Omaha Henry Doorly Zoo",
    previewImage: "/images/zoo/2010-12-09_zoo_1024_3417.jpg",
    description: "Exhibit at the Omaha Henry Doorly Zoo.",
    photoCount: 1
  },
  {
    id: "zoo-3418",
    title: "Zoo Exhibit",
    date: "December 9, 2010",
    location: "Omaha Henry Doorly Zoo",
    previewImage: "/images/zoo/2010-12-09_zoo_1024_3418.jpg",
    description: "Exhibit at the Omaha Henry Doorly Zoo.",
    photoCount: 1
  },
  {
    id: "zoo-3420",
    title: "Zoo Exhibit",
    date: "December 9, 2010",
    location: "Omaha Henry Doorly Zoo",
    previewImage: "/images/zoo/2010-12-09_zoo_1024_3420.jpg",
    description: "Exhibit at the Omaha Henry Doorly Zoo.",
    photoCount: 1
  },
  {
    id: "penguin",
    title: "Penguin Exhibit",
    date: "December 11, 2010",
    location: "Omaha Henry Doorly Zoo",
    previewImage: "/images/zoo/2010-12-11_PenguinBlog1200_3425.jpg",
    description: "Penguin exhibit at the Omaha Henry Doorly Zoo.",
    photoCount: 1
  }
];

// Add lightbox state
let currentPhotoIndex = 0;
---

<Layout title="Zoo Photography">
  <main class="min-h-screen bg-gray-50">
    <section class="relative h-[40vh] bg-black">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-r from-black via-black/80 to-transparent"></div>
        <img
          src="/images/zoo/2010-12-09_zoo_1024_3417.jpg"
          alt="Zoo hero"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="relative z-10 flex items-center h-full">
        <div class="container mx-auto px-4">
          <h1 class="text-4xl md:text-6xl font-bold text-white mb-4">Zoo Photography</h1>
          <p class="text-lg text-gray-200">
            Capturing the beauty of wildlife at the Omaha Henry Doorly Zoo
          </p>
        </div>
      </div>
    </section>

    {/* Photo Grid */}
    <section class="container mx-auto px-4 py-12">
      <a 
        href="/images" 
        class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors mb-8"
      >
        <svg
          class="w-5 h-5 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"
          />
        </svg>
        Back to All Images
      </a>

      <div class="flex justify-between items-center mb-8">
        <div class="flex gap-4">
          <button class="px-4 py-2 rounded-full bg-gray-900 text-white hover:bg-gray-800 transition-colors">
            Recent
          </button>
          <button class="px-4 py-2 rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Popular
          </button>
        </div>
        <div class="flex gap-2">
          <button class="p-2 rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <button class="p-2 rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {zooPhotos.map((photo) => (
          <a href={`/images/zoo/${photo.id}`} class="group">
            <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
              <div class="relative h-64">
                <img
                  src={photo.previewImage}
                  alt={photo.title}
                  class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent">
                  <div class="absolute bottom-0 left-0 right-0 p-4">
                    <h3 class="text-white text-xl font-semibold mb-2">{photo.title}</h3>
                    <p class="text-gray-300 text-sm mb-2">{photo.description}</p>
                    <div class="flex justify-between text-sm text-gray-300">
                      <span>{photo.date}</span>
                      <span>{photo.photoCount} photos</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* Lightbox */}
    <div 
      id="lightbox" 
      class="fixed inset-0 bg-black bg-opacity-90 z-50 hidden"
      on:click={(e) => {
        if (e.target.id === 'lightbox') {
          document.getElementById('lightbox').classList.add('hidden');
        }
      }}
    >
      <div class="absolute top-4 right-4">
        <button 
          class="text-white hover:text-gray-300 transition-colors"
          on:click={() => document.getElementById('lightbox').classList.add('hidden')}
        >
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-4xl px-4">
        <img
          src={zooPhotos[currentPhotoIndex].previewImage}
          alt={zooPhotos[currentPhotoIndex].title}
          class="w-full h-auto rounded-lg shadow-xl"
        />
        <div class="mt-4 text-center">
          <h3 class="text-white text-xl font-semibold mb-2">{zooPhotos[currentPhotoIndex].title}</h3>
          <p class="text-gray-300">{zooPhotos[currentPhotoIndex].description}</p>
        </div>
      </div>

      <button 
        class="absolute left-4 top-1/2 transform -translate-y-1/2 text-white hover:text-gray-300 transition-colors"
        on:click={() => {
          currentPhotoIndex = (currentPhotoIndex - 1 + zooPhotos.length) % zooPhotos.length;
        }}
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button 
        class="absolute right-4 top-1/2 transform -translate-y-1/2 text-white hover:text-gray-300 transition-colors"
        on:click={() => {
          currentPhotoIndex = (currentPhotoIndex + 1) % zooPhotos.length;
        }}
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </main>
</Layout>

<style>
  /* Ensure images maintain aspect ratio */
  img {
    aspect-ratio: 3/4;
  }
</style>

<script>
  // Lightbox functionality
  let currentPhotoIndex = 0;
  const lightbox = document.getElementById('lightbox');
  const images = document.querySelectorAll('.group');
  const lightboxImage = document.querySelector('#lightbox img');
  const lightboxTitle = document.querySelector('#lightbox h3');
  const lightboxDate = document.querySelector('#lightbox p');

  // Function to update lightbox content
  function updateLightboxContent(index) {
    const photo = zooPhotos[index];
    lightboxImage.src = photo.previewImage;
    lightboxImage.alt = photo.title;
    lightboxTitle.textContent = photo.title;
    lightboxDate.textContent = photo.description;
  }

  // Open lightbox when clicking an image
  images.forEach((image, index) => {
    image.addEventListener('click', () => {
      currentPhotoIndex = index;
      updateLightboxContent(index);
      lightbox.classList.remove('hidden');
    });
  });

  // Close lightbox when clicking outside
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      lightbox.classList.add('hidden');
    }
  });

  // Close lightbox when clicking close button
  document.querySelector('.text-white.hover\\:text-gray-300').addEventListener('click', () => {
    lightbox.classList.add('hidden');
  });

  // Navigate between photos
  document.querySelector('.absolute.left-4').addEventListener('click', () => {
    currentPhotoIndex = (currentPhotoIndex - 1 + zooPhotos.length) % zooPhotos.length;
    updateLightboxContent(currentPhotoIndex);
  });

  document.querySelector('.absolute.right-4').addEventListener('click', () => {
    currentPhotoIndex = (currentPhotoIndex + 1) % zooPhotos.length;
    updateLightboxContent(currentPhotoIndex);
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('hidden')) {
      if (e.key === 'ArrowLeft') {
        currentPhotoIndex = (currentPhotoIndex - 1 + zooPhotos.length) % zooPhotos.length;
        updateLightboxContent(currentPhotoIndex);
      } else if (e.key === 'ArrowRight') {
        currentPhotoIndex = (currentPhotoIndex + 1) % zooPhotos.length;
        updateLightboxContent(currentPhotoIndex);
      } else if (e.key === 'Escape') {
        lightbox.classList.add('hidden');
      }
    }
  });

  // Add download functionality
  document.querySelectorAll('.download-btn').forEach((button: Element) => {
    button.addEventListener('click', (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
      
      const imageUrl = button.getAttribute('data-src');
      if (imageUrl) {
        const link = document.createElement('a');
        link.href = imageUrl;
        link.download = imageUrl.split('/').pop() || '';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      }
    });
  });

  // Make zooPhotos available to client-side script
  window.zooPhotos = {zooPhotos};
</script> 