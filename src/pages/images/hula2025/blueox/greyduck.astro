---
import Layout from '../../../../layouts/Layout.astro';
import Lightbox from '../../../../components/Lightbox.astro';

const images = [
  "Hula_BlueOx-31.jpg","Hula_BlueOx-32.jpg","Hula_BlueOx-33.jpg","Hula_BlueOx-34.jpg","Hula_BlueOx-35.jpg","Hula_BlueOx-36.jpg","Hula_BlueOx-37.jpg","Hula_BlueOx-38.jpg","Hula_BlueOx-39.jpg","Hula_BlueOx-40.jpg","Hula_BlueOx-41.jpg","Hula_BlueOx-42.jpg"
];

const basePath = '/images/hula2025/blueox/greyduck/';
---
<Layout title="Hula Gold vs Grey Duck">
  <div class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-8">Hula Gold vs Grey Duck</h1>
    <a href="/images/hula2025/blueox" class="text-blue-600 hover:underline mb-8 inline-block">← Back to Blue Ox</a>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {images.map((img, idx) => (
        <div class="rounded-lg overflow-hidden shadow">
          <img src={basePath + img} alt={img} class="gallery-image w-full h-64 object-cover cursor-pointer" loading={idx < 9 ? 'eager' : 'lazy'} />
        </div>
      ))}
    </div>
    <Lightbox images={images.map(img => basePath + img)} />
  </div>
</Layout> 