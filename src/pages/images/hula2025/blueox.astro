<Layout title="Blue Ox Games">
  <div class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-8">Blue Ox Games</h1>
    <a href="/images/hula2025" class="text-blue-600 hover:underline mb-8 inline-block">← Back to Hula 2025 Events</a>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
      {games.map(game => (
        <a href={game.link} class="group block rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <div class="relative h-64">
            <img src={game.image} alt={game.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-end">
              <div class="p-4">
                <h2 class="text-white text-xl font-semibold">{game.name}</h2>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout> 