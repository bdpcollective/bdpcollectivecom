---
import Layout from '../../../layouts/Layout.astro';
import Lightbox from '../../../components/Lightbox.astro';

// List all Blue Ox images
const images = Array.from({ length: 57 }, (_, i) => `/images/lacrosse/hula2025/blueox/Hula_BlueOx-${String(i + 1).padStart(2, '0')}.jpg`);

const title = "Blue Ox Invitational - June 14-15, 2025";
const description = "Gallery of photos from the Blue Ox Invitational, June 14-15, 2025";
---

<Layout title={title}>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="mb-8">
        <a href="/images/hula2025" class="text-blue-600 hover:text-blue-800">← Back to 2025 Hula</a>
      </div>
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Blue Ox Invitational</h1>
      <p class="text-gray-600 mb-8">June 14-15, 2025</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {images.map((image, index) => (
          <div class="aspect-w-3 aspect-h-2 overflow-hidden rounded-lg">
            <img
              src={image}
              alt={`Blue Ox Invitational photo ${index + 1}`}
              class="gallery-image w-full h-full object-cover cursor-pointer transform hover:scale-105 transition-transform duration-300"
              loading={index < 9 ? "eager" : "lazy"}
            />
          </div>
        ))}
      </div>
    </div>
  </div>
  <Lightbox images={images} />
</Layout>

<style>
  img {
    max-width: 100%;
    height: auto;
  }
</style> 