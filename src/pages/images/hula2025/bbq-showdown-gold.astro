---
import Layout from '../../../layouts/Layout.astro';
import Lightbox from '../../../components/Lightbox.astro';

// Generate image array for all 100 images
const images = [
  ...Array.from({length: 100}, (_, i) => {
    const imageNum = i + 1;
    // Use zero-padded format for 1-97, non-zero-padded for 98-100
    const num = imageNum <= 97 ? String(imageNum).padStart(2, '0') : String(imageNum);
    return `/images/hula2025/bbqshowdowngold/HulaGoldBBQShowdown-${num}.jpg`;
  })
];

const title = "BBQ Town Showdown Gold";
const description = "Hula 2025 - BBQ Town Showdown Gold";
---

<Layout title={title}>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      {/* Back Navigation */}
      <div class="mb-8">
        <a href="/images/hula2025" class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Hula Events
        </a>
      </div>
      
      {/* Header */}
      <h1 class="text-4xl font-bold text-gray-900 mb-4">{title}</h1>
      <p class="text-gray-600 mb-8">{description}</p>

      {/* Photo Grid */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {images.map((image, index) => (
          <div class="aspect-w-3 aspect-h-2 overflow-hidden rounded-lg">
            <img
              src={image}
              alt={`BBQ Town Showdown Gold photo ${index + 1}`}
              class="gallery-image w-full h-full object-cover cursor-pointer transform hover:scale-105 transition-transform duration-300"
              loading={index < 9 ? "eager" : "lazy"}
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  {/* Reusable Lightbox Component */}
  <Lightbox images={images} />
</Layout> 