---
import Layout from '../../../layouts/Layout.astro';

// Pick a random Blue Ox image for the card
const blueOxImage = `/images/hula2025/blueox/Hula_BlueOx-${String(Math.floor(Math.random() * 85) + 1).padStart(2, '0')}.jpg`;
---

<Layout title="2025 Hula">
  <main class="min-h-screen bg-white">
    <section class="bg-black text-white py-16">
      <div class="container mx-auto px-4">
        <h1 class="text-4xl font-bold mb-4">2025 Hula</h1>
      </div>
    </section>

    <section class="container mx-auto px-4 py-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <a href="/images/hula2025/blue-ox" class="group relative block">
          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="relative h-64 flex items-end">
              <img src={blueOxImage} alt="Blue Ox Invitational preview" class="absolute inset-0 w-full h-full object-cover z-0" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent z-10" />
              <div class="absolute bottom-0 left-0 right-0 p-4 z-20">
                <h3 class="text-white text-xl font-semibold mb-2">Blue Ox Invitational</h3>
                <div class="text-sm text-gray-300">June 14-15</div>
              </div>
            </div>
          </div>
        </a>
        <a href="/images/hula2025/bbq-showdown-gold" class="group relative block">
          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="relative h-64 flex items-end">
              <img src="/images/hula2025/bbqshowdowngold/HulaGoldBBQShowdown-01.jpg" alt="BBQ Town Showdown Gold preview" class="absolute inset-0 w-full h-full object-cover z-0" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent z-10" />
              <div class="absolute bottom-0 left-0 right-0 p-4 z-20">
                <h3 class="text-white text-xl font-semibold mb-2">BBQ Town Showdown Gold</h3>
                <div class="text-sm text-gray-300">June 21-22</div>
              </div>
            </div>
          </div>
        </a>
        <div class="group relative opacity-50 cursor-not-allowed pointer-events-none" aria-disabled="true">
          <div class="bg-white rounded-xl shadow-lg overflow-hidden transition-shadow">
            <div class="relative h-64 flex items-end">
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent" />
              <div class="absolute bottom-0 left-0 right-0 p-4 z-10">
                <h3 class="text-white text-xl font-semibold mb-2">Good Land Field Invitational</h3>
                <div class="text-sm text-gray-300">July 12-13</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout> 