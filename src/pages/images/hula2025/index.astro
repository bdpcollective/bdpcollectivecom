---
import Layout from '../../../layouts/Layout.astro';

const events = [
  {
    name: 'Blue Ox Invitational',
    date: 'June 14-15',
    link: '/images/hula2025/blueox',
    enabled: true,
    image: '/images/hula2025/blueox/Hula_BlueOx-01.jpg', // You can randomize if you want
  },
  {
    name: 'KC BBQ Town Showdown',
    date: 'June 21-22',
    link: '/images/hula2025/bbqshowdown',
    enabled: false,
    image: '/images/hula2025/blueox/Hula_BlueOx-02.jpg',
  },
  {
    name: 'Good Land Field Invitational',
    date: 'July 12-13',
    link: '/images/hula2025/goodland',
    enabled: false,
    image: '/images/hula2025/blueox/Hula_BlueOx-03.jpg',
  },
];
---

<Layout title="2025 Hula">
  <main class="min-h-screen bg-white">
    <section class="bg-black text-white py-16">
      <div class="container mx-auto px-4">
        <h1 class="text-4xl font-bold mb-4">2025 Hula</h1>
      </div>
    </section>
    <section class="container mx-auto px-4 py-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {events.map(event => (
          event.enabled ? (
            <a href={event.link} class="group relative block">
              <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
                <div class="relative h-64 flex items-end">
                  <img src={event.image} alt={event.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent" />
                  <div class="absolute bottom-0 left-0 right-0 p-4 z-10">
                    <h2 class="text-white text-xl font-semibold mb-2">{event.name}</h2>
                    <p class="text-sm text-gray-300">{event.date}</p>
                  </div>
                </div>
              </div>
            </a>
          ) : (
            <div class="group relative block opacity-50 cursor-not-allowed pointer-events-none" aria-disabled="true">
              <div class="bg-white rounded-xl shadow-lg overflow-hidden transition-shadow">
                <div class="relative h-64 flex items-end">
                  <img src={event.image} alt={event.name} class="w-full h-full object-cover" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent" />
                  <div class="absolute bottom-0 left-0 right-0 p-4 z-10">
                    <h2 class="text-white text-xl font-semibold mb-2">{event.name}</h2>
                    <p class="text-sm text-gray-300">{event.date}</p>
                  </div>
                </div>
              </div>
            </div>
          )
        ))}
      </div>
    </section>
  </main>
</Layout> 