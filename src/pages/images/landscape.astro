---
import Layout from '../../layouts/Layout.astro';
import Lightbox from '../../components/Lightbox.astro';

// List all images from landscape folder
const images = [
  '/images/landscape/20250103_Bahamas-2.webp',
  '/images/landscape/20250103_Bahamas-3.webp',
  '/images/landscape/20250103_Bahamas-4.webp',
  '/images/landscape/20250103_Bahamas-6.webp',
  '/images/landscape/20250103_Bahamas-7.webp',
  '/images/landscape/20250103_Bahamas-9.webp',
  '/images/landscape/20250103_Bahamas-10.webp',
  '/images/landscape/20250103_Bahamas-11.webp',
  '/images/landscape/20250103_Bahamas-12.webp',
  '/images/landscape/20250103_Bahamas-13.webp',
  '/images/landscape/20250103_Bahamas-14.webp',
  '/images/landscape/20250103_Bahamas-15.webp',
  '/images/landscape/20250103_Bahamas-16.webp',
  '/images/landscape/20250103_Bahamas-17.webp',
  '/images/landscape/20250103_Bahamas-18.webp',
  '/images/landscape/20250103_Bahamas-21.webp',
  '/images/landscape/20251012_Colorado.webp',
  '/images/landscape/20251012_Colorado-2.webp',
  '/images/landscape/20251012_Colorado-3.webp',
  '/images/landscape/20251012_Colorado-4.webp',
  '/images/landscape/20251012_Colorado-5.webp',
  '/images/landscape/20251012_Colorado-6.webp',
  '/images/landscape/20251012_Colorado-7.webp',
  '/images/landscape/20251012_Colorado-8.webp',
  '/images/landscape/20251012_Colorado-9.webp',
  '/images/landscape/20251012_Colorado-10.webp',
  '/images/landscape/20251012_Colorado-11.webp',
  '/images/landscape/BobKerryBridge.webp',
  '/images/landscape/SouthwestSpirit.webp'
];

const title = "Landscape";
const description = "Gallery of landscape photos";
---

<Layout title={title}>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="mb-8">
        <a href="/images" class="text-blue-600 hover:text-blue-800">← Back to Images</a>
      </div>

      <h1 class="text-4xl font-bold text-gray-900 mb-4">{title}</h1>
      <p class="text-gray-600 mb-8">Landscape photography collection</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {images.map((image, index) => (
          <div class="aspect-w-3 aspect-h-2 overflow-hidden rounded-lg">
            <img
              src={image}
              alt={`Landscape photo ${index + 1}`}
              class="gallery-image w-full h-full object-cover cursor-pointer transform hover:scale-105 transition-transform duration-300"
              loading={index < 9 ? "eager" : "lazy"}
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <Lightbox images={images} />
</Layout>

<style>
  /* Remove the fixed aspect ratio style */
  img {
    max-width: 100%;
    height: auto;
  }
</style>
