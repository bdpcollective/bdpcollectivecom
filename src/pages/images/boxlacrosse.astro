---
import Layout from '../../layouts/Layout.astro';
import Lightbox from '../../components/Lightbox.astro';

const boxLacrosseGames = [
  {
    id: "2025-box-week1",
    title: "Week 1",
    date: "November 5, 2025",
    location: "Millard West High School",
    previewImage: `/images/lacrosse/2025_boxlax/20251105_Week1/20251105_Box_Week1${Math.floor(Math.random() * 72) === 0 ? '' : '-' + (Math.floor(Math.random() * 71) + 2)}.jpg`,
    photoCount: 72
  }
];

const previewImages = boxLacrosseGames.map(game => game.previewImage);
---

<Layout title="2025 Box Lacrosse">
  <main class="min-h-screen bg-white">
    <section class="bg-black text-white py-16">
      <div class="container mx-auto px-4">
        <h1 class="text-4xl font-bold mb-4">2025 Box Lacrosse</h1>
        <p class="text-lg text-gray-300 max-w-3xl">
          Capturing the intensity and excitement of box lacrosse through photography
        </p>
      </div>
    </section>

    {/* Game Grid */}
    <section class="container mx-auto px-4 py-12">
      <a
        href="/images"
        class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors mb-8"
      >
        <svg
          class="w-5 h-5 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"
          />
        </svg>
        Back to All Images
      </a>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="games-grid">
        {boxLacrosseGames.map((game, index) => (
          <div class="group relative game-card">
            <a href={`/images/boxlacrosse/${game.id}`} class="block">
              <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
                <div class="relative h-64">
                  <img
                    src={game.previewImage}
                    alt={game.title}
                    class="gallery-image w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-300"
                    data-index={index}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent">
                    <div class="absolute bottom-0 left-0 right-0 p-4">
                      <h2 class="text-white text-xl font-semibold mb-2">{game.title}</h2>
                      <div class="flex justify-between text-sm text-gray-300">
                        <span>{game.date}</span>
                        <span>{game.photoCount} photos</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Lightbox images={previewImages} />
</Layout>
