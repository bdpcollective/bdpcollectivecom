    previewImage: `/images/box2025/week6/20251112_Box_Week6${Math.floor(Math.random() * 98) === 0 ? '' : '-' + (Math.floor(Math.random() * 97) + 2)}.jpg`,
    photoCount: 98
  },
  {
    id: "2025-box-week5",
    title: "Week 5",
    date: "December 10, 2025",
