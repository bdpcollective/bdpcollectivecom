    previewImage: `/images/box2025/week5/20251210_Box_Week5${Math.floor(Math.random() * 176) === 0 ? '' : '-' + (Math.floor(Math.random() * 175) + 2)}.jpg`,
    photoCount: 176
  },
  {
    id: "2025-box-week4",
    title: "Week 4",
    date: "December 3, 2025",
    location: "Millard West High School",
    previewImage: `/images/box2025/week4/20251203_Box_Week4${Math.floor(Math.random() * 184) === 0 ? '' : '-' + (Math.floor(Math.random() * 183) + 2)}.jpg`,
    photoCount: 184
  },
  {
    id: "2025-box-week3",
    title: "Week 3",
    date: "November 19, 2025",
    location: "Millard West High School",
    previewImage: `/images/box2025/week3/20251119_Box_Week3${Math.floor(Math.random() * 111) === 0 ? '' : '-' + (Math.floor(Math.random() * 110) + 2)}.jpg`,
    photoCount: 111
  },
  {
    id: "2025-box-week2",
    title: "Week 2",
    date: "November 12, 2025",
    location: "Millard West High School",
    previewImage: `/images/box2025/week2/20251112_Box_Week2${Math.floor(Math.random() * 75) === 0 ? '' : '-' + (Math.floor(Math.random() * 74) + 2)}.jpg`,
