---
import Layout from '../../../layouts/Layout.astro';
import Lightbox from '../../../components/Lightbox.astro';

// Generate image array - 103 images numbered 001-103
const images = Array.from({ length: 103 }, (_, i) =>
  `/images/elkhornsouthbasketball/2025-01-03-vs-burke/20250103_ElkhornSouthvsBurke-${String(i + 1).padStart(3, '0')}.jpg`
);

const title = "Elkhorn South vs Burke";
const description = "Gallery of photos from Elkhorn South Storm basketball vs Burke on January 3, 2025";
---

<Layout title={title}>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="mb-8">
        <a href="/images/elkhornsouthbasketball" class="text-blue-600 hover:text-blue-800">← Back to Elkhorn South Basketball</a>
      </div>

      <h1 class="text-4xl font-bold text-gray-900 mb-4">{title}</h1>
      <p class="text-gray-600 mb-8">January 3, 2025</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {images.map((image, index) => (
          <div class="aspect-w-3 aspect-h-2 overflow-hidden rounded-lg">
            <img
              src={image}
              alt={`Elkhorn South vs Burke photo ${index + 1}`}
              class="gallery-image w-full h-full object-cover cursor-pointer transform hover:scale-105 transition-transform duration-300"
              loading={index < 9 ? "eager" : "lazy"}
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <Lightbox images={images} />
</Layout>

<style>
  /* Remove the fixed aspect ratio style */
  img {
    max-width: 100%;
    height: auto;
  }
</style>
