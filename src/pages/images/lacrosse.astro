---
import Layout from '../../layouts/Layout.astro';
import Lightbox from '../../components/Lightbox.astro';

const lacrosseGames = [
  {
    id: "varsity-vs-elkhorn",
    title: "Varsity: MWHS vs Elkhorn",
    date: "April 18, 2025",
    location: "Millard West High School",
    previewImage: "/images/coming-soon.jpg",
    photoCount: 0
  },
  {
    id: "jv-vs-elkhorn",
    title: "JV: MWHS vs Elkhorn",
    date: "April 18, 2025",
    location: "Millard West High School",
    previewImage: "/images/coming-soon.jpg",
    photoCount: 0
  },
  {
    id: "varsity-vs-grand-cities",
    title: "Varsity: MWHS vs Grand Cities",
    date: "April 13, 2025",
    location: "Millard West High School",
    previewImage: `/images/lacrosse/20250413-varsity-vs-grand-cities/20250413_VarisityvsGrandCities - ${Math.floor(Math.random() * 74) + 1}.jpeg`,
    photoCount: 74
  },
  {
    id: "jv-vs-grand-cities",
    title: "JV: MWHS vs Grand Cities",
    date: "April 13, 2025",
    location: "Millard West High School",
    previewImage: `/images/lacrosse/20250413_jv-mwhs-vs-grand-cities/20250413_JVvsGrandCities - ${Math.floor(Math.random() * 29) + 1}.jpeg`,
    photoCount: 29
  },
  {
    id: "varsity-vs-akeny",
    title: "Varsity: MWHS vs Akeny",
    date: "March 8, 2025",
    location: "Millard West High School",
    previewImage: "/images/lacrosse/20250308-varsity-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 1.jpeg",
    photoCount: 53
  },
  {
    id: "jv-vs-akeny",
    title: "JV: MWHS vs Akeny",
    date: "March 8, 2025",
    location: "Millard West High School",
    previewImage: "/images/lacrosse/20250308-jv-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 1.jpeg",
    photoCount: 19
  }
];

const previewImages = lacrosseGames.map(game => game.previewImage);
---

<Layout title="Millard West Lacrosse">
  <main class="min-h-screen bg-gray-50">
    <section class="relative h-[40vh] bg-gray-900">
      <div class="relative z-10 flex items-center h-full">
        <div class="container mx-auto px-4">
          <h1 class="text-4xl md:text-6xl font-bold text-white mb-4">Millard West Lacrosse</h1>
          <p class="text-lg text-gray-200">
            Capturing the energy and excitement of lacrosse through photography
          </p>
        </div>
      </div>
    </section>

    {/* Game Grid */}
    <section class="container mx-auto px-4 py-12">
      <a 
        href="/images" 
        class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors mb-8"
      >
        <svg
          class="w-5 h-5 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"
          />
        </svg>
        Back to All Images
      </a>

      <div class="flex justify-between items-center mb-8">
        <div class="flex gap-4">
          <button class="px-4 py-2 rounded-full bg-gray-900 text-white hover:bg-gray-800 transition-colors">
            Recent
          </button>
          <button class="px-4 py-2 rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Popular
          </button>
        </div>
        <div class="flex gap-2">
          <button class="p-2 rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <button class="p-2 rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {lacrosseGames.map((game, index) => (
          <div class="group relative">
            <a href={`/images/lacrosse/${game.id}`} class="block">
              <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
                <div class="relative h-64">
                  <img
                    src={game.previewImage}
                    alt={game.title}
                    class="gallery-image w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-300"
                    data-index={index}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent">
                    <div class="absolute bottom-0 left-0 right-0 p-4">
                      <h3 class="text-white text-xl font-semibold mb-2">{game.title}</h3>
                      <div class="flex justify-between text-sm text-gray-300">
                        <span>{game.date}</span>
                        <span>{game.photoCount} photos</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Lightbox images={previewImages} />
</Layout>

<style>
  /* Ensure images maintain aspect ratio */
  img {
    aspect-ratio: 3/4;
  }
</style>

<script>
  // Add download functionality
  document.querySelectorAll('.download-btn').forEach(button => {
    button.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      
      const imageUrl = button.getAttribute('data-src');
      if (!imageUrl) return; // Exit if no image URL is found
      
      const link = document.createElement('a');
      link.href = imageUrl;
      link.download = imageUrl.split('/').pop() || 'image.jpg'; // Provide fallback filename
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });
  });
</script> 