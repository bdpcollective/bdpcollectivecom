---
import Layout from '../../layouts/Layout.astro';
import Lightbox from '../../components/Lightbox.astro';
import { Container, Typography, Card, Grid, Button } from '../../components/ui';

const lacrosseGames = [
  {
    id: "varsity-vs-waukee",
    title: "Varsity: MWHS vs Waukee",
    date: "April 19, 2025",
    location: "Millard West High School",
    previewImage: "/images/lacrosse/20250419-varsity-mwhs-vs-waukee/coming-soon.jpg",
    photoCount: 0
  },
  {
    id: "jv-vs-waukee",
    title: "JV: MWHS vs Waukee",
    date: "April 19, 2025",
    location: "Millard West High School",
    previewImage: "/images/lacrosse/20250419-jv-mwhs-vs-waukee/coming-soon.jpg",
    photoCount: 0
  },
  {
    id: "varsity-vs-elkhorn",
    title: "Varsity: MWHS vs Elkhorn",
    date: "April 18, 2025",
    location: "Millard West High School",
    previewImage: "/images/lacrosse/20250418-varsity-mwhs-vs-elkhorn/coming-soon.jpg",
    photoCount: 0
  },
  {
    id: "jv-vs-elkhorn",
    title: "JV: MWHS vs Elkhorn",
    date: "April 18, 2025",
    location: "Millard West High School",
    previewImage: "/images/lacrosse/20250418-jv-mwhs-vs-elkhorn/coming-soon.jpg",
    photoCount: 0
  },
  {
    id: "varsity-vs-grand-cities",
    title: "Varsity: MWHS vs Grand Cities",
    date: "April 13, 2025",
    location: "Millard West High School",
    previewImage: `/images/lacrosse/20250413-varsity-vs-grand-cities/20250413_VarisityvsGrandCities - ${Math.floor(Math.random() * 74) + 1}.jpeg`,
    photoCount: 74
  },
  {
    id: "jv-vs-grand-cities",
    title: "JV: MWHS vs Grand Cities",
    date: "April 13, 2025",
    location: "Millard West High School",
    previewImage: `/images/lacrosse/20250413_jv-mwhs-vs-grand-cities/20250413_JVvsGrandCities - ${Math.floor(Math.random() * 29) + 1}.jpeg`,
    photoCount: 29
  },
  {
    id: "varsity-vs-akeny",
    title: "Varsity: MWHS vs Akeny",
    date: "March 8, 2025",
    location: "Millard West High School",
    previewImage: "/images/lacrosse/20250308-varsity-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 1.jpeg",
    photoCount: 53
  },
  {
    id: "jv-vs-akeny",
    title: "JV: MWHS vs Akeny",
    date: "March 8, 2025",
    location: "Millard West High School",
    previewImage: "/images/lacrosse/20250308-jv-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 1.jpeg",
    photoCount: 19
  }
];

const previewImages = lacrosseGames.map(game => game.previewImage);
---

<Layout title="Millard West Lacrosse">
  <main class="min-h-screen bg-gray-50">
    <section class="relative h-[40vh] bg-gray-900">
      <div class="relative z-10 flex items-center h-full">
        <Container size="lg">
          <Typography variant="h1" weight="bold" color="default" class="text-white mb-4">
            Millard West Lacrosse
          </Typography>
          <Typography variant="body" color="muted" class="text-gray-200">
            Capturing the energy and excitement of lacrosse through photography
          </Typography>
        </Container>
      </div>
    </section>

    {/* Game Grid */}
    <section class="py-12">
      <Container size="lg">
        <Button 
          href="/images" 
          variant="text" 
          class="mb-8"
        >
          <svg
            class="w-5 h-5 mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"
            />
          </svg>
          Back to Images
        </Button>

        <Grid cols={3} gap="lg">
          {lacrosseGames.map((game) => (
            <Card variant="elevated" class="overflow-hidden">
              <a href={`/images/lacrosse/${game.id}`} class="block">
                <div class="aspect-w-16 aspect-h-9">
                  <img
                    src={game.previewImage}
                    alt={game.title}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="p-4">
                  <Typography variant="h5" weight="semibold" class="mb-1">
                    {game.title}
                  </Typography>
                  <Typography variant="small" color="muted">
                    {game.date} • {game.location}
                  </Typography>
                  {game.photoCount > 0 && (
                    <Typography variant="small" color="muted" class="mt-1">
                      {game.photoCount} photos
                    </Typography>
                  )}
                </div>
              </a>
            </Card>
          ))}
        </Grid>
      </Container>
    </section>
  </main>

  <Lightbox images={previewImages} />
</Layout>

<style>
  /* Ensure images maintain aspect ratio */
  img {
    aspect-ratio: 3/4;
  }
</style>

<script>
  // Add download functionality
  document.querySelectorAll('.download-btn').forEach(button => {
    button.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      
      const imageUrl = button.getAttribute('data-src');
      if (!imageUrl) return; // Exit if no image URL is found
      
      const link = document.createElement('a');
      link.href = imageUrl;
      link.download = imageUrl.split('/').pop() || 'image.jpg'; // Provide fallback filename
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });
  });
</script> 