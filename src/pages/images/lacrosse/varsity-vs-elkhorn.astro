---
import Layout from '../../../layouts/Layout.astro';
import Lightbox from '../../../components/Lightbox.astro';

// No images yet, just a placeholder
const images = ["/images/lacrosse/20250418-varsity-mwhs-vs-elkhorn/coming-soon.jpg"];
---

<Layout title="Varsity: MWHS vs Elkhorn - April 18, 2025">
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="mb-8">
        <a href="/images/lacrosse" class="text-blue-600 hover:text-blue-800">← Back to Lacrosse</a>
      </div>
      
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Varsity: MWHS vs Elkhorn</h1>
      <p class="text-gray-600 mb-8">April 18, 2025 at Millard West High School</p>

      <div class="flex flex-col items-center justify-center py-12">
        <div class="text-center max-w-2xl">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Coming Soon</h2>
          <p class="text-xl text-gray-600 mb-8">Photos from this game will be available after the event.</p>
          <img 
            src="/images/lacrosse/20250418-varsity-mwhs-vs-elkhorn/coming-soon.jpg" 
            alt="Coming Soon" 
            class="mx-auto rounded-lg shadow-lg max-w-md"
          />
        </div>
      </div>
    </div>
  </div>

  <Lightbox images={images} />
</Layout> 