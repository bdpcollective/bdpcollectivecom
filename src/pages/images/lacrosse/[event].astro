---
import Layout from '../../../layouts/Layout.astro';
import Lightbox from '../../../components/Lightbox.astro';

export function getStaticPaths() {
  // Define the game data
  const gameData: Record<string, {
    title: string;
    date: string;
    location: string;
    description: string;
    imageCount: number;
    imagePath: string;
    imagePrefix: string;
  }> = {
    "jv-vs-akeny": {
      title: "JV: MWHS vs Akeny",
      date: "March 8, 2025",
      location: "Millard West High School",
      description: "Junior Varsity lacrosse game between Millard West and Akeny.",
      imageCount: 19,
      imagePath: "/images/lacrosse/20250308-jv-mwhs-vs-akeny",
      imagePrefix: "20250309_MWHS_Lacrosse"
    },
    "varsity-vs-akeny": {
      title: "Varsity: MWHS vs Akeny",
      date: "March 8, 2025",
      location: "Millard West High School",
      description: "Varsity lacrosse game between Millard West and Akeny.",
      imageCount: 53,
      imagePath: "/images/lacrosse/20250308-varsity-mwhs-vs-akeny",
      imagePrefix: "20250309_MWHS_Lacrosse"
    },
    "jv-vs-elkhorn": {
      title: "JV: MWHS vs Elkhorn",
      date: "April 18, 2025",
      location: "Millard West High School",
      description: "Junior Varsity lacrosse game between Millard West and Elkhorn.",
      imageCount: 24,
      imagePath: "/images/lacrosse/20250418-jv-mwhs-vs-elkhorn",
      imagePrefix: "20250418-JV-MWHSvsElkhorn"
    },
    "varsity-vs-elkhorn": {
      title: "Varsity: MWHS vs Elkhorn",
      date: "April 18, 2025",
      location: "Millard West High School",
      description: "Varsity lacrosse game between Millard West and Elkhorn.",
      imageCount: 85,
      imagePath: "/images/lacrosse/20250418-varsity-mwhs-vs-elkhorn",
      imagePrefix: "20250418-Varsity-MWHSvsElkhorn"
    }
  };

  return Object.keys(gameData).map(event => ({
    params: { event },
    props: { game: gameData[event] }
  }));
}

const { game } = Astro.props;

// Generate array of image paths
const images = Array.from({ length: game.imageCount }, (_, i) =>
  `${game.imagePath}/${game.imagePrefix} - ${i + 1}.jpeg`
);
---

<Layout title={game.title}>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="mb-8">
        <a href="/images/lacrosse" class="text-blue-600 hover:text-blue-800">← Back to Lacrosse</a>
      </div>

      <h1 class="text-4xl font-bold text-gray-900 mb-4">{game.title}</h1>
      <p class="text-gray-600 mb-8">{game.date}</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {images.map((image, index) => (
          <div class="aspect-w-3 aspect-h-2 overflow-hidden rounded-lg">
            <img
              src={image}
              alt={`${game.title} photo ${index + 1}`}
              class="gallery-image w-full h-full object-cover cursor-pointer transform hover:scale-105 transition-transform duration-300"
              loading={index < 9 ? "eager" : "lazy"}
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <Lightbox images={images} />
</Layout>

<style>
  /* Remove the fixed aspect ratio style */
  img {
    max-width: 100%;
    height: auto;
  }
</style> 