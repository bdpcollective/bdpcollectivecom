---
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const baseUrl = import.meta.env.BASE_URL;
  const events = [
    {
      title: "Varsity vs Akeny",
      date: "March 8, 2025",
      images: [
        `${baseUrl}/images/lacrosse/20250308_Varsity_MWHS_vsAkeny/20250309_MWHS_Lacrosse - 1.jpeg`,
        `${baseUrl}/images/lacrosse/20250308_Varsity_MWHS_vsAkeny/20250309_MWHS_Lacrosse - 2.jpeg`,
        `${baseUrl}/images/lacrosse/20250308_Varsity_MWHS_vsAkeny/20250309_MWHS_Lacrosse - 3.jpeg`,
        `${baseUrl}/images/lacrosse/20250308_Varsity_MWHS_vsAkeny/20250309_MWHS_Lacrosse - 4.jpeg`,
        `${baseUrl}/images/lacrosse/20250308_Varsity_MWHS_vsAkeny/20250309_MWHS_Lacrosse - 5.jpeg`
      ]
    }
  ];

  return events.map(event => ({
    params: { event: event.title.toLowerCase().replace(/\s+/g, '-') },
    props: { event }
  }));
}

const { event } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<Layout title={event.title}>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="text-4xl font-bold text-gray-900 mb-8">{event.title}</h1>
      <p class="text-gray-600 mb-8">{event.date}</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {event.images.map((image, index) => (
          <div class="relative overflow-hidden rounded-lg aspect-[4/3]">
            <img
              src={image}
              alt={`${event.title} - Image ${index + 1}`}
              class="w-full h-full object-cover"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout> 