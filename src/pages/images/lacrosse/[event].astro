---
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const events = [
    {
      id: "varsity-vs-akeny",
      title: "Varsity: MWHS vs Akeny",
      date: "March 8, 2025",
      location: "Millard West High School",
      images: [
        '/images/lacrosse/20250308-varsity-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 1.jpeg',
        '/images/lacrosse/20250308-varsity-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 2.jpeg',
        '/images/lacrosse/20250308-varsity-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 3.jpeg',
        '/images/lacrosse/20250308-varsity-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 4.jpeg',
        '/images/lacrosse/20250308-varsity-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 5.jpeg'
      ]
    },
    {
      id: "jv-vs-akeny",
      title: "JV: MWHS vs Akeny",
      date: "March 8, 2025",
      location: "Millard West High School",
      images: [
        '/images/lacrosse/20250308-jv-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 1.jpeg',
        '/images/lacrosse/20250308-jv-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 2.jpeg',
        '/images/lacrosse/20250308-jv-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 3.jpeg',
        '/images/lacrosse/20250308-jv-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 4.jpeg',
        '/images/lacrosse/20250308-jv-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 5.jpeg'
      ]
    }
  ];

  return events.map(event => ({
    params: { event: event.id },
    props: { event }
  }));
}

const { event } = Astro.props;
---

<Layout title={event.title}>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="text-4xl font-bold text-gray-900 mb-8">{event.title}</h1>
      <p class="text-gray-600 mb-8">{event.date}</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {event.images.map((image, index) => (
          <div class="relative overflow-hidden rounded-lg aspect-[4/3]">
            <img
              src={image}
              alt={`${event.title} - Image ${index + 1}`}
              class="w-full h-full object-cover"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout> 