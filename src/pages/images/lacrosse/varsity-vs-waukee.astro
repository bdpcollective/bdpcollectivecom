---
import Layout from '../../../layouts/Layout.astro';
import Lightbox from '../../../components/Lightbox.astro';

// Generate array of all images
const imageCount = 33;
const imagePath = "/images/lacrosse/20250419-varsity-mwhs-vs-waukee";
const imagePrefix = "20250419-Varsity-MWHSvsWaukee";

// Create array of all images
const images = Array.from({ length: imageCount }, (_, i) => `${imagePath}/${imagePrefix} - ${i + 1}.jpeg`);
---

<Layout title="Varsity: MWHS vs Waukee - April 19, 2025">
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="mb-8">
        <a href="/images/lacrosse" class="text-blue-600 hover:text-blue-800">← Back to Lacrosse</a>
      </div>
      
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Varsity: MWHS vs Waukee</h1>
      <p class="text-gray-600 mb-8">April 19, 2025 at Millard West High School</p>

      <div class="py-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Game Photos</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {images.map((image, index) => (
            <div class="aspect-w-3 aspect-h-2 overflow-hidden rounded-lg">
          <img 
                src={image} 
                alt={`Varsity: MWHS vs Waukee - Image ${index + 1}`} 
                class="gallery-image w-full h-full object-cover cursor-pointer transform hover:scale-105 transition-transform duration-300"
                loading={index < 9 ? "eager" : "lazy"}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <Lightbox images={images} />
</Layout> 

<style>
  /* Remove the fixed aspect ratio style */
  img {
    max-width: 100%;
    height: auto;
  }
</style> 