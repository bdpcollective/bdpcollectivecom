---
import Layout from '../../../../layouts/Layout.astro';

// Pick a random Blue Ox image for the card
const blueOxImage = `/images/lacrosse/hula2025/blueox/Hula_BlueOx-${String(Math.floor(Math.random() * 85) + 1).padStart(2, '0')}.jpg`;
---

<Layout title="2025 Hula Lacrosse">
  <main class="min-h-screen bg-white">
    <section class="bg-black text-white py-16">
      <div class="container mx-auto px-4">
        <h1 class="text-4xl font-bold mb-4">2025 Hula Lacrosse</h1>
      </div>
    </section>

    <section class="container mx-auto px-4 py-12">
      <a
        href="/images/lacrosse"
        class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors mb-8"
      >
        <svg
          class="w-5 h-5 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"
          />
        </svg>
        Back to Lacrosse
      </a>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <a href="/images/lacrosse/hula-2025/blue-ox" class="group relative block">
          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="relative h-64 flex items-end">
              <img src={blueOxImage} alt="Blue Ox Invitational preview" class="absolute inset-0 w-full h-full object-cover z-0" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent z-10" />
              <div class="absolute bottom-0 left-0 right-0 p-4 z-20">
                <h2 class="text-white text-xl font-semibold mb-2">Blue Ox Invitational</h2>
                <div class="text-sm text-gray-300">June 14-15</div>
              </div>
            </div>
          </div>
        </a>
        <a href="/images/lacrosse/hula-2025/bbq-showdown-gold" class="group relative block">
          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="relative h-64 flex items-end">
              <img src="/images/lacrosse/hula2025/bbqshowdowngold/HulaGoldBBQShowdown-01.jpg" alt="BBQ Town Showdown Gold preview" class="absolute inset-0 w-full h-full object-cover z-0" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent z-10" />
              <div class="absolute bottom-0 left-0 right-0 p-4 z-20">
                <h2 class="text-white text-xl font-semibold mb-2">BBQ Town Showdown Gold</h2>
                <div class="text-sm text-gray-300">June 21-22</div>
              </div>
            </div>
          </div>
        </a>
        <a href="/images/lacrosse/hula-2025/bbq-showdown-white" class="group relative block">
          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="relative h-64 flex items-end">
              <img src="/images/lacrosse/hula2025/bbqshowdownwhite/HulaWhiteBBQShowdown-01.jpg" alt="BBQ Town Showdown White preview" class="absolute inset-0 w-full h-full object-cover z-0" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent z-10" />
              <div class="absolute bottom-0 left-0 right-0 p-4 z-20">
                <h2 class="text-white text-xl font-semibold mb-2">BBQ Town Showdown White</h2>
                <div class="text-sm text-gray-300">June 21-22</div>
              </div>
            </div>
          </div>
        </a>
        <a href="/images/lacrosse/hula-2025/good-land-field-invitational" class="group relative block">
          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="relative h-64 flex items-end">
              <img src="/images/lacrosse/hula2025/goodlandgold/20250712_GoodLand-01.jpg" alt="Good Land Field Invitational preview" class="absolute inset-0 w-full h-full object-cover z-0" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent z-10" />
              <div class="absolute bottom-0 left-0 right-0 p-4 z-20">
                <h2 class="text-white text-xl font-semibold mb-2">Good Land Field Invitational Gold</h2>
                <div class="text-sm text-gray-300">July 12-13</div>
              </div>
            </div>
          </div>
        </a>
        <a href="/images/lacrosse/hula-2025/good-land-field-invitational-blue" class="group relative block">
          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="relative h-64 flex items-end">
              <img src="/images/lacrosse/hula2025/goodlandblue/20250712_GoodLandBlue-01.jpg" alt="Good Land Field Invitational Blue preview" class="absolute inset-0 w-full h-full object-cover z-0" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent z-10" />
              <div class="absolute bottom-0 left-0 right-0 p-4 z-20">
                <h2 class="text-white text-xl font-semibold mb-2">Good Land Field Invitational Blue</h2>
                <div class="text-sm text-gray-300">July 12-13</div>
              </div>
            </div>
          </div>
        </a>
      </div>
    </section>
  </main>
</Layout> 