---
import Layout from '../../../../../layouts/Layout.astro';
import Lightbox from '../../../../../components/Lightbox.astro';

const images = [
  "Hula_BlueOx-43.webp","Hula_BlueOx-44.webp","Hula_BlueOx-45.webp","Hula_BlueOx-46.webp","Hula_BlueOx-47.webp","Hula_BlueOx-48.webp","Hula_BlueOx-49.webp","Hula_BlueOx-50.webp","Hula_BlueOx-51.webp","Hula_BlueOx-52.webp","Hula_BlueOx-53.webp","Hula_BlueOx-54.webp","Hula_BlueOx-55.webp","Hula_BlueOx-56.webp","Hula_BlueOx-57.webp"
];

const basePath = '/images/lacrosse/hula2025/blueox/';
---
<Layout title="Hula Gold vs Minnesota Chill">
  <div class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-8">Hula Gold vs Minnesota Chill</h1>
    <a href="/images/lacrosse/hula-2025/blueox" class="text-blue-600 hover:underline mb-8 inline-block">← Back to Blue Ox</a>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {images.map((img, idx) => (
        <div class="rounded-lg overflow-hidden shadow">
          <img src={basePath + img} alt={img} class="gallery-image w-full h-64 object-cover cursor-pointer" loading={idx < 9 ? 'eager' : 'lazy'} />
        </div>
      ))}
    </div>
    <Lightbox images={images.map(img => basePath + img)} />
  </div>
</Layout> 