---
import Layout from '../../../../../layouts/Layout.astro';
import Lightbox from '../../../../../components/Lightbox.astro';

const images = [
  "Hula_BlueOx-01.webp","Hula_BlueOx-02.webp","Hula_BlueOx-03.webp","Hula_BlueOx-04.webp","Hula_BlueOx-05.webp","Hula_BlueOx-06.webp","Hula_BlueOx-07.webp","Hula_BlueOx-08.webp","Hula_BlueOx-09.webp","Hula_BlueOx-10.webp","Hula_BlueOx-11.webp","Hula_BlueOx-12.webp","Hula_BlueOx-13.webp","Hula_BlueOx-14.webp","Hula_BlueOx-15.webp","Hula_BlueOx-16.webp","Hula_BlueOx-17.webp","Hula_BlueOx-18.webp","Hula_BlueOx-19.webp","Hula_BlueOx-20.webp","Hula_BlueOx-21.webp","Hula_BlueOx-22.webp","Hula_BlueOx-23.webp","Hula_BlueOx-24.webp","Hula_BlueOx-25.webp","Hula_BlueOx-26.webp","Hula_BlueOx-27.webp","Hula_BlueOx-28.webp","Hula_BlueOx-29.webp","Hula_BlueOx-30.webp"
];

const basePath = '/images/lacrosse/hula2025/blueox/';
---
<Layout title="Hula Gold vs MAC">
  <div class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-8">Hula Gold vs MAC</h1>
    <a href="/images/lacrosse/hula-2025/blueox" class="text-blue-600 hover:underline mb-8 inline-block">← Back to Blue Ox</a>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {images.map((img, idx) => (
        <div class="rounded-lg overflow-hidden shadow">
          <img src={basePath + img} alt={img} class="gallery-image w-full h-64 object-cover cursor-pointer" loading={idx < 9 ? 'eager' : 'lazy'} />
        </div>
      ))}
    </div>
    <Lightbox images={images.map(img => basePath + img)} />
  </div>
</Layout> 