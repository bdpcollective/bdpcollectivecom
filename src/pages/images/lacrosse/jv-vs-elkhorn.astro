---
import Layout from '../../../layouts/Layout.astro';
import Lightbox from '../../../components/Lightbox.astro';

const title = "JV: MWHS vs Elkhorn";
const date = "April 18, 2025";
const location = "Millard West High School";
const imageCount = 24;

// Generate array of image objects
const images = Array.from({ length: imageCount }, (_, i) => ({
  id: i + 1,
  src: `/images/lacrosse/20250418-jv-mwhs-vs-elkhorn/20250418-JV-MWHSvsElkhorn - ${i + 1}.jpeg`,
  alt: `${title} - Image ${i + 1}`
}));

const imageUrls = images.map(img => img.src);
---

<Layout title={title}>
  <main class="min-h-screen bg-gray-50" data-images={JSON.stringify(images)}>
    <section class="relative bg-gray-900 text-white py-24">
      <div class="relative z-10 flex items-center h-full">
        <div class="container mx-auto px-4">
          <h1 class="text-4xl md:text-6xl font-bold text-white mb-4">{title}</h1>
          <p class="text-lg text-gray-200">
            {date} at {location}
          </p>
        </div>
      </div>
    </section>

    {/* Photo Grid */}
    <section class="container mx-auto px-4 py-12">
      <a 
        href="/images/lacrosse" 
        class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors mb-8"
      >
        <svg
          class="w-5 h-5 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"
          />
        </svg>
        Back to Lacrosse
      </a>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {images.map((image) => (
          <div 
            class="relative overflow-hidden rounded-lg cursor-pointer group aspect-[4/3]"
            data-index={image.id - 1}
            data-image-src={image.src}
            data-image-title={title}
          >
            <img
              src={image.src}
              alt={image.alt}
              class="gallery-image absolute inset-0 w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300" />
            <div class="absolute bottom-0 left-0 right-0 p-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <h3 class="text-white text-lg font-semibold">{title}</h3>
              <p class="text-gray-200 text-sm">{date}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Lightbox images={imageUrls} />
</Layout>

<style>
  /* Remove the fixed aspect ratio style */
  img {
    max-width: 100%;
    height: auto;
  }
</style> 