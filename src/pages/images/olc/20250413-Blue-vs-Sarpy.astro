---
import Layout from '../../../layouts/Layout.astro';
import { baseUrl } from '../../../config';

// Generate array of image paths
const images = Array.from({ length: 29 }, (_, i) => `/images/olc/20250413-Blue-vs-Sarpy/20250413_BluevsSarpy - ${i + 1}.jpeg`);
---

<Layout title="Blue vs Sarpy - Omaha Lacrosse Club">
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="mb-8">
        <a href="/images/omaha-lacrosse" class="inline-flex items-center text-gray-600 hover:text-gray-900">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Omaha Lacrosse Club
        </a>
      </div>

      <div class="text-left mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Blue vs Sarpy</h1>
        <p class="text-xl text-gray-600">April 13, 2025</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {images.map((image, index) => (
          <div class="group relative overflow-hidden rounded-lg">
            <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
              <div class="relative h-64">
                <img
                  src={image}
                  alt={`Blue vs Sarpy - Image ${index + 1}`}
                  class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-300"
                />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout> 