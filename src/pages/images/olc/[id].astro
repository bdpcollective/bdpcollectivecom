---
import Layout from '../../../layouts/Layout.astro';
import Lightbox from '../../../components/Lightbox.astro';

export async function getStaticPaths() {
  const games = [
    {
      id: "20250330_1_BluevsRampage",
      title: "Blue vs Rampage",
      date: "March 30, 2025",
      images: [
        '/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - 1.jpeg',
        '/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - 2.jpeg',
        '/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - 3.jpeg',
        '/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - 4.jpeg',
        '/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - 5.jpeg',
        '/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - 6.jpeg',
        '/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - 7.jpeg',
        '/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - 8.jpeg',
        '/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - 9.jpeg',
        '/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - 10.jpeg',
        '/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - 11.jpeg',
        '/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - 12.jpeg',
        '/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - 13.jpeg',
        '/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - 14.jpeg',
        '/images/olc/20250330_1_BluevsRampage/20250330_BluevsLincolnRampage - 15.jpeg',
        '/images/olc/20250330_1_BluevsRampage/20250330_BluevsRampage - 16.jpeg'
      ]
    },
    {
      id: "20250330_2_BluevsElkhorn",
      title: "Blue vs Elkhorn",
      date: "March 30, 2025",
      images: Array.from({ length: 47 }, (_, i) => `/images/olc/20250330_2_BluevsElkhorn/20250330_BluevsElkhorn - ${i + 1}.jpeg`)
    }
  ];

  return games.map(game => ({
    params: { id: game.id },
    props: { game }
  }));
}

const { game } = Astro.props;
---

<Layout title={`${game.title} - Omaha Lacrosse Club`}>
  <main class="min-h-screen bg-gray-50">
    <section class="container mx-auto px-4 py-12">
      <a 
        href="/images/omaha-lacrosse" 
        class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors mb-8"
      >
        <svg
          class="w-5 h-5 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"
          />
        </svg>
        Back to Omaha Lacrosse Club
      </a>

      <h1 class="text-4xl font-bold text-gray-900 mb-4">{game.title}</h1>
      <p class="text-gray-600 mb-8">{game.date}</p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {game.images.map((image, index) => (
          <div class="group relative">
            <img
              src={image}
              alt={`${game.title} - Photo ${index + 1}`}
              class="w-full h-64 object-cover rounded-lg cursor-pointer gallery-image"
              data-index={index}
            />
          </div>
        ))}
      </div>
    </section>
  </main>

  <Lightbox images={game.images} />
</Layout>

<style>
  img {
    aspect-ratio: 3/4;
  }
</style> 