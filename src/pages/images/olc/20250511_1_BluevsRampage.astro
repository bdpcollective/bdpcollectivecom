---
import Layout from '../../../layouts/Layout.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { baseUrl } from '../../../config';

const images = Array.from({ length: 28 }, (_, i) => `/images/olc/20250511_BluevsRampage/20250511_Rampage - ${i + 1}.jpeg`);

const title = "Blue vs Rampage - May 11, 2025";
const description = "Gallery of photos from the Omaha Lacrosse Club Blue vs Rampage game on May 11, 2025";
const canonicalUrl = `${baseUrl}/images/olc/20250511_1_BluevsRampage`;
---

<Layout title={title}>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="mb-8">
        <a href="/images/omaha-lacrosse" class="text-blue-600 hover:text-blue-800">← Back to Omaha Lacrosse Club</a>
      </div>
      
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Blue vs Rampage</h1>
      <p class="text-gray-600 mb-8">May 11, 2025</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {images.map((image, index) => (
          <div class="aspect-w-3 aspect-h-2 overflow-hidden rounded-lg">
            <img
              src={image}
              alt={`Game photo ${index + 1}`}
              class="gallery-image w-full h-full object-cover cursor-pointer transform hover:scale-105 transition-transform duration-300"
              loading={index < 9 ? "eager" : "lazy"}
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <Lightbox images={images} />
</Layout>

<style>
  /* Remove the fixed aspect ratio style */
  img {
    max-width: 100%;
    height: auto;
  }
</style> 