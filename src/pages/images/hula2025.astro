---
import Layout from '../../layouts/Layout.astro';

// Image arrays from blueox.astro
const macImages = [
  "Hula_BlueOx-01.jpg","Hula_BlueOx-02.jpg","Hula_BlueOx-03.jpg","Hula_BlueOx-04.jpg","Hula_BlueOx-05.jpg","Hula_BlueOx-06.jpg","Hula_BlueOx-07.jpg","Hula_BlueOx-08.jpg","Hula_BlueOx-09.jpg","Hula_BlueOx-10.jpg","Hula_BlueOx-11.jpg","Hula_BlueOx-12.jpg","Hula_BlueOx-13.jpg","Hula_BlueOx-14.jpg","Hula_BlueOx-15.jpg","Hula_BlueOx-16.jpg","Hula_BlueOx-17.jpg","Hula_BlueOx-18.jpg","Hula_BlueOx-19.jpg","Hula_BlueOx-20.jpg","Hula_BlueOx-21.jpg","Hula_BlueOx-22.jpg","Hula_BlueOx-23.jpg","Hula_BlueOx-24.jpg","Hula_BlueOx-25.jpg","Hula_BlueOx-26.jpg","Hula_BlueOx-27.jpg","Hula_BlueOx-28.jpg","Hula_BlueOx-29.jpg","Hula_BlueOx-30.jpg"
];
const greyduckImages = [
  "Hula_BlueOx-31.jpg","Hula_BlueOx-32.jpg","Hula_BlueOx-33.jpg","Hula_BlueOx-34.jpg","Hula_BlueOx-35.jpg","Hula_BlueOx-36.jpg","Hula_BlueOx-37.jpg","Hula_BlueOx-38.jpg","Hula_BlueOx-39.jpg","Hula_BlueOx-40.jpg","Hula_BlueOx-41.jpg","Hula_BlueOx-42.jpg"
];
const mnchillImages = [
  "Hula_BlueOx-43.jpg","Hula_BlueOx-44.jpg","Hula_BlueOx-45.jpg","Hula_BlueOx-46.jpg","Hula_BlueOx-47.jpg","Hula_BlueOx-48.jpg","Hula_BlueOx-49.jpg","Hula_BlueOx-50.jpg","Hula_BlueOx-51.jpg","Hula_BlueOx-52.jpg","Hula_BlueOx-53.jpg","Hula_BlueOx-54.jpg","Hula_BlueOx-55.jpg","Hula_BlueOx-56.jpg","Hula_BlueOx-57.jpg"
];

const macPaths = macImages.map(img => `/images/hula2025/blueox/mac/${img}`);
const greyduckPaths = greyduckImages.map(img => `/images/hula2025/blueox/greyduck/${img}`);
const mnchillPaths = mnchillImages.map(img => `/images/hula2025/blueox/mnchill/${img}`);
const allHulaGoldImages = [...macPaths, ...greyduckPaths, ...mnchillPaths];

function getRandomImage(images: string[]) {
  return images[Math.floor(Math.random() * images.length)];
}
const randomHulaGoldImage = getRandomImage(allHulaGoldImages);

const events = [
  {
    name: 'Blue Ox',
    image: randomHulaGoldImage,
    link: '/images/hula2025/blueox'
  },
  {
    name: 'BBQ Showdown',
    image: '/images/hula/placeholder1.jpeg',
    link: '/images/hula2025/bbq-showdown'
  }
];
---
<Layout title="2025 Hula">
  <div class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-8">2025 Hula</h1>
    <a href="/images/hula" class="text-blue-600 hover:underline mb-8 inline-block">← Back to Hula</a>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
      {events.map(event => (
        <a href={event.link} class="group block rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <div class="relative h-64">
            <img src={event.image} alt={event.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-end">
              <div class="p-4">
                <h2 class="text-white text-xl font-semibold">{event.name}</h2>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout> 