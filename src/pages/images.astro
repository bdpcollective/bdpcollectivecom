<Layout title="Images">
  <div class="bg-white">
    {/* Hero Section */}
    <section class="relative h-[50vh]">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <img
          src="/jelly.jpg"
          alt="Images hero background"
          class="w-full h-full object-cover brightness-50"
        />
      </div>

      {/* Hero Content */}
      <div class="relative z-10 flex flex-col items-center h-full">
        <div class="flex-1 flex items-center">
          <div class="text-center px-4">
            <h1 class="text-4xl md:text-6xl font-bold mb-6 text-white">
              Images
            </h1>
            <p class="text-lg md:text-xl text-gray-200 mb-8 max-w-2xl mx-auto">
          A collection of photography from various events and locations
        </p>
      </div>
    </div>
        
        {/* Chevron */}
        <button
          onclick="document.getElementById('image-cards').scrollIntoView({ behavior: 'smooth' })"
          class="animate-bounce p-2 rounded-full bg-white/10 hover:bg-white/20 transition-colors mb-8"
          aria-label="Scroll to image categories"
        >
          <svg
            class="w-8 h-8 text-white"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </button>
      </div>
    </section>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      {/* Category Filter */}
      <div class="flex flex-wrap gap-4 mb-8">
        {categories.map(category => (
          <button 
            class="px-4 py-2 rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors data-[active=true]:bg-gray-900 data-[active=true]:text-white"
            data-category={category}
            data-active={category === "All" ? "true" : "false"}
          >
            {category}
          </button>
        ))}
      </div>

      {/* Main Content */}
      <section id="image-cards" class="container mx-auto max-w-7xl px-4 py-12">
        <div class="flex justify-between items-center mb-8">
          <div class="flex gap-4">
            <button 
              class="px-4 py-2 rounded-full bg-gray-900 text-white hover:bg-gray-800 transition-colors data-[active=true]:bg-gray-900 data-[active=true]:text-white data-[active=false]:bg-gray-100 data-[active=false]:text-gray-700"
              data-sort="recent"
              data-active="true"
            >
              Recent
            </button>
            <button 
              class="px-4 py-2 rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors data-[active=true]:bg-gray-900 data-[active=true]:text-white data-[active=false]:bg-gray-100 data-[active=false]:text-gray-700"
              data-sort="popular"
              data-active="false"
            >
              Popular
            </button>
          </div>
          <div class="flex gap-2">
            <button 
              class="p-2 rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors data-[active=true]:bg-gray-900 data-[active=true]:text-white"
              data-view="row"
              data-active="false"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
            <button 
              class="p-2 rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors data-[active=true]:bg-gray-900 data-[active=true]:text-white"
              data-view="card"
              data-active="true"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 data-[view=row]:grid-cols-1" data-view="card">
          {images.map((image) => (
            <a 
              href={
                image.category === "Events" ? '/images/events' :
                image.category === "Lacrosse" ? '/images/lacrosse' : 
                image.category === "Omaha" ? '/images/omaha' : 
                image.category === "Zoo" ? '/images/zoo' : 
                image.category === "Nebraska Athletics" ? '/images/huskers' :
                image.category === "Omaha Lacrosse Club" ? '/images/omaha-lacrosse' :
                image.category === "Hula" ? '/images/hula2025' :
                "#"
              } 
              class="group relative overflow-hidden rounded-lg"
            >
              <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
                <div class="relative h-64">
                  <img
                    src={image.src}
                    alt={image.alt}
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-300"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent">
                    <div class="absolute bottom-0 left-0 right-0 p-4">
                      <h3 class="text-white text-xl font-semibold">{image.title}</h3>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  // Add category filter functionality
  const filterButtons = document.querySelectorAll('[data-category]');
  const sortButtons = document.querySelectorAll('[data-sort]');
  const viewButtons = document.querySelectorAll('[data-view]');
  const imageCards = document.querySelectorAll('.group');
  const gridContainer = document.querySelector('.grid');

  // Make categoryPhotoCount available to client-side
  const categoryPhotoCount = {
    "Omaha Lacrosse Club": 47,
    "Lacrosse": 72,
    "Omaha": 3,
    "Zoo": 4,
    "Nebraska Athletics": 4
  };

  // Handle view toggle clicks
  viewButtons.forEach(button => {
    button.addEventListener('click', () => {
      const viewType = button.getAttribute('data-view') || '';
      
      // Update active button
      viewButtons.forEach(btn => {
        btn.setAttribute('data-active', 'false');
      });
      button.setAttribute('data-active', 'true');

      // Update grid layout
      if (gridContainer) {
        gridContainer.setAttribute('data-view', viewType);
      }
    });
  });

  // Sort images by popularity (using photo count as a proxy)
  const sortImages = (sortType: string) => {
    const cards = Array.from(imageCards);
    cards.sort((a, b) => {
      const categoryA = a.querySelector('img')?.alt || '';
      const categoryB = b.querySelector('img')?.alt || '';
      const countA = categoryPhotoCount[categoryA as keyof typeof categoryPhotoCount] || 0;
      const countB = categoryPhotoCount[categoryB as keyof typeof categoryPhotoCount] || 0;
      
      if (sortType === 'popular') {
        return countB - countA;
      } else {
        return 0; // Keep original order for recent
      }
    });

    const container = document.querySelector('.grid');
    if (container) {
      cards.forEach(card => container.appendChild(card));
    }
  };

  // Handle sort button clicks
  sortButtons.forEach(button => {
    button.addEventListener('click', () => {
      const sortType = button.getAttribute('data-sort') || '';
      
      // Update active button
      sortButtons.forEach(btn => {
        btn.setAttribute('data-active', 'false');
      });
      button.setAttribute('data-active', 'true');

      // Sort images
      sortImages(sortType);
    });
  });

  // Handle category filter clicks
  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const category = button.getAttribute('data-category') || '';
      
      // Update active button
      filterButtons.forEach(btn => {
        btn.setAttribute('data-active', 'false');
      });
      button.setAttribute('data-active', 'true');

      // Filter images
      imageCards.forEach(card => {
        const cardCategory = card.querySelector('img')?.alt || '';
        if (category === 'All' || cardCategory === category || 
            (category === 'Millard West Lacrosse' && cardCategory === 'Lacrosse')) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script> 