---
import Layout from '../layouts/Layout.astro';

const categoryImages = {
  "Lacrosse": [
    '/images/lacrosse/20250308-varsity-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 1.jpeg',
    '/images/lacrosse/20250308-varsity-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 2.jpeg',
    '/images/lacrosse/20250308-varsity-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 3.jpeg',
    '/images/lacrosse/20250308-varsity-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 4.jpeg',
    '/images/lacrosse/20250308-varsity-mwhs-vs-akeny/20250309_MWHS_Lacrosse - 5.jpeg'
  ],
  "Omaha": [
    '/images/omaha/2010-12-09_bobkerrybridge_1024_3409.jpg',
    '/images/omaha/2010-12-09_flowers_1024_3412.jpg',
    '/images/omaha/20110704_Fireworks_bp-1.jpg'
  ],
  "Zoo": [
    '/images/zoo/2010-12-09_zoo_1024_3418.jpg',
    '/images/zoo/2010-12-11_PenguinBlog1200_3425.jpg',
    '/images/zoo/2010-12-09_zoo_1024_3417.jpg',
    '/images/zoo/2010-12-09_zoo_1024_3420.jpg'
  ],
  "Nebraska Athletics": [
    '/images/nu/2011-10-27_BrianandTom843.jpg',
    '/images/nu/2010-12-09_NU_1024_3414.jpg',
    '/images/nu/2010-10-31_NUvsMU_Pano3272.jpg',
    '/images/nu/NUvsWKU3_web.jpg'
  ]
  // "Omaha Lacrosse Club": [
  //   '/images/coming-soon.jpg'
  // ]
};

type CategoryKey = keyof typeof categoryImages;

const categoryPhotoCount: Record<CategoryKey, number> = {
  "Lacrosse": 72, // 19 JV + 53 Varsity photos
  "Omaha": 3,
  "Zoo": 4,
  "Nebraska Athletics": 4
};

const categoryTitles: Record<string, string> = {
  "Lacrosse": "Millard West Lacrosse",
  "Omaha": "Images Around Omaha",
  "Zoo": "Omaha Henry Doorly Zoo",
  "Nebraska Athletics": "Husker Related Images"
  // "Omaha Lacrosse Club": "Omaha Lacrosse Club"
};

const categories = ["All", "Lacrosse", "Omaha", "Zoo", "Nebraska Athletics"];

// Function to get a random image from an array
function getRandomImage(images: string[]): string {
  return images[Math.floor(Math.random() * images.length)];
}

// Create the images array with random images from each category
const images = Object.entries(categoryImages).map(([category, images]) => ({
  src: getRandomImage(images),
  alt: category,
  title: categoryTitles[category] || category,
  category: category as CategoryKey
}));
---

<Layout title="Images">
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="text-4xl font-bold text-gray-900 mb-8">Images</h1>
      
      {/* Category Filter */}
      <div class="flex flex-wrap gap-4 mb-8">
        {categories.map(category => (
          <button class="px-4 py-2 rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            {category}
          </button>
        ))}
      </div>

      {/* Main Content */}
      <section class="container mx-auto max-w-7xl px-4 py-12">
        <div class="flex justify-between items-center mb-8">
          <div class="flex gap-4">
            <button class="px-4 py-2 rounded-full bg-gray-900 text-white hover:bg-gray-800 transition-colors">
              Recent
            </button>
            <button class="px-4 py-2 rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
              Popular
            </button>
          </div>
          <div class="flex gap-2">
            <button class="p-2 rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
            <button class="p-2 rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {images.map((image) => (
            <a 
              href={
                image.category === "Lacrosse" ? '/images/lacrosse' : 
                image.category === "Omaha" ? '/images/omaha' : 
                image.category === "Zoo" ? '/images/zoo' : 
                image.category === "Nebraska Athletics" ? '/images/huskers' :
                image.category === "Omaha Lacrosse Club" ? '/images/lacrosse' : 
                "#"
              } 
              class="group relative overflow-hidden rounded-lg"
            >
              <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
                <div class="relative h-64">
                  <img
                    src={image.src}
                    alt={image.alt}
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-300"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent">
                    <div class="absolute bottom-0 left-0 right-0 p-4">
                      <h3 class="text-white text-xl font-semibold">{image.title}</h3>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  // Add category filter functionality
  const filterButtons = document.querySelectorAll('button');
  const imageCards = document.querySelectorAll('.group');

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const category = button.textContent?.trim() || '';
      
      // Update active button
      filterButtons.forEach(btn => {
        btn.classList.remove('bg-gray-900', 'text-white');
        btn.classList.add('bg-gray-100', 'text-gray-700');
      });
      button.classList.remove('bg-gray-100', 'text-gray-700');
      button.classList.add('bg-gray-900', 'text-white');

      // Filter images
      imageCards.forEach(card => {
        const categoryElement = card.querySelector('.text-sm');
        const cardCategory = categoryElement?.textContent || '';
        if (category === 'All' || cardCategory === category) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script> 