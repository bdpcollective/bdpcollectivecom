};

const categories = ["All", "Omaha Lacrosse Club", "Lacrosse", "Nebraska Athletics", "Zoo", "Omaha", "Events"];

// Function to get a random image from an array
function getRandomImage(images: string[]): string {
  return images[Math.floor(Math.random() * images.length)];
}

// Create the images array with random images from each category
const images = Object.entries(categoryImages).map(([category, images]) => ({
  src: getRandomImage(images),
  alt: category,
  title: categoryTitles[category] || category,
  category: category as CategoryKey
}));
