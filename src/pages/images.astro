---
import Layout from '../layouts/Layout.astro';

const images = [
  {
    src: "/images/image1.jpg",
    alt: "Image 1",
    title: "Image Title 1",
    category: "Category 1"
  },
  {
    src: "/images/image2.jpg",
    alt: "Image 2",
    title: "Image Title 2",
    category: "Category 1"
  },
  {
    src: "/images/image3.jpg",
    alt: "Image 3",
    title: "Image Title 3",
    category: "Category 2"
  },
  {
    src: "/images/image4.jpg",
    alt: "Image 4",
    title: "Image Title 4",
    category: "Category 2"
  },
  {
    src: "/images/image5.jpg",
    alt: "Image 5",
    title: "Image Title 5",
    category: "Category 3"
  },
  {
    src: "/images/image6.jpg",
    alt: "Image 6",
    title: "Image Title 6",
    category: "Category 3"
  }
];

const categories = [...new Set(images.map(img => img.category))];
---

<Layout title="Images">
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="text-4xl font-bold text-gray-900 mb-8">Image Gallery</h1>
      
      {/* Category Filter */}
      <div class="flex flex-wrap gap-4 mb-8">
        <button class="px-4 py-2 rounded-full bg-gray-900 text-white hover:bg-gray-800 transition-colors">
          All
        </button>
        {categories.map(category => (
          <button class="px-4 py-2 rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            {category}
          </button>
        ))}
      </div>

      {/* Image Grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {images.map(image => (
          <div class="group relative overflow-hidden rounded-lg shadow-lg">
            <img
              src={image.src}
              alt={image.alt}
              class="w-full h-64 object-cover transform group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-50 transition-all duration-300 flex items-center justify-center">
              <div class="text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 text-center p-4">
                <h3 class="text-xl font-semibold mb-2">{image.title}</h3>
                <p class="text-sm">{image.category}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  // Add category filter functionality
  const filterButtons = document.querySelectorAll('button');
  const imageCards = document.querySelectorAll('.group');

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const category = button.textContent.trim();
      
      // Update active button
      filterButtons.forEach(btn => {
        btn.classList.remove('bg-gray-900', 'text-white');
        btn.classList.add('bg-gray-100', 'text-gray-700');
      });
      button.classList.remove('bg-gray-100', 'text-gray-700');
      button.classList.add('bg-gray-900', 'text-white');

      // Filter images
      imageCards.forEach(card => {
        const cardCategory = card.querySelector('.text-sm').textContent;
        if (category === 'All' || cardCategory === category) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script> 