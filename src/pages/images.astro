  "Hula": hulaImages,
};

// Ordered from newest updated to oldest
const categoryOrder = [
  "Hula 2026",
  "2026 Lacrosse",
  "Box Lacrosse",
  "Landscape",
  "Hula",
  "Lacrosse",
  "Elkhorn South Basketball",
  "Events",
  "Nebraska Athletics",
  "Zoo"
];

const images: ImageCard[] = categoryOrder.map((category) => ({
  src: getRandomImage(allCategoryImages[category]),
  alt: category,
  title: categoryTitles[category] || category,
  category: category
}));
---

<Layout title="Images">
  <main>
    {/* Hero Section */}
    <section class="relative h-[50vh]">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <img
          src="/jelly.jpg"
          alt="Images hero background"
          class="w-full h-full object-cover brightness-50"
        />
      </div>

      {/* Hero Content */}
      <div class="relative z-10 flex flex-col items-center h-full">
        <div class="flex-1 flex items-center">
          <div class="text-center px-4">
            <h1 class="text-4xl md:text-6xl font-bold mb-6 text-white">
              Images
            </h1>
            <p class="text-lg md:text-xl text-gray-200 mb-8 max-w-2xl mx-auto">
              A collection of photography from various events and locations
            </p>
          </div>
        </div>
        
        {/* Chevron */}
        <button
          id="scroll-button"
          class="animate-bounce p-2 rounded-full bg-white/10 hover:bg-white/20 transition-colors mb-8"
          aria-label="Scroll to image categories"
        >
          <svg
            class="w-8 h-8 text-white"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </button>
      </div>
    </section>
    
    {/* Image Cards Section */}
    <section id="image-cards" class="container mx-auto px-4 py-20">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {images.map((image, index) => (
          <a
            href={
              image.category === "Events" ? '/images/events' :
              image.category === "Lacrosse" ? '/images/lacrosse' :
              image.category === "Zoo" ? '/images/zoo' :
              image.category === "Nebraska Athletics" ? '/images/huskers' :
              image.category === "Hula" ? '/images/hula2025' :
              image.category === "Landscape" ? '/images/landscape' :
              image.category === "Box Lacrosse" ? '/images/boxlacrosse' :
              image.category === "Elkhorn South Basketball" ? '/images/elkhornsouthbasketball' :
              image.category === "Hula 2026" ? '/images/lacrosse/hula-2026' :
              image.category === "2026 Lacrosse" ? '/images/lacrosse2026' :
              "#"
            }
            class="group h-full scroll-fade-in magnetic-card"
            data-index={index}
            style="opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease-out, transform 0.6s ease-out;"
          >
            <div class="relative overflow-hidden rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-all hover:shadow-md h-full flex flex-col">
              <div class="h-64 mb-4 overflow-hidden rounded-lg">
                <img
                  src={image.src}
                  alt={image.alt}
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <h2 class="mb-2 text-xl font-semibold text-gray-900">{image.title}</h2>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    // Handle scrolling for the chevron button
    const scrollButton = document.getElementById('scroll-button');
    const imageCards = document.getElementById('image-cards');

    if (scrollButton && imageCards) {
      scrollButton.addEventListener('click', () => {
        imageCards.scrollIntoView({ behavior: 'smooth' });
      }, { passive: true });
    }

    // Scroll-triggered animations using Intersection Observer
    const animatedCards = document.querySelectorAll('.scroll-fade-in');

    if (animatedCards.length > 0 && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const element = entry.target as HTMLElement;
            const index = parseInt(element.dataset.index || '0');
            setTimeout(() => {
              element.style.opacity = '1';
              element.style.transform = 'translateY(0)';
            }, index * 100);
            observer.unobserve(element);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      });

      animatedCards.forEach((card) => {
        observer.observe(card);
      });
    } else {
      animatedCards.forEach((card) => {
        (card as HTMLElement).style.opacity = '1';
        (card as HTMLElement).style.transform = 'translateY(0)';
      });
    }

    // Magnetic hover effects
    const magneticCards = document.querySelectorAll('.magnetic-card');
    const magneticStrength = 0.15;

    magneticCards.forEach((card) => {
      const cardElement = card as HTMLElement;
      let currentX = 0;
      let currentY = 0;
      let targetX = 0;
      let targetY = 0;
      let rafId: number | null = null;

      function animate() {
        currentX += (targetX - currentX) * 0.1;
        currentY += (targetY - currentY) * 0.1;

        cardElement.style.transform = `translate(${currentX}px, ${currentY}px)`;

        if (Math.abs(targetX - currentX) > 0.1 || Math.abs(targetY - currentY) > 0.1) {
          rafId = requestAnimationFrame(animate);
        } else {
          rafId = null;
        }
      }

      cardElement.addEventListener('mouseenter', () => {
        cardElement.style.transition = 'none';
      });

      cardElement.addEventListener('mouseleave', () => {
        targetX = 0;
        targetY = 0;
        cardElement.style.transition = 'transform 0.3s ease-out';
        if (rafId) {
          cancelAnimationFrame(rafId);
        }
        animate();
      });

      cardElement.addEventListener('mousemove', (e) => {
        const rect = cardElement.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;

        const deltaX = (e.clientX - centerX) * magneticStrength;
        const deltaY = (e.clientY - centerY) * magneticStrength;

        targetX = deltaX;
        targetY = deltaY;

        if (!rafId) {
          rafId = requestAnimationFrame(animate);
        }
      });
    });
  });
</script> 