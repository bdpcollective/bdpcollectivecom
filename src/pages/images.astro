const categoryTitles: Record<string, string> = {
  "Events": "Events",
  "Omaha Lacrosse Club": "2025 Omaha Lacrosse Club",
  "Lacrosse": "2025 Millard West Lacrosse",
  "Omaha": "Images Around Omaha",
  "Zoo": "Omaha Henry Doorly Zoo",
  "Nebraska Athletics": "Nebraska Athletics",
  "Colorado": "Colorado 2025"
};

// Function to get a random image from an array
function getRandomImage(images: string[]): string {
  return images[Math.floor(Math.random() * images.length)];
}

type ImageCard = {
  src: string;
  alt: string;
  title: string;
  category: string;
};

const images: ImageCard[] = Object.entries(categoryImages).map(([category, images]) => ({
  src: getRandomImage(images),
  alt: category,
  title: categoryTitles[category] || category,
  category: category
}));

