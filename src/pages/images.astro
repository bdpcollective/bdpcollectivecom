const categories = ["All", "Omaha Lacrosse Club", "Millard West Lacrosse", "Nebraska Athletics", "Zoo", "Omaha", "Events"];

// Function to get a random image from an array
function getRandomImage(images: string[]): string {
  return images[Math.floor(Math.random() * images.length)];
}

type ImageCard = {
  src: string;
  alt: string;
  title: string;
  category: string;
};

const images: ImageCard[] = Object.entries(categoryImages).map(([category, images]) => ({
  src: getRandomImage(images),
  alt: category,
  title: categoryTitles[category] || category,
  category: category
}));

