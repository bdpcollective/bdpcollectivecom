  src: getRandomImage(hulaImages),
  alt: "Hula",
  title: "2025 Hula Lacrosse",
  category: "Hula"
});

// Order cards from newest to oldest
images.reverse();

// Move 'Colorado 2025' to index 0 (first position - newest gallery)
const coloradoIndex = images.findIndex(img => img.title === 'Colorado 2025');
if (coloradoIndex > 0) {
  const [coloradoCard] = images.splice(coloradoIndex, 1);
  images.splice(0, 0, coloradoCard);
}

// Move '2025 Millard West Lacrosse' to index 1 (second position)
const mwIndex = images.findIndex(img => img.title === '2025 Millard West Lacrosse');
if (mwIndex > 1) {
  const [mwCard] = images.splice(mwIndex, 1);
  images.splice(1, 0, mwCard);
}

// Move '2025 Omaha Lacrosse Club' to index 2 (third position)
const olcIndex = images.findIndex(img => img.title === '2025 Omaha Lacrosse Club');
if (olcIndex > 2) {
  const [olcCard] = images.splice(olcIndex, 1);
  images.splice(2, 0, olcCard);
}
---

<Layout title="Images">
  <main>
    {/* Hero Section */}
    <section class="relative h-[50vh]">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <img
          src="/jelly.jpg"
          alt="Images hero background"
          class="w-full h-full object-cover brightness-50"
        />
      </div>

      {/* Hero Content */}
      <div class="relative z-10 flex flex-col items-center h-full">
        <div class="flex-1 flex items-center">
          <div class="text-center px-4">
            <h1 class="text-4xl md:text-6xl font-bold mb-6 text-white">
              Images
            </h1>
            <p class="text-lg md:text-xl text-gray-200 mb-8 max-w-2xl mx-auto">
              A collection of photography from various events and locations
            </p>
          </div>
        </div>
        
        {/* Chevron */}
        <button
          id="scroll-button"
          class="animate-bounce p-2 rounded-full bg-white/10 hover:bg-white/20 transition-colors mb-8"
          aria-label="Scroll to image categories"
        >
          <svg
            class="w-8 h-8 text-white"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </button>
      </div>
    </section>
    
    {/* Image Cards Section */}
    <section id="image-cards" class="container mx-auto px-4 py-20">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {images.map((image) => (
          <a 
            href={
              image.category === "Events" ? '/images/events' :
              image.category === "Lacrosse" ? '/images/lacrosse' :
              image.category === "Omaha" ? '/images/omaha' :
              image.category === "Zoo" ? '/images/zoo' :
              image.category === "Nebraska Athletics" ? '/images/huskers' :
              image.category === "Omaha Lacrosse Club" ? '/images/omaha-lacrosse' :
              image.category === "Hula" ? '/images/hula2025' :
              image.category === "Colorado" ? '/images/travel/colorado2025' :
              "#"
            } 
            class="group h-full"
          >
            <div class="relative overflow-hidden rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-all hover:shadow-md h-full flex flex-col">
              <div class="h-64 mb-4 overflow-hidden rounded-lg">
                <img
                  src={image.src}
                  alt={image.alt}
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <h3 class="mb-2 text-xl font-semibold text-gray-900">{image.title}</h3>
              <p class="text-gray-600">View {image.category} photography collection</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>

<script>
  // Handle scrolling for the chevron button
  document.addEventListener('DOMContentLoaded', function() {
    const scrollButton = document.getElementById('scroll-button');
    const imageCards = document.getElementById('image-cards');
    
    if (scrollButton && imageCards) {
      scrollButton.addEventListener('click', function() {
        // Use a more reliable scrolling method that works everywhere
        const targetPosition = imageCards.offsetTop - 100; // Offset by 100px for better positioning
        
        // Try smooth scrolling first, fall back to instant scrolling
        if ('scrollBehavior' in document.documentElement.style) {
          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          });
        } else {
          // Fallback for browsers that don't support smooth scrolling
          window.scrollTo(0, targetPosition);
        }
      });
    }
  });
</script> 