---
// No layout wrapper - full screen presentation
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>AI Prototype - Brian Pope</title>
	<style>
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}
		
		html, body {
			height: 100%;
			overflow: hidden;
		}
		
		.presentation-container {
			width: 100vw;
			height: 100vh;
			overflow: hidden;
		}
		
		iframe {
			width: 100%;
			height: 100%;
			border: none;
			display: block;
		}
	</style>
</head>
<body>
	<div class="presentation-container">
		<iframe 
			src="/aiprototype/index.html" 
			title="AI Prototype Presentation"
			allowfullscreen>
		</iframe>
	</div>
</body>
</html>


