---
import Layout from '../layouts/Layout.astro';
import Lightbox from '../components/Lightbox.astro';

// Generate image array for all 93 slides
const images = Array.from({ length: 93 }, (_, i) =>
  `/images/codemash2026/Codemash.${String(i + 1).padStart(3, '0')}.jpeg`
);

const title = "CodeMash 2026 - Slide Deck";
const description = "Slides from Brian Pope's CodeMash 2026 presentation";
---

<Layout title={title}>
  <div class="bg-gray-900 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="mb-8">
        <a href="/" class="text-blue-400 hover:text-blue-300">&larr; Back to Home</a>
      </div>

      <h1 class="text-4xl font-bold text-white mb-4">{title}</h1>
      <p class="text-gray-400 mb-4">{description}</p>
      <p class="text-gray-500 mb-8 text-sm">Click any slide to view full screen. Use arrow keys or swipe to navigate.</p>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {images.map((image, index) => (
          <div class="relative group cursor-pointer overflow-hidden rounded-lg border border-gray-700 hover:border-blue-500 transition-colors">
            <img
              src={image}
              alt={`Slide ${index + 1}`}
              class="gallery-image w-full h-auto object-cover transition-transform duration-300 group-hover:scale-105"
              loading={index < 12 ? "eager" : "lazy"}
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-2">
              <span class="text-white text-sm font-medium">{index + 1}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <Lightbox images={images} />
</Layout>
