---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { baseUrl } from '../../config';

const content = {
  projectDescription: {
    text: [
      "The I-80 Club logo was designed to represent a social club focused on community engagement and local events.",
      "The design process began with understanding the club's mission to bring people together and create meaningful connections.",
      "The final logo combines a modern, friendly aesthetic with elements that suggest community and connectivity."
    ],
    images: [
      "/logos/i80club/1_i80club_overview.png"
    ]
  },
  logoVariations: {
    text: [
      "We created multiple variations of the logo to ensure flexibility across different applications.",
      "The primary logo works well on both light and dark backgrounds, while the simplified version is ideal for smaller spaces.",
      "Each variation maintains the core brand identity while adapting to specific use cases."
    ],
    images: [
      "/logos/i80club/2_logo_variations.png",
      "/logos/i80club/3_logo_variations.png"
    ]
  },
  brandGuidelines: {
    text: [
      "Comprehensive brand guidelines were developed to ensure consistent application of the logo across all touchpoints.",
      "The guidelines include color specifications, spacing requirements, and minimum size recommendations.",
      "These standards help maintain the integrity of the brand identity across all applications."
    ],
    image: "/logos/i80club/4_brand_guidelines.png"
  },
  implementationExamples: {
    text: [
      "The logo has been successfully implemented across various platforms and materials.",
      "From business cards and letterhead to digital platforms and marketing materials, the logo maintains its impact and recognition.",
      "These examples demonstrate the versatility and effectiveness of the design in real-world applications."
    ],
    images: [
      "/logos/i80club/5_implementation.png",
      "/logos/i80club/6_implementation.png"
    ]
  }
};
---

<Layout title="I-80 Club - Logos">
  <main>
    {/* Hero Section */}
    <section class="relative bg-black py-12">
      <div class="relative z-10 flex flex-col justify-center px-4 container mx-auto">
        <div class="max-w-7xl mx-auto w-full">
          <div class="w-24 h-24 flex items-center mb-2">
            <img
              src="/logos/I80Club.png"
              alt="I-80 Club logo"
              width="96"
              height="96"
              class="object-contain"
            />
          </div>
          <h1 class="text-4xl md:text-6xl font-bold mb-4 text-white">
            I-80 Club
          </h1>
          <p class="text-lg md:text-xl text-gray-300 mb-4">
            Logo design for a social club focused on community engagement
          </p>
        </div>
      </div>
    </section>

    {/* Content Section */}
    <section class="container mx-auto px-4 py-20">
      <div class="max-w-3xl mx-auto space-y-16">
        {/* Back Button */}
        <a 
          href="/logos" 
          class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors mb-8"
        >
          <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Logos
        </a>

        {/* Project Description */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Project Description</h2>
          <div class="prose max-w-none mb-8">
            {content.projectDescription.text.map((paragraph) => (
              <p class="mb-4">{paragraph}</p>
            ))}
          </div>
          <div class="rounded-lg overflow-hidden shadow-lg">
            <img
              src={content.projectDescription.images[0]}
              alt="I-80 Club logo overview"
              width="800"
              height="600"
              class="w-full object-contain"
            />
          </div>
        </div>

        {/* Logo Variations */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Logo Variations</h2>
          <div class="prose max-w-none mb-8">
            {content.logoVariations.text.map((paragraph) => (
              <p class="mb-4">{paragraph}</p>
            ))}
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {content.logoVariations.images.map((image) => (
              <div class="rounded-lg overflow-hidden shadow-lg">
                <img
                  src={image}
                  alt="Logo variation"
                  width="400"
                  height="300"
                  class="w-full object-contain"
                />
              </div>
            ))}
          </div>
        </div>

        {/* Brand Guidelines */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Brand Guidelines</h2>
          <div class="prose max-w-none mb-8">
            {content.brandGuidelines.text.map((paragraph) => (
              <p class="mb-4">{paragraph}</p>
            ))}
          </div>
          <div class="rounded-lg overflow-hidden shadow-lg">
            <img
              src={content.brandGuidelines.image}
              alt="Brand guidelines"
              width="800"
              height="600"
              class="w-full object-contain"
            />
          </div>
        </div>

        {/* Implementation Examples */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Implementation Examples</h2>
          <div class="prose max-w-none mb-8">
            {content.implementationExamples.text.map((paragraph) => (
              <p class="mb-4">{paragraph}</p>
            ))}
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {content.implementationExamples.images.map((image) => (
              <div class="rounded-lg overflow-hidden shadow-lg">
                <img
                  src={image}
                  alt="Implementation example"
                  width="400"
                  height="300"
                  class="w-full object-contain"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Fixed Navigation Arrows */}
    <div class="fixed left-4 top-1/2 -translate-y-1/2 z-50">
      <a 
        href="/logos" 
        class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/80 hover:bg-white shadow-lg text-gray-600 hover:text-gray-900 transition-colors"
        aria-label="Back to Logos"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
    </div>
    <div class="fixed right-4 top-1/2 -translate-y-1/2 z-50">
      <a 
        href="/logos/devobsessed" 
        class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/80 hover:bg-white shadow-lg text-gray-600 hover:text-gray-900 transition-colors"
        aria-label="Next Project"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </main>
</Layout> 