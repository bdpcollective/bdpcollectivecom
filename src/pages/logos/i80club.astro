---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { baseUrl } from '../../config';

const content = {
  projectOverview: {
    text: [
      "I designed the logo for the I-80 Club, a podcast network centered on Nebraska sports and college football. The brand needed a bold, memorable identity that matched its energetic and fan-driven voice."
    ]
  },
  objectives: {
    text: [
      "Create a strong, flexible logo for digital platforms",
      "Capture a local, Midwest feel with a modern edge",
      "Stand out in a crowded sports media space"
    ]
  },
  designApproach: {
    text: [
      "Visual Theme: Inspired by highway signs and retro sports branding",
      "Typography: Custom bold type to evoke authority and personality",
      "Color Palette: High-contrast colors for maximum visibility on thumbnails and social media"
    ]
  },
  outcome: {
    text: [
      "The I-80 Club logo gives the network a recognizable identity across YouTube, Patreon, and live streams. It holds up well in small sizes and pairs easily with show-specific branding like After Nebrasketball and Volleyball State."
    ]
  },
  deliverables: {
    items: [
      {
        title: "Logo Formats",
        details: "SVG, PNG, EPS"
      },
      {
        title: "Variations",
        details: "Horizontal, stacked, and icon-only"
      },
      {
        title: "Usage Examples",
        details: "YouTube thumbnails, stream overlays, merchandise"
      }
    ]
  },
  images: {
    overview: "/logos/i80club/1_i80club_overview.png",
    variations: [
      "/logos/i80club/2_logo_variations.png",
      "/logos/i80club/3_logo_variations.png"
    ],
    guidelines: "/logos/i80club/4_logo_variations.png",
    implementation: [
      "/logos/i80club/5_logo_variations.png",
      "/logos/i80club/6_logo_variations.png"
    ]
  }
};
---

<Layout title="I-80 Club - Logos">
  <main>
    {/* Hero Section */}
    <section class="relative bg-black py-12">
      <div class="relative z-10 flex flex-col justify-center px-4 container mx-auto">
        <div class="max-w-7xl mx-auto w-full">
          <div class="w-48 h-auto flex items-center justify-center mb-2 pb-4">
            <img
              src="/logos/I80Club.png"
              alt="I-80 Club logo"
              width="192"
              height="96"
              class="w-full object-contain"
            />
          </div>
          <h1 class="text-4xl md:text-6xl font-bold mb-4 text-white">
            I-80 Club
          </h1>
          <p class="text-lg md:text-xl text-gray-300 mb-4">
            Logo design for a Nebraska sports podcast network
          </p>
        </div>
      </div>
    </section>

    {/* Content Section */}
    <section class="container mx-auto px-4 py-20">
      <div class="max-w-3xl mx-auto space-y-16">
        {/* Back Button */}
        <a 
          href="/logos" 
          class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors mb-8"
        >
          <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Logos
        </a>

        {/* Project Overview */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Project Overview</h2>
          <div class="prose max-w-none mb-8">
            {content.projectOverview.text.map((paragraph) => (
              <p class="mb-4">{paragraph}</p>
            ))}
          </div>
          <div class="rounded-lg overflow-hidden shadow-lg">
            <img
              src={content.images.overview}
              alt="I-80 Club logo overview"
              width="800"
              height="600"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        {/* Objectives */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Objectives</h2>
          <div class="prose max-w-none mb-8">
            <ul class="list-disc pl-5 space-y-2">
              {content.objectives.text.map((objective) => (
                <li>{objective}</li>
              ))}
            </ul>
          </div>
        </div>

        {/* Design Approach */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Design Approach</h2>
          <div class="prose max-w-none mb-8">
            <ul class="list-disc pl-5 space-y-2">
              {content.designApproach.text.map((approach) => (
                <li>{approach}</li>
              ))}
            </ul>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {content.images.variations.map((image) => (
              <div class="rounded-lg overflow-hidden shadow-lg">
                <img
                  src={image}
                  alt="Logo variation"
                  width="400"
                  height="300"
                  class="w-full h-full object-cover"
                />
              </div>
            ))}
          </div>
        </div>

        {/* Outcome */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Outcome</h2>
          <div class="prose max-w-none mb-8">
            {content.outcome.text.map((paragraph) => (
              <p class="mb-4">{paragraph}</p>
            ))}
          </div>
          <div class="rounded-lg overflow-hidden shadow-lg">
            <img
              src={content.images.guidelines}
              alt="Brand guidelines"
              width="800"
              height="600"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        {/* Implementation Images */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {content.images.implementation.map((image) => (
            <div class="rounded-lg overflow-hidden shadow-lg">
              <img
                src={image}
                alt="Implementation example"
                width="400"
                height="300"
                class="w-full h-full object-cover"
              />
            </div>
          ))}
        </div>

        {/* Deliverables */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Deliverables</h2>
          <div class="prose max-w-none mb-8">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Deliverable</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Details</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                {content.deliverables.items.map((item) => (
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{item.title}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{item.details}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    {/* Fixed Navigation Arrows */}
    <div class="fixed left-4 top-1/2 -translate-y-1/2 z-50">
      <a 
        href="/logos" 
        class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/80 hover:bg-white shadow-lg text-gray-600 hover:text-gray-900 transition-colors"
        aria-label="Back to Logos"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
    </div>
    <div class="fixed right-4 top-1/2 -translate-y-1/2 z-50">
      <a 
        href="/logos/devobsessed" 
        class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/80 hover:bg-white shadow-lg text-gray-600 hover:text-gray-900 transition-colors"
        aria-label="Next Project"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </main>
</Layout> 