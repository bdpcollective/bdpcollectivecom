---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { baseUrl } from '../../config';

const content = {
  projectOverview: {
    text: [
      "I designed the logo for King Creek Woodworks, a custom woodworking business specializing in handcrafted furniture and home decor. The brand needed a distinctive identity that reflected the craftsmanship, quality, and rustic elegance of their handcrafted pieces while appealing to both traditional and modern aesthetics."
    ]
  },
  objectives: {
    text: [
      "Create a distinctive logo that captures the essence of handcrafted woodworking",
      "Develop a versatile design that works across various applications",
      "Establish a brand identity that appeals to both traditional and modern aesthetics",
      "Ensure the logo is memorable and reflects the quality of craftsmanship"
    ]
  },
  designApproach: {
    text: [
      "Visual Theme: Crown, Creek that acts as a beard to represent the owner",
      "Typography: Modern San Serif Font",
      "Color Palette: Could be anything. This logo is engraved on the back of each piece.",
      "Iconography: Crown, Creek, Beard"
    ]
  },
  outcome: {
    text: [
      "The final logo design successfully captures the essence of King Creek Woodworks' craftsmanship and quality. It provides a strong foundation for their brand identity while maintaining versatility across different applications, from business cards to product labels and signage."
    ]
  },
  deliverables: {
    items: [
      {
        title: "Logo Formats",
        details: "Vector (AI, EPS), Raster (PNG, JPG), Black and White versions"
      },
      {
        title: "Variations",
        details: "Full logo, Icon only, Horizontal layout, Vertical layout"
      },
      {
        title: "Usage Examples",
        details: "Business cards, Signage, Product labels, Website, Social media"
      }
    ]
  },
  images: {
    overview: "/logos/kingcreekwoodworks/kingcreek_FullLogo_Outlines.png",
    variations: [
      "/logos/kingcreekwoodworks/kingcreek_Logo_Outlines 1.png",
      "/logos/kingcreekwoodworks/kingcreek_Logo_Outlines_R 1.png"
    ],
    guidelines: "/logos/kingcreekwoodworks/kingcreek_FullLogo_Outlines_R.png",
    implementation: [
      "/logos/kingcreekwoodworks/Logocard.png",
      "/logos/kingcreekwoodworks/kingcreek_FullLogo_Outlines.png"
    ]
  }
};
---

<Layout title="King Creek Woodworks - Logos">
  <main>
    {/* Hero Section */}
    <section class="relative bg-black py-12">
      <div class="relative z-10 flex flex-col justify-center px-4 container mx-auto">
        <div class="max-w-7xl mx-auto w-full">
          <div class="w-48 h-auto flex items-center justify-center mb-2 pb-4">
            <div class="rounded-2xl overflow-hidden">
              <img
                src="/logos/kingcreekwoodworks/Logocard.png"
                alt="King Creek Woodworks logo"
                width="192"
                height="96"
                class="w-full object-contain"
              />
            </div>
          </div>
          <h1 class="text-4xl md:text-6xl font-bold mb-4 text-white">
            King Creek Woodworks
          </h1>
          <p class="text-lg md:text-xl text-gray-300 mb-4">
            Logo design for a custom woodworking business
          </p>
        </div>
      </div>
    </section>

    {/* Content Section */}
    <section class="container mx-auto px-4 py-20">
      <div class="max-w-3xl mx-auto space-y-16">
        {/* Back Button */}
        <a 
          href="/logos" 
          class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors mb-8"
        >
          <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Logos
        </a>

        {/* Project Overview */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Project Overview</h2>
          <div class="prose max-w-none mb-8">
            {content.projectOverview.text.map((paragraph) => (
              <p class="mb-4">{paragraph}</p>
            ))}
          </div>
          <div class="rounded-lg overflow-hidden shadow-lg flex items-center justify-center">
            <img
              src={content.images.overview}
              alt="King Creek Woodworks logo overview"
              width="800"
              height="600"
              class="w-full h-auto object-contain"
            />
          </div>
        </div>

        {/* Objectives */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Objectives</h2>
          <div class="prose max-w-none mb-8">
            <ul class="list-disc pl-5 space-y-2">
              {content.objectives.text.map((objective) => (
                <li>{objective}</li>
              ))}
            </ul>
          </div>
        </div>

        {/* Design Approach */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Design Approach</h2>
          <div class="prose max-w-none mb-8">
            <ul class="list-disc pl-5 space-y-2">
              {content.designApproach.text.map((approach) => (
                <li>{approach}</li>
              ))}
            </ul>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {content.images.variations.map((image) => (
              <div class="rounded-lg overflow-hidden shadow-lg flex items-center justify-center">
                <img
                  src={image}
                  alt="Logo variation"
                  width="400"
                  height="300"
                  class="w-full h-auto object-contain"
                />
              </div>
            ))}
          </div>
        </div>

        {/* Outcome */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Outcome</h2>
          <div class="prose max-w-none mb-8">
            {content.outcome.text.map((paragraph) => (
              <p class="mb-4">{paragraph}</p>
            ))}
          </div>
          <div class="rounded-lg overflow-hidden shadow-lg flex items-center justify-center">
            <img
              src={content.images.guidelines}
              alt="Brand guidelines"
              width="800"
              height="600"
              class="w-full h-auto object-contain"
            />
          </div>
        </div>

        {/* Implementation Images */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {content.images.implementation.map((image, index) => (
            <div class={`rounded-lg overflow-hidden shadow-lg flex items-center justify-center ${index === 0 ? 'bg-[#022432]' : ''}`}>
              <img
                src={image}
                alt="Implementation example"
                width="400"
                height="300"
                class="w-full h-auto object-contain"
              />
            </div>
          ))}
        </div>

        {/* Deliverables */}
        <div>
          <h2 class="text-3xl font-bold mb-6">Deliverables</h2>
          <div class="prose max-w-none mb-8">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Deliverable</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Details</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                {content.deliverables.items.map((item) => (
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{item.title}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{item.details}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    {/* Fixed Navigation Arrows */}
    <div class="fixed left-4 top-1/2 -translate-y-1/2 z-50">
      <a 
        href="/logos" 
        class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/80 hover:bg-white shadow-lg text-gray-600 hover:text-gray-900 transition-colors"
        aria-label="Back to Logos"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
    </div>
    <div class="fixed right-4 top-1/2 -translate-y-1/2 z-50">
      <a 
        href="/logos/connectaha" 
        class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/80 hover:bg-white shadow-lg text-gray-600 hover:text-gray-900 transition-colors"
        aria-label="Next Project"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </main>
</Layout> 