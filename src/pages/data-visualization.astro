---
import Layout from '../layouts/Layout.astro';
import { baseUrl } from '../config';
---

<Layout title="Data Visualization">
  <main class="overflow-x-hidden w-full max-w-full">
    {/* Hero Section with Parallax */}
    <section class="relative h-[50vh] overflow-hidden">
      {/* Background Image with Parallax */}
      <div class="absolute inset-0 z-0 parallax-bg">
        <img
          src={`${baseUrl}/data-viz-hero.jpg`}
          alt="Data visualization hero background"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover brightness-50 parallax-image"
        />
      </div>

      {/* Hero Content with Parallax */}
      <div class="relative z-10 flex flex-col items-center h-full parallax-content">
        <div class="flex-1 flex items-center">
          <div class="text-center px-4">
            <h1 class="text-4xl md:text-6xl font-bold mb-6 text-white creative-typography">
              <span class="gradient-text animate-reveal">Data Visualization</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-200 mb-8 max-w-2xl mx-auto animate-reveal-delay">
              Interactive data visualizations and analytics projects.
            </p>
          </div>
        </div>
        
        {/* Chevron */}
        <button
          id="scroll-to-cards"
          class="animate-bounce p-2 rounded-full bg-white/10 hover:bg-white/20 transition-colors mb-8"
          aria-label="Scroll to visualization categories"
        >
          <svg
            class="w-8 h-8 text-white"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </button>
      </div>
    </section>

    {/* Projects Grid */}
    <section id="data-viz-cards" class="container mx-auto px-4 py-20">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {/* Poverty Levels */}
        <a href={`${baseUrl}/data-visualization/poverty-levels/index.html`} class="group h-full scroll-fade-in magnetic-card" data-index="0" style="opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease-out, transform 0.6s ease-out;">
          <div class="relative overflow-hidden rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-all hover:shadow-md h-full flex flex-col">
            <div class="h-64 mb-4 overflow-hidden rounded-lg">
              <img
                src={`${baseUrl}/images/poverty/poverty-map.png`}
                alt="Poverty Levels by County"
                width="800"
                height="450"
                loading="lazy"
                class="object-cover w-full h-full transition-transform duration-300 group-hover:scale-105"
              />
            </div>
            <h3 class="mb-2 text-xl font-semibold text-gray-900">Poverty Levels</h3>
            <p class="text-gray-700">Interactive map showing poverty rates across US counties</p>
          </div>
        </a>

        {/* NCAA Basketball */}
        <a href={`${baseUrl}/data-visualization/basketball-tree/index.html`} class="group h-full scroll-fade-in magnetic-card" data-index="1" style="opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease-out, transform 0.6s ease-out;">
          <div class="relative overflow-hidden rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-all hover:shadow-md h-full flex flex-col">
            <div class="h-64 mb-4 overflow-hidden rounded-lg">
              <img
                src={`${baseUrl}/images/ncaa/ncaa-tree.png`}
                alt="Basketball Collapsible Tree"
                width="800"
                height="450"
                loading="lazy"
                class="object-cover w-full h-full transition-transform duration-300 group-hover:scale-105"
              />
            </div>
            <h3 class="mb-2 text-xl font-semibold text-gray-900">Basketball Trees</h3>
            <p class="text-gray-700">Interactive visualization of basketball team clustering</p>
          </div>
        </a>
      </div>
    </section>
  </main>

  <style>
    .parallax-bg {
      will-change: transform;
    }
    .parallax-image {
      transform: translateY(0);
      will-change: transform;
    }
    .parallax-content {
      will-change: transform;
    }

    /* Creative Typography Styles */
    .gradient-text {
      background: linear-gradient(135deg, #ffffff 0%, #e0e7ff 50%, #c7d2fe 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      background-size: 200% 200%;
      animation: gradient-shift 3s ease infinite;
    }

    @keyframes gradient-shift {
      0%, 100% {
        background-position: 0% 50%;
      }
      50% {
        background-position: 100% 50%;
      }
    }

    .animate-reveal {
      opacity: 0;
      transform: translateY(30px);
      animation: reveal-text 1s ease-out 0.3s forwards;
    }

    .animate-reveal-delay {
      opacity: 0;
      transform: translateY(20px);
      animation: reveal-text 1s ease-out 0.8s forwards;
    }

    @keyframes reveal-text {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .creative-typography {
      letter-spacing: -0.02em;
    }
  </style>

  <script>
    document.addEventListener('astro:page-load', () => {
      // Parallax scrolling effect - optimized with requestAnimationFrame
      let ticking = false;
      const parallaxBg = document.querySelector('.parallax-image') as HTMLElement;
      const parallaxContent = document.querySelector('.parallax-content') as HTMLElement;

      function updateParallax() {
        const scrolled = window.pageYOffset;
        const heroHeight = window.innerHeight * 0.5; // 50vh

        // Only apply parallax within hero section
        if (scrolled < heroHeight) {
          // Background moves slower (0.5x speed)
          if (parallaxBg) {
            parallaxBg.style.transform = `translateY(${scrolled * 0.5}px)`;
          }
          // Content moves faster (0.3x speed) for depth effect
          if (parallaxContent) {
            parallaxContent.style.transform = `translateY(${scrolled * 0.3}px)`;
            parallaxContent.style.opacity = `${1 - scrolled / heroHeight * 0.3}`;
          }
        }

        ticking = false;
      }

      function requestTick() {
        if (!ticking) {
          requestAnimationFrame(updateParallax);
          ticking = true;
        }
      }

      // Use passive listener for better performance
      window.addEventListener('scroll', requestTick, { passive: true });

      // Scroll to cards button - optimized
      const scrollBtn = document.getElementById('scroll-to-cards');
      const target = document.getElementById('data-viz-cards');
      if (scrollBtn && target) {
        scrollBtn.addEventListener('click', () => {
          target.scrollIntoView({ behavior: 'smooth' });
        }, { passive: true });
      }

      // Scroll-triggered animations using Intersection Observer
      const animatedCards = document.querySelectorAll('.scroll-fade-in');

      if (animatedCards.length > 0 && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const element = entry.target as HTMLElement;
              const index = parseInt(element.dataset.index || '0');
              // Stagger animation based on index
              setTimeout(() => {
                element.style.opacity = '1';
                element.style.transform = 'translateY(0)';
              }, index * 100);
              observer.unobserve(element);
            }
          });
        }, {
          threshold: 0.1,
          rootMargin: '0px 0px -50px 0px'
        });

        animatedCards.forEach((card) => {
          observer.observe(card);
        });
      } else {
        // Fallback: show all cards immediately if IntersectionObserver not supported
        animatedCards.forEach((card) => {
          (card as HTMLElement).style.opacity = '1';
          (card as HTMLElement).style.transform = 'translateY(0)';
        });
      }

      // Magnetic hover effects
      const magneticCards = document.querySelectorAll('.magnetic-card');
      const magneticStrength = 0.15;

      magneticCards.forEach((card) => {
        const cardElement = card as HTMLElement;
        let currentX = 0;
        let currentY = 0;
        let targetX = 0;
        let targetY = 0;
        let rafId: number | null = null;

        function animate() {
          currentX += (targetX - currentX) * 0.1;
          currentY += (targetY - currentY) * 0.1;

          cardElement.style.transform = `translate(${currentX}px, ${currentY}px)`;

          if (Math.abs(targetX - currentX) > 0.1 || Math.abs(targetY - currentY) > 0.1) {
            rafId = requestAnimationFrame(animate);
          } else {
            rafId = null;
          }
        }

        cardElement.addEventListener('mouseenter', () => {
          cardElement.style.transition = 'none';
        });

        cardElement.addEventListener('mouseleave', () => {
          targetX = 0;
          targetY = 0;
          cardElement.style.transition = 'transform 0.3s ease-out';
          if (rafId) {
            cancelAnimationFrame(rafId);
          }
          animate();
        });

        cardElement.addEventListener('mousemove', (e) => {
          const rect = cardElement.getBoundingClientRect();
          const centerX = rect.left + rect.width / 2;
          const centerY = rect.top + rect.height / 2;

          const deltaX = (e.clientX - centerX) * magneticStrength;
          const deltaY = (e.clientY - centerY) * magneticStrength;

          targetX = deltaX;
          targetY = deltaY;

          if (!rafId) {
            rafId = requestAnimationFrame(animate);
          }
        });
      });
    });
  </script>
</Layout> 