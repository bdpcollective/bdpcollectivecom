---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { baseUrl } from '../config';
import portfolioHero from '../../public/portfolio-hero.jpg';

const portfolioItems = [
  {
    title: "Health Journaling App",
    description: "Designed the HealthComms mobile app prototype to help cancer patients easily track symptoms during treatment—because better tracking means better care.",
    logo: `${baseUrl}/logos/healthcomms-logo.png`,
    slug: "healthcomms",
    heroImage: `${baseUrl}/portfolio/healthcomms/1a_healthcomms_promotion.png`,
    content: "Detailed content about HealthComms project..."
  },
  {
    title: "Vendor Portal",
    description: "NFM's Vendor Portal had the right resources, but it was in need of a clearer roadmap for vendors and more control for the internal team to keep everything on track!",
    logo: `${baseUrl}/logos/nfm-logo.png`,
    slug: "nfm",
    heroImage: `${baseUrl}/portfolio/nfm/1a_nfm_promotion.png`,
    content: "Detailed content about NFM project..."
  },
  {
    title: "Messaging Management System",
    description: "Shifting from old-school manual methods to a sleek digital app for managing product marketing messages.",
    logo: `${baseUrl}/logos/bestbuy-logo.png`,
    slug: "bestbuy",
    heroImage: `${baseUrl}/portfolio/bestbuy/1a_BestBuy_Promotion.png`,
    content: "Detailed content about Best Buy project..."
  },
  {
    title: "Inventory Management System",
    description: "Refresh of inventory screens to give functionality and a modern look. Built a pause feature, ensuring SKUs didn't go live until they reached every store preventing expensive shipping costs.",
    logo: `${baseUrl}/logos/gap-logo.png`,
    slug: "gap",
    heroImage: `${baseUrl}/portfolio/gap/1a_gap_promotion.png`,
    content: "Detailed content about Gallup project..."
  },
  {
    title: "Tablet App for Sales and Exchange",
    description: "Designed and prototyped a tablet app to enhance in-store sales support, improving efficiency and customer interactions.",
    logo: `${baseUrl}/logos/sleep-number-logo.png`,
    slug: "sleepnumber",
    heroImage: `${baseUrl}/portfolio/sleepnumber/1a_sleepnumber_promotion.png`,
    content: "Detailed content about SleepNumber project..."
  },
  {
    title: "Improved Checkout Workflow",
    description: "Teamed up with DMF to revamp their Giving Hearts search and donation workflow making it easier, friendlier, and more powerful for donors and fundraisers alike!",
    logo: `${baseUrl}/logos/dmf-logo2.png`,
    slug: "dakota-medical-foundation",
    heroImage: `${baseUrl}/portfolio/dmf/1a_dmf_promotion.png`,
    content: "Detailed content about Dakota Medical Foundation project..."
  }
];
---

<Layout title="UX Portfolio">
  <Fragment slot="head">
    <link rel="preload" as="image" href={portfolioHero.src} fetchpriority="high" type="image/jpeg" />
  </Fragment>

  <div class="overflow-x-hidden w-full max-w-full">
    {/* Page header */}
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 md:pt-20 pb-12 md:pb-16">
      <div class="flex items-center justify-between gap-4 pb-4 border-b border-ink/15 eyebrow text-ink/60">
        <span>§ UX Portfolio</span>
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-marker"></span>
          {String(portfolioItems.length).padStart(2, '0')} projects
        </span>
      </div>
      <h1 class="display-xl mt-10 md:mt-14 animate-reveal">UX <span class="accent-bar">Portfolio</span></h1>
      <p class="mt-8 max-w-xl text-lg md:text-xl text-ink/75 animate-reveal-delay">
        Recent work and projects.
      </p>
    </section>

    {/* Hero image with parallax */}
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <figure class="relative h-[40vh] md:h-[50vh] overflow-hidden parallax-bg">
        <Image
          src={portfolioHero}
          alt="UX Portfolio hero background"
          loading="eager"
          fetchpriority="high"
          quality={75}
          format="webp"
          widths={[640, 750, 828, 1080, 1200, 1920, 2048]}
          sizes="(max-width: 1280px) 100vw, 1216px"
          class="absolute inset-x-0 -top-[15%] w-full h-[130%] object-cover parallax-image"
        />
      </figure>
    </section>

    {/* Portfolio Grid */}
    <section id="portfolio-cards" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
      <div class="flex items-end justify-between gap-6 pb-6 mb-12 border-b border-ink">
        <div>
          <p class="eyebrow text-ink/60 mb-4">§ Index — Selected Work</p>
          <h2 class="display-lg">Recent work.</h2>
        </div>
        <p class="eyebrow text-ink/60 text-right">{String(portfolioItems.length).padStart(2, '0')} case studies</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-16">
        {portfolioItems.map((item, index) => (
          <a
            href={`${baseUrl}/portfolio/${item.slug}`}
            class="group grid grid-rows-subgrid row-span-3 gap-y-0 scroll-fade-in magnetic-card"
            data-index={index}
            style="opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease-out, transform 0.6s ease-out;"
          >
            <div class="relative h-64 md:h-72 bg-white border border-ink/10 flex items-center justify-center p-12">
              <img
                src={item.logo}
                alt={`${item.title} logo`}
                width="144"
                height="144"
                loading="lazy"
                class="object-contain max-h-full transition-transform duration-300 group-hover:scale-105"
              />
              <span class="chip absolute top-4 left-4 bg-paper text-ink">N° {String(index + 1).padStart(2, '0')}</span>
            </div>
            <div class="mt-5 flex items-end justify-between gap-4 pb-3 border-b border-ink">
              <h3 class="text-2xl md:text-3xl font-bold tracking-tight transition-colors group-hover:text-accent">{item.title}</h3>
              <span class="text-xl" aria-hidden="true">↗</span>
            </div>
            <p class="mt-3 text-ink/70 leading-relaxed">{item.description}</p>
          </a>
        ))}
      </div>
    </section>
  </div>

  <style>
    .parallax-bg {
      will-change: transform;
    }
    .parallax-image {
      transform: translateY(0);
      will-change: transform;
    }

    .animate-reveal {
      opacity: 0;
      transform: translateY(30px);
      animation: reveal-text 1s ease-out 0.3s forwards;
    }

    .animate-reveal-delay {
      opacity: 0;
      transform: translateY(20px);
      animation: reveal-text 1s ease-out 0.8s forwards;
    }

    @keyframes reveal-text {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <script>
    document.addEventListener('astro:page-load', () => {
      // Parallax scrolling effect - optimized with requestAnimationFrame
      let ticking = false;
      const parallaxBg = document.querySelector('.parallax-image') as HTMLElement;

      function updateParallax() {
        const scrolled = window.pageYOffset;
        const heroHeight = window.innerHeight * 0.5; // 50vh

        // Only apply parallax within hero section; the image is 130% of its
        // frame, so 0.15x keeps it from sliding past the frame edge
        if (scrolled < heroHeight && parallaxBg) {
          parallaxBg.style.transform = `translateY(${scrolled * 0.15}px)`;
        }

        ticking = false;
      }

      function requestTick() {
        if (!ticking) {
          requestAnimationFrame(updateParallax);
          ticking = true;
        }
      }

      // Use passive listener for better performance
      window.addEventListener('scroll', requestTick, { passive: true });

      // Scroll-triggered animations using Intersection Observer
      const animatedCards = document.querySelectorAll('.scroll-fade-in');

      if (animatedCards.length > 0 && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const element = entry.target as HTMLElement;
              const index = parseInt(element.dataset.index || '0');
              setTimeout(() => {
                element.style.opacity = '1';
                element.style.transform = 'translateY(0)';
              }, index * 100);
              observer.unobserve(element);
            }
          });
        }, {
          threshold: 0.1,
          rootMargin: '0px 0px -50px 0px'
        });

        animatedCards.forEach((card) => {
          observer.observe(card);
        });
      } else {
        animatedCards.forEach((card) => {
          (card as HTMLElement).style.opacity = '1';
          (card as HTMLElement).style.transform = 'translateY(0)';
        });
      }

      // Magnetic hover effects
      const magneticCards = document.querySelectorAll('.magnetic-card');
      const magneticStrength = 0.15;

      magneticCards.forEach((card) => {
        const cardElement = card as HTMLElement;
        let currentX = 0;
        let currentY = 0;
        let targetX = 0;
        let targetY = 0;
        let rafId: number | null = null;

        function animate() {
          currentX += (targetX - currentX) * 0.1;
          currentY += (targetY - currentY) * 0.1;

          cardElement.style.transform = `translate(${currentX}px, ${currentY}px)`;

          if (Math.abs(targetX - currentX) > 0.1 || Math.abs(targetY - currentY) > 0.1) {
            rafId = requestAnimationFrame(animate);
          } else {
            rafId = null;
          }
        }

        cardElement.addEventListener('mouseenter', () => {
          cardElement.style.transition = 'none';
        });

        cardElement.addEventListener('mouseleave', () => {
          targetX = 0;
          targetY = 0;
          cardElement.style.transition = 'transform 0.3s ease-out';
          if (rafId) {
            cancelAnimationFrame(rafId);
          }
          animate();
        });

        cardElement.addEventListener('mousemove', (e) => {
          const rect = cardElement.getBoundingClientRect();
          const centerX = rect.left + rect.width / 2;
          const centerY = rect.top + rect.height / 2;

          const deltaX = (e.clientX - centerX) * magneticStrength;
          const deltaY = (e.clientY - centerY) * magneticStrength;

          targetX = deltaX;
          targetY = deltaY;

          if (!rafId) {
            rafId = requestAnimationFrame(animate);
          }
        });
      });
    });
  </script>
</Layout> 