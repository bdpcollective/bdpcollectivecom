---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { baseUrl } from '../config';

const portfolioItems = [
  {
    title: "Health Journaling App",
    description: "Designed the HealthComms mobile app prototype to help cancer patients easily track symptoms during treatment—because better tracking means better care.",
    logo: `${baseUrl}/logos/healthcomms-logo.png`,
    slug: "healthcomms",
    heroImage: `${baseUrl}/portfolio/healthcomms/1a_healthcomms_promotion.png`,
    content: "Detailed content about HealthComms project..."
  },
  {
    title: "Vendor Portal",
    description: "NFM's Vendor Portal had the right resources, but it was in need of a clearer roadmap for vendors and more control for the internal team to keep everything on track!",
    logo: `${baseUrl}/logos/nfm-logo.png`,
    slug: "nfm",
    heroImage: `${baseUrl}/portfolio/nfm/1a_nfm_promotion.png`,
    content: "Detailed content about NFM project..."
  },
  {
    title: "Messaging Management System",
    description: "Shifting from old-school manual methods to a sleek digital app for managing product marketing messages.",
    logo: `${baseUrl}/logos/bestbuy-logo.png`,
    slug: "bestbuy",
    heroImage: `${baseUrl}/portfolio/bestbuy/1a_BestBuy_Promotion.png`,
    content: "Detailed content about Best Buy project..."
  },
  {
    title: "Inventory Management System",
    description: "Refresh of inventory screens to give functionality and a modern look. Built a pause feature, ensuring SKUs didn't go live until they reached every store preventing expensive shipping costs.",
    logo: `${baseUrl}/logos/gap-logo.png`,
    slug: "gap",
    heroImage: `${baseUrl}/portfolio/gap/1a_gap_promotion.png`,
    content: "Detailed content about Gallup project..."
  },
  {
    title: "Tablet App for Sales and Exchange",
    description: "Designed and prototyped a tablet app to enhance in-store sales support, improving efficiency and customer interactions.",
    logo: `${baseUrl}/logos/sleep-number-logo.png`,
    slug: "sleepnumber",
    heroImage: `${baseUrl}/portfolio/sleepnumber/1a_sleepnumber_promotion.png`,
    content: "Detailed content about SleepNumber project..."
  },
  {
    title: "Improved Checkout Workflow",
    description: "Teamed up with DMF to revamp their Giving Hearts search and donation workflow making it easier, friendlier, and more powerful for donors and fundraisers alike!",
    logo: `${baseUrl}/logos/dmf-logo2.png`,
    slug: "dakota-medical-foundation",
    heroImage: `${baseUrl}/portfolio/dmf/1a_dmf_promotion.png`,
    content: "Detailed content about Dakota Medical Foundation project..."
  }
];
---

<Layout title="UX Portfolio">
  <main>
    {/* Hero Section */}
    <section class="relative h-[50vh]">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <img
          src={`${baseUrl}/portfolio-hero.jpg`}
          alt="UX Portfolio hero background"
          class="w-full h-full object-cover brightness-50"
        />
      </div>

      {/* Hero Content */}
      <div class="relative z-10 flex flex-col items-center h-full">
        <div class="flex-1 flex items-center">
          <div class="text-center px-4">
            <h1 class="text-4xl md:text-6xl font-bold mb-6 text-white">
              UX Portfolio
            </h1>
            <p class="text-lg md:text-xl text-gray-200 mb-8 max-w-2xl mx-auto">
              Recent work and projects.
            </p>
          </div>
        </div>
        
        {/* Chevron */}
        <button
          id="scroll-to-portfolio"
          class="animate-bounce p-2 rounded-full bg-white/10 hover:bg-white/20 transition-colors mb-8"
          aria-label="Scroll to portfolio categories"
        >
          <svg
            class="w-8 h-8 text-white"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </button>
      </div>
    </section>

    {/* Portfolio Grid */}
    <section id="portfolio-cards" class="container mx-auto px-4 py-20">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {portfolioItems.map((item) => (
          <a 
            href={`${baseUrl}/portfolio/${item.slug}`}
            class="p-6 rounded-xl bg-white shadow-lg hover:shadow-xl transition-shadow block"
          >
            <div class="relative w-36 h-36 flex items-center justify-center mb-4 mx-auto">
              <img
                src={item.logo}
                alt={`${item.title} logo`}
                width="144"
                height="144"
                class="object-contain mx-auto"
                loading="lazy"
              />
            </div>
            <h3 class="text-xl font-semibold mb-2">{item.title}</h3>
            <p class="text-gray-600">{item.description}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <script>
    // Scroll to portfolio button - optimized
    const scrollBtn = document.getElementById('scroll-to-portfolio');
    const target = document.getElementById('portfolio-cards');
    if (scrollBtn && target) {
      scrollBtn.addEventListener('click', () => {
        target.scrollIntoView({ behavior: 'smooth' });
      }, { passive: true });
    }
  </script>
</Layout> 