---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { baseUrl } from '../config';
import portfolioHero from '../../public/portfolio-hero.jpg';

const portfolioItems = [
  {
    title: "Health Journaling App",
    description: "Designed the HealthComms mobile app prototype to help cancer patients easily track symptoms during treatment—because better tracking means better care.",
    logo: `${baseUrl}/logos/healthcomms-logo.png`,
    slug: "healthcomms",
    heroImage: `${baseUrl}/portfolio/healthcomms/1a_healthcomms_promotion.png`,
    content: "Detailed content about HealthComms project..."
  },
  {
    title: "Vendor Portal",
    description: "NFM's Vendor Portal had the right resources, but it was in need of a clearer roadmap for vendors and more control for the internal team to keep everything on track!",
    logo: `${baseUrl}/logos/nfm-logo.png`,
    slug: "nfm",
    heroImage: `${baseUrl}/portfolio/nfm/1a_nfm_promotion.png`,
    content: "Detailed content about NFM project..."
  },
  {
    title: "Messaging Management System",
    description: "Shifting from old-school manual methods to a sleek digital app for managing product marketing messages.",
    logo: `${baseUrl}/logos/bestbuy-logo.png`,
    slug: "bestbuy",
    heroImage: `${baseUrl}/portfolio/bestbuy/1a_BestBuy_Promotion.png`,
    content: "Detailed content about Best Buy project..."
  },
  {
    title: "Inventory Management System",
    description: "Refresh of inventory screens to give functionality and a modern look. Built a pause feature, ensuring SKUs didn't go live until they reached every store preventing expensive shipping costs.",
    logo: `${baseUrl}/logos/gap-logo.png`,
    slug: "gap",
    heroImage: `${baseUrl}/portfolio/gap/1a_gap_promotion.png`,
    content: "Detailed content about Gallup project..."
  },
  {
    title: "Tablet App for Sales and Exchange",
    description: "Designed and prototyped a tablet app to enhance in-store sales support, improving efficiency and customer interactions.",
    logo: `${baseUrl}/logos/sleep-number-logo.png`,
    slug: "sleepnumber",
    heroImage: `${baseUrl}/portfolio/sleepnumber/1a_sleepnumber_promotion.png`,
    content: "Detailed content about SleepNumber project..."
  },
  {
    title: "Improved Checkout Workflow",
    description: "Teamed up with DMF to revamp their Giving Hearts search and donation workflow making it easier, friendlier, and more powerful for donors and fundraisers alike!",
    logo: `${baseUrl}/logos/dmf-logo2.png`,
    slug: "dakota-medical-foundation",
    heroImage: `${baseUrl}/portfolio/dmf/1a_dmf_promotion.png`,
    content: "Detailed content about Dakota Medical Foundation project..."
  }
];
---

<Layout title="UX Portfolio">
  <Fragment slot="head">
    <link rel="preload" as="image" href={portfolioHero.src} fetchpriority="high" type="image/jpeg" />
  </Fragment>

  <main class="color-transition-container overflow-x-hidden w-full max-w-full">
    {/* Hero Section with Parallax */}
    <section class="relative h-[50vh] overflow-hidden">
      {/* Background Image with Parallax */}
      <div class="absolute inset-0 z-0 parallax-bg">
        <Image
          src={portfolioHero}
          alt="UX Portfolio hero background"
          loading="eager"
          fetchpriority="high"
          quality={75}
          format="webp"
          widths={[640, 750, 828, 1080, 1200, 1920, 2048]}
          sizes="(max-width: 640px) 640px, (max-width: 750px) 750px, (max-width: 828px) 828px, (max-width: 1080px) 1080px, (max-width: 1200px) 1200px, (max-width: 1920px) 1920px, 2048px"
          class="w-full h-full object-cover brightness-50 parallax-image"
        />
      </div>

      {/* Hero Content with Parallax */}
      <div class="relative z-10 flex flex-col items-center h-full parallax-content">
        <div class="flex-1 flex items-center">
          <div class="text-center px-4">
            <h1 class="text-4xl md:text-6xl font-bold mb-6 text-white creative-typography">
              <span class="gradient-text animate-reveal">UX Portfolio</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-200 mb-8 max-w-2xl mx-auto animate-reveal-delay">
              Recent work and projects.
            </p>
          </div>
        </div>
        
        {/* Chevron */}
        <button
          id="scroll-to-portfolio"
          class="animate-bounce p-2 rounded-full bg-white/10 hover:bg-white/20 transition-colors mb-8"
          aria-label="Scroll to portfolio categories"
        >
          <svg
            class="w-8 h-8 text-white"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </button>
      </div>
    </section>

    {/* Portfolio Grid */}
    <section id="portfolio-cards" class="container mx-auto px-4 py-20">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {portfolioItems.map((item, index) => (
          <a
            href={`${baseUrl}/portfolio/${item.slug}`}
            class="group h-full scroll-fade-in magnetic-card"
            data-index={index}
            style="opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease-out, transform 0.6s ease-out;"
          >
            <div class="relative overflow-hidden rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-all hover:shadow-md h-full flex flex-col">
              <div class="h-36 mb-4 flex items-center justify-center">
                <img
                  src={item.logo}
                  alt={`${item.title} logo`}
                  width="144"
                  height="144"
                  loading="lazy"
                  class="object-contain max-h-full transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <h3 class="mb-2 text-xl font-semibold text-gray-900">{item.title}</h3>
              <p class="text-gray-700">{item.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <style>
    .parallax-bg {
      will-change: transform;
    }
    .parallax-image {
      transform: translateY(0);
      will-change: transform;
    }
    .parallax-content {
      will-change: transform;
    }

    /* Creative Typography Styles */
    .gradient-text {
      background: linear-gradient(135deg, #ffffff 0%, #e0e7ff 50%, #c7d2fe 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      background-size: 200% 200%;
      animation: gradient-shift 3s ease infinite;
    }

    @keyframes gradient-shift {
      0%, 100% {
        background-position: 0% 50%;
      }
      50% {
        background-position: 100% 50%;
      }
    }

    .animate-reveal {
      opacity: 0;
      transform: translateY(30px);
      animation: reveal-text 1s ease-out 0.3s forwards;
    }

    .animate-reveal-delay {
      opacity: 0;
      transform: translateY(20px);
      animation: reveal-text 1s ease-out 0.8s forwards;
    }

    @keyframes reveal-text {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .creative-typography {
      letter-spacing: -0.02em;
    }

    /* Color Transitions on Scroll */
    .color-transition-container {
      background: linear-gradient(180deg, #f6f6f6 0%, #ffffff 50%, #f0f9ff 100%);
      background-size: 100% 300%;
      background-position: 0% 0%;
      transition: background-position 0.1s ease-out;
      min-height: 100vh;
    }

  </style>

  <script>
    // Parallax scrolling effect - optimized with requestAnimationFrame
    let ticking = false;
    const parallaxBg = document.querySelector('.parallax-image') as HTMLElement;
    const parallaxContent = document.querySelector('.parallax-content') as HTMLElement;

    function updateParallax() {
      const scrolled = window.pageYOffset;
      const heroHeight = window.innerHeight * 0.5; // 50vh
      
      // Only apply parallax within hero section
      if (scrolled < heroHeight) {
        // Background moves slower (0.5x speed)
        if (parallaxBg) {
          parallaxBg.style.transform = `translateY(${scrolled * 0.5}px)`;
        }
        // Content moves faster (0.3x speed) for depth effect
        if (parallaxContent) {
          parallaxContent.style.transform = `translateY(${scrolled * 0.3}px)`;
          parallaxContent.style.opacity = `${1 - scrolled / heroHeight * 0.3}`;
        }
      }
      
      ticking = false;
    }

    function requestTick() {
      if (!ticking) {
        requestAnimationFrame(updateParallax);
        ticking = true;
      }
    }

    // Use passive listener for better performance
    window.addEventListener('scroll', requestTick, { passive: true });

    // Scroll to portfolio button - optimized
    const scrollBtn = document.getElementById('scroll-to-portfolio');
    const target = document.getElementById('portfolio-cards');
    if (scrollBtn && target) {
      scrollBtn.addEventListener('click', () => {
        target.scrollIntoView({ behavior: 'smooth' });
      }, { passive: true });
    }

    // Scroll-triggered animations using Intersection Observer
    const animatedCards = document.querySelectorAll('.scroll-fade-in');
    
    if (animatedCards.length > 0 && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const element = entry.target as HTMLElement;
            const index = parseInt(element.dataset.index || '0');
            // Stagger animation based on index
            setTimeout(() => {
              element.style.opacity = '1';
              element.style.transform = 'translateY(0)';
            }, index * 100);
            observer.unobserve(element);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      });

      animatedCards.forEach((card) => {
        observer.observe(card);
      });
    } else {
      // Fallback: show all cards immediately if IntersectionObserver not supported
      animatedCards.forEach((card) => {
        (card as HTMLElement).style.opacity = '1';
        (card as HTMLElement).style.transform = 'translateY(0)';
      });
    }

    // Magnetic hover effects
    const magneticCards = document.querySelectorAll('.magnetic-card');
    const magneticStrength = 0.15; // How much the card follows the cursor (0-1)

    magneticCards.forEach((card) => {
      const cardElement = card as HTMLElement;
      let currentX = 0;
      let currentY = 0;
      let targetX = 0;
      let targetY = 0;
      let rafId: number | null = null;

      function animate() {
        // Smooth interpolation
        currentX += (targetX - currentX) * 0.1;
        currentY += (targetY - currentY) * 0.1;

        cardElement.style.transform = `translate(${currentX}px, ${currentY}px)`;

        if (Math.abs(targetX - currentX) > 0.1 || Math.abs(targetY - currentY) > 0.1) {
          rafId = requestAnimationFrame(animate);
        } else {
          rafId = null;
        }
      }

      cardElement.addEventListener('mouseenter', () => {
        cardElement.style.transition = 'none';
      });

      cardElement.addEventListener('mouseleave', () => {
        targetX = 0;
        targetY = 0;
        cardElement.style.transition = 'transform 0.3s ease-out';
        if (rafId) {
          cancelAnimationFrame(rafId);
        }
        animate();
      });

      cardElement.addEventListener('mousemove', (e) => {
        const rect = cardElement.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;

        const deltaX = (e.clientX - centerX) * magneticStrength;
        const deltaY = (e.clientY - centerY) * magneticStrength;

        targetX = deltaX;
        targetY = deltaY;

        if (!rafId) {
          rafId = requestAnimationFrame(animate);
        }
      });
    });

    // Color transitions on scroll
    const colorContainer = document.querySelector('.color-transition-container') as HTMLElement;
    if (colorContainer) {
      let ticking = false;
      
      function updateColorTransition() {
        const scrolled = window.pageYOffset;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const scrollPercent = Math.min(scrolled / maxScroll, 1);
        
        // Move background gradient based on scroll
        const bgPosition = scrollPercent * 200; // 0-200% range
        colorContainer.style.backgroundPosition = `0% ${bgPosition}%`;
        
        ticking = false;
      }

      function requestColorTick() {
        if (!ticking) {
          requestAnimationFrame(updateColorTransition);
          ticking = true;
        }
      }

      window.addEventListener('scroll', requestColorTick, { passive: true });
      updateColorTransition(); // Initial call
    }

  </script>
</Layout> 