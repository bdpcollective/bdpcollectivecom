---
import Layout from '../layouts/Layout.astro';
import { baseUrl } from '../config';

const appItems = [
  {
    title: "Lacrosse Rules Explained",
    description: "Animated diagrams explaining the basics of men's lacrosse.",
    image: "/lax_svgs/01-field-and-positions.svg",
    slug: "lacrosse-rules"
  },
  {
    title: "Nebraska Basketball- Results by Year",
    description: "Season-by-season results, stats, and trends since 1949.",
    image: "/nebraska-basketball-alltime.png",
    slug: "nebraska-basketball-alltime-stats"
  },
  {
    title: "Cinderella Scout",
    description: "Find mid-majors with March Madness upset potential.",
    image: "/cinderella-scout.png",
    slug: "cinderella-scout"
  },
  {
    title: "2025 Nebraska Basketball Stat Comparison",
    description: "Live stats and schedule for Husker basketball.",
    image: "/nebraskabasketball.jpg",
    slug: "nebraska-basketball"
  },
  {
    title: "Will there be fog?",
    description: "A simple app to check fog conditions.",
    image: "/fog.jpg",
    slug: "will-there-be-fog"
  }
];

const dataVizItems = [
  {
    title: "Poverty Levels",
    description: "Interactive map showing poverty rates across US counties",
    image: "/images/poverty/poverty-map.png",
    url: "/data-visualization/poverty-levels/index.html"
  },
  {
    title: "Basketball Trees",
    description: "Interactive visualization of basketball team clustering",
    image: "/images/ncaa/ncaa-tree.png",
    url: "/data-visualization/basketball-tree/index.html"
  }
];

const sections = [
  {
    label: "§ Index — Apps",
    title: "Web applications.",
    items: appItems.map((item) => ({ ...item, href: `${baseUrl}/apps/${item.slug}` }))
  },
  {
    label: "§ Index — Data Visualization",
    title: "Data visualization.",
    items: dataVizItems.map((item) => ({ ...item, href: `${baseUrl}${item.url}` }))
  }
];
const totalItems = appItems.length + dataVizItems.length;
---

<Layout title="Apps">
  <div class="w-full max-w-full overflow-x-hidden">
    {/* Page header */}
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 md:pt-20 pb-12 md:pb-16">
      <div class="flex items-center justify-between gap-4 pb-4 border-b border-ink/15 eyebrow text-ink/60">
        <span>§ Apps</span>
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-marker"></span>
          {String(totalItems).padStart(2, '0')} projects
        </span>
      </div>
      <h1 class="display-xl mt-10 md:mt-14"><span class="accent-bar">Apps</span></h1>
      <p class="mt-8 max-w-xl text-lg md:text-xl text-ink/75">
        Web applications and interactive tools.
      </p>
    </section>

    {/* Hero image */}
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <figure class="relative h-[40vh] md:h-[50vh] overflow-hidden">
        <img
          src="/data-viz-hero.jpg"
          alt="Apps hero"
          class="w-full h-full object-cover"
        />
      </figure>
    </section>

    {/* Apps Grid */}
    <div id="app-cards">
      {sections.map((section, sectionIndex) => (
        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
          <div class="flex items-end justify-between gap-6 pb-6 mb-12 border-b border-ink">
            <div>
              <p class="eyebrow text-ink/60 mb-4">{section.label}</p>
              <h2 class="display-lg">{section.title}</h2>
            </div>
            <p class="eyebrow text-ink/60 text-right">{String(section.items.length).padStart(2, '0')} projects</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-16">
            {section.items.map((item, index) => {
              const number = (sectionIndex === 0 ? 0 : appItems.length) + index + 1;
              return (
                <a
                  href={item.href}
                  class="group grid grid-rows-subgrid row-span-3 gap-y-0 scroll-fade-in magnetic-card"
                  data-index={index}
                  style="opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease-out, transform 0.6s ease-out;"
                >
                  <div class="relative h-64 md:h-80 overflow-hidden bg-white border border-ink/10">
                    <img
                      src={item.image}
                      alt={item.title}
                      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                      loading="lazy"
                    />
                    <span class="chip absolute top-4 left-4 bg-paper text-ink">N° {String(number).padStart(2, '0')}</span>
                  </div>
                  <div class="mt-5 flex items-end justify-between gap-4 pb-3 border-b border-ink">
                    <h3 class="text-2xl md:text-3xl font-bold tracking-tight transition-colors group-hover:text-accent">{item.title}</h3>
                    <span class="text-xl" aria-hidden="true">↗</span>
                  </div>
                  <p class="mt-3 text-ink/70 leading-relaxed">{item.description}</p>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      // Scroll-triggered animations using Intersection Observer
      const animatedCards = document.querySelectorAll('.scroll-fade-in');

      if (animatedCards.length > 0 && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const element = entry.target as HTMLElement;
              const index = parseInt(element.dataset.index || '0');
              setTimeout(() => {
                element.style.opacity = '1';
                element.style.transform = 'translateY(0)';
              }, index * 100);
              observer.unobserve(element);
            }
          });
        }, {
          threshold: 0.1,
          rootMargin: '0px 0px -50px 0px'
        });

        animatedCards.forEach((card) => {
          observer.observe(card);
        });
      } else {
        animatedCards.forEach((card) => {
          (card as HTMLElement).style.opacity = '1';
          (card as HTMLElement).style.transform = 'translateY(0)';
        });
      }

      // Magnetic hover effects
      const magneticCards = document.querySelectorAll('.magnetic-card');
      const magneticStrength = 0.15;

      magneticCards.forEach((card) => {
        const cardElement = card as HTMLElement;
        let currentX = 0;
        let currentY = 0;
        let targetX = 0;
        let targetY = 0;
        let rafId: number | null = null;

        function animate() {
          currentX += (targetX - currentX) * 0.1;
          currentY += (targetY - currentY) * 0.1;

          cardElement.style.transform = `translate(${currentX}px, ${currentY}px)`;

          if (Math.abs(targetX - currentX) > 0.1 || Math.abs(targetY - currentY) > 0.1) {
            rafId = requestAnimationFrame(animate);
          } else {
            rafId = null;
          }
        }

        cardElement.addEventListener('mouseenter', () => {
          cardElement.style.transition = 'none';
        });

        cardElement.addEventListener('mouseleave', () => {
          targetX = 0;
          targetY = 0;
          cardElement.style.transition = 'transform 0.3s ease-out';
          if (rafId) {
            cancelAnimationFrame(rafId);
          }
          animate();
        });

        cardElement.addEventListener('mousemove', (e) => {
          const rect = cardElement.getBoundingClientRect();
          const centerX = rect.left + rect.width / 2;
          const centerY = rect.top + rect.height / 2;

          const deltaX = (e.clientX - centerX) * magneticStrength;
          const deltaY = (e.clientY - centerY) * magneticStrength;

          targetX = deltaX;
          targetY = deltaY;

          if (!rafId) {
            rafId = requestAnimationFrame(animate);
          }
        });
      });
    });
  </script>
</Layout>
