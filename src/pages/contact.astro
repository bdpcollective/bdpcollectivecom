---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - BDP Collective">
  <main class="container mx-auto px-4 py-16 max-w-4xl">
    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <h1 class="text-4xl font-bold mb-4">Let's chat.</h1>
        <h2 class="text-2xl font-bold mb-6">Tell me about your project.</h2>
        <p class="text-gray-600 mb-6">Let's create something together ✨</p>
      </div>

      <div class="bg-white rounded-lg p-8 shadow-sm">
        <h3 class="text-xl mb-6 font-semibold">Send us a message 📬</h3>
        <form class="space-y-4">
          <div>
            <input 
              type="text" 
              placeholder="Full name*" 
              class="w-full px-4 py-2 rounded-md border border-gray-200 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition"
              required
            />
          </div>
          <div>
            <input 
              type="email" 
              placeholder="Email address*" 
              class="w-full px-4 py-2 rounded-md border border-gray-200 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition"
              required
            />
          </div>
          <div>
            <input 
              type="text" 
              placeholder="Subject" 
              class="w-full px-4 py-2 rounded-md border border-gray-200 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition"
            />
          </div>
          <div>
            <textarea 
              placeholder="Tell us more about your project*" 
              rows="4" 
              class="w-full px-4 py-2 rounded-md border border-gray-200 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition"
              required
            ></textarea>
          </div>
          <button 
            type="submit" 
            class="w-full bg-black text-white py-2 px-6 rounded-md hover:bg-gray-800 transition duration-200"
          >
            Send message
          </button>
        </form>
      </div>
    </div>
  </main>
</Layout> 