---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Nebraska Basketball- Results by Year - Apps">
  <main>
    <section class="container mx-auto px-4 py-12">
      <div class="max-w-7xl mx-auto space-y-8">
        <!-- Back Button -->
        <a
          href="/apps"
          class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors"
        >
          <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Apps
        </a>

        <!-- Header -->
        <div class="text-center">
          <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Nebraska Basketball- Results by Year</h1>
          <p class="text-gray-600">Season-by-season results and stats since 1949-50.</p>
        </div>

        <!-- Loading State -->
        <div id="loading" class="text-center py-12">
          <div class="inline-block animate-spin rounded-full h-12 w-12 border-4 border-gray-300 border-t-red-700"></div>
          <p class="mt-4 text-gray-600">Loading results...</p>
        </div>

        <!-- Content Container (hidden until data loads) -->
        <div id="content" class="hidden space-y-8">

          <!-- Chart Section -->
          <div class="bg-white rounded-xl shadow-lg p-6">
            <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
              <h2 class="text-2xl font-bold text-gray-900">Stats by Year</h2>
              <select id="chart-stat" class="px-4 py-2 border border-gray-300 rounded-lg bg-white focus:ring-2 focus:ring-red-500 focus:border-transparent outline-none cursor-pointer">
                <option value="wins">Wins</option>
                <option value="losses">Losses</option>
                <option value="winPct">Win %</option>
                <option value="psG">Points Scored / Game</option>
                <option value="paG">Points Against / Game</option>
                <option value="srs">SRS (Simple Rating System)</option>
                <option value="sos">SOS (Strength of Schedule)</option>
                <option value="oRtg">Offensive Rating</option>
                <option value="dRtg">Defensive Rating</option>
              </select>
            </div>
            <div class="relative" style="height: 400px;">
              <canvas id="stats-chart"></canvas>
            </div>
          </div>

          <!-- Season Summary Table -->
          <div class="bg-white rounded-xl shadow-lg p-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Season Results</h2>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm" id="season-table">
                <thead>
                  <tr class="border-b-2 border-red-200 bg-red-50">
                    <th class="py-3 px-3 font-semibold text-gray-700 cursor-pointer hover:bg-red-100 transition-colors sortable" data-sort="year">
                      <div class="flex items-center gap-1">Year <span class="sort-arrow"></span></div>
                    </th>
                    <th class="py-3 px-3 font-semibold text-gray-700 cursor-pointer hover:bg-red-100 transition-colors sortable" data-sort="coach">
                      <div class="flex items-center gap-1">Coach <span class="sort-arrow"></span></div>
                    </th>
                    <th class="py-3 px-3 font-semibold text-gray-700 cursor-pointer hover:bg-red-100 transition-colors sortable text-right" data-sort="wins">
                      <div class="flex items-center justify-end gap-1">W <span class="sort-arrow"></span></div>
                    </th>
                    <th class="py-3 px-3 font-semibold text-gray-700 cursor-pointer hover:bg-red-100 transition-colors sortable text-right" data-sort="losses">
                      <div class="flex items-center justify-end gap-1">L <span class="sort-arrow"></span></div>
                    </th>
                    <th class="py-3 px-3 font-semibold text-gray-700 cursor-pointer hover:bg-red-100 transition-colors sortable text-right" data-sort="winPct">
                      <div class="flex items-center justify-end gap-1">Win% <span class="sort-arrow"></span></div>
                    </th>
                    <th class="py-3 px-3 font-semibold text-gray-700 cursor-pointer hover:bg-red-100 transition-colors sortable text-right" data-sort="psG">
                      <div class="flex items-center justify-end gap-1">Pts/G <span class="sort-arrow"></span></div>
                    </th>
                    <th class="py-3 px-3 font-semibold text-gray-700 cursor-pointer hover:bg-red-100 transition-colors sortable text-right" data-sort="paG">
                      <div class="flex items-center justify-end gap-1">Opp/G <span class="sort-arrow"></span></div>
                    </th>
                    <th class="py-3 px-3 font-semibold text-gray-700 cursor-pointer hover:bg-red-100 transition-colors sortable text-right" data-sort="srs">
                      <div class="flex items-center justify-end gap-1">SRS <span class="sort-arrow"></span></div>
                    </th>
                    <th class="py-3 px-3 font-semibold text-gray-700 cursor-pointer hover:bg-red-100 transition-colors sortable text-right" data-sort="sos">
                      <div class="flex items-center justify-end gap-1">SOS <span class="sort-arrow"></span></div>
                    </th>
                    <th class="py-3 px-3 font-semibold text-gray-700 cursor-pointer hover:bg-red-100 transition-colors sortable text-right" data-sort="oRtg">
                      <div class="flex items-center justify-end gap-1">ORtg <span class="sort-arrow"></span></div>
                    </th>
                    <th class="py-3 px-3 font-semibold text-gray-700 cursor-pointer hover:bg-red-100 transition-colors sortable text-right" data-sort="dRtg">
                      <div class="flex items-center justify-end gap-1">DRtg <span class="sort-arrow"></span></div>
                    </th>
                    <th class="py-3 px-3 w-8"></th>
                  </tr>
                </thead>
                <tbody id="season-table-body">
                </tbody>
              </table>
            </div>
          </div>

        </div>

        <!-- Data Source -->
        <p id="data-source" class="hidden text-center text-sm text-gray-500 mt-8">
          Data from Sports Reference.
        </p>
      </div>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    document.addEventListener('astro:page-load', () => {
      const CSV_URL = '/data/nebraskabasketballstats/Nebraska Basketball Stats - Results.csv';

      const loading = document.getElementById('loading');
      const content = document.getElementById('content');
      const dataSource = document.getElementById('data-source');

      interface SeasonData {
        year: string;
        wins: number;
        losses: number;
        coach: string;
        psG: number;
        paG: number;
        srs: number;
        sos: number;
        oRtg: number;
        dRtg: number;
        winPct: number;
        games: GameData[];
      }

      interface GameData {
        gameNum: number;
        date: string;
        type: string;
        location: string;
        opponent: string;
        conf: string;
        teamScore: number;
        oppScore: number;
        result: string;
        ot: string;
        wins: number;
        losses: number;
        streak: string;
        arena: string;
      }

      let seasons: SeasonData[] = [];
      let currentSort = { column: 'year', direction: 'desc' as 'asc' | 'desc' };
      let expandedYear: string | null = null;
      let chartInstance: any = null;

      function parseCSV(text: string): string[][] {
        const rows: string[][] = [];
        let current = '';
        let inQuotes = false;
        let row: string[] = [];

        for (let i = 0; i < text.length; i++) {
          const char = text[i];
          if (char === '"') {
            inQuotes = !inQuotes;
          } else if (char === ',' && !inQuotes) {
            row.push(current.trim());
            current = '';
          } else if ((char === '\n' || char === '\r') && !inQuotes) {
            if (char === '\r' && text[i + 1] === '\n') i++;
            row.push(current.trim());
            if (row.length > 1) rows.push(row);
            row = [];
            current = '';
          } else {
            current += char;
          }
        }
        if (current || row.length > 0) {
          row.push(current.trim());
          if (row.length > 1) rows.push(row);
        }
        return rows;
      }

      function processData(rows: string[][]) {
        // Skip header row
        const dataRows = rows.slice(1);
        const seasonMap = new Map<string, SeasonData>();

        for (const row of dataRows) {
          const year = row[0];
          if (!year) continue;

          if (!seasonMap.has(year)) {
            const wins = parseInt(row[1]) || 0;
            const losses = parseInt(row[2]) || 0;
            seasonMap.set(year, {
              year,
              wins,
              losses,
              coach: row[3] || '',
              psG: parseFloat(row[4]) || 0,
              paG: parseFloat(row[5]) || 0,
              srs: parseFloat(row[6]) || 0,
              sos: parseFloat(row[7]) || 0,
              oRtg: parseFloat(row[8]) || 0,
              dRtg: parseFloat(row[9]) || 0,
              winPct: wins + losses > 0 ? wins / (wins + losses) : 0,
              games: []
            });
          }

          // Add game data
          const season = seasonMap.get(year)!;
          const resultCol = row[17]; // W or L column
          const teamScore = parseInt(row[18]) || 0;
          const oppScore = parseInt(row[19]) || 0;

          season.games.push({
            gameNum: parseInt(row[10]) || 0,
            date: row[11] || '',
            type: row[12] || '',
            location: row[13] || '',
            opponent: row[14] || '',
            conf: row[15] || '',
            teamScore,
            oppScore,
            result: resultCol || '',
            ot: row[20] || '',
            wins: parseInt(row[21]) || 0,
            losses: parseInt(row[22]) || 0,
            streak: row[23] || '',
            arena: row[24] || ''
          });
        }

        seasons = Array.from(seasonMap.values());
      }

      function sortSeasons() {
        seasons.sort((a, b) => {
          let aVal: any = a[currentSort.column as keyof SeasonData];
          let bVal: any = b[currentSort.column as keyof SeasonData];

          if (typeof aVal === 'string') {
            aVal = aVal.toLowerCase();
            bVal = (bVal as string).toLowerCase();
          }

          if (currentSort.direction === 'asc') {
            return aVal > bVal ? 1 : aVal < bVal ? -1 : 0;
          } else {
            return aVal < bVal ? 1 : aVal > bVal ? -1 : 0;
          }
        });
      }

      function renderTable() {
        const tbody = document.getElementById('season-table-body');
        if (!tbody) return;

        sortSeasons();

        let html = '';
        for (const season of seasons) {
          const isExpanded = expandedYear === season.year;
          const winPctColor = season.winPct >= 0.6 ? 'text-green-600 font-semibold' :
                             season.winPct < 0.4 ? 'text-red-600' : '';
          const srsColor = season.srs > 5 ? 'text-green-600 font-semibold' :
                          season.srs < -5 ? 'text-red-600' : '';

          html += `
            <tr class="border-b border-gray-100 hover:bg-gray-50 cursor-pointer season-row" data-year="${season.year}">
              <td class="py-3 px-3 font-medium text-gray-900">${season.year}</td>
              <td class="py-3 px-3 text-gray-700">${season.coach}</td>
              <td class="py-3 px-3 text-right font-semibold text-green-700">${season.wins}</td>
              <td class="py-3 px-3 text-right font-semibold text-red-600">${season.losses}</td>
              <td class="py-3 px-3 text-right ${winPctColor}">${(season.winPct * 100).toFixed(1)}%</td>
              <td class="py-3 px-3 text-right">${season.psG || '--'}</td>
              <td class="py-3 px-3 text-right">${season.paG || '--'}</td>
              <td class="py-3 px-3 text-right ${srsColor}">${season.srs || '--'}</td>
              <td class="py-3 px-3 text-right">${season.sos || '--'}</td>
              <td class="py-3 px-3 text-right">${season.oRtg || '--'}</td>
              <td class="py-3 px-3 text-right">${season.dRtg || '--'}</td>
              <td class="py-3 px-3 text-center">
                <svg class="w-5 h-5 transition-transform ${isExpanded ? 'rotate-180' : ''}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </td>
            </tr>
          `;

          if (isExpanded) {
            html += `
              <tr>
                <td colspan="12" class="p-0">
                  <div class="bg-gray-50 p-4">
                    <h3 class="font-bold text-gray-900 mb-3">${season.year} Game Results (${season.coach})</h3>
                    <div class="overflow-x-auto">
                      <table class="w-full text-xs">
                        <thead>
                          <tr class="border-b border-gray-300 bg-gray-100">
                            <th class="py-2 px-2 text-left">#</th>
                            <th class="py-2 px-2 text-left">Date</th>
                            <th class="py-2 px-2 text-left">Type</th>
                            <th class="py-2 px-2 text-left">Opponent</th>
                            <th class="py-2 px-2 text-left">Conf</th>
                            <th class="py-2 px-2 text-center">Result</th>
                            <th class="py-2 px-2 text-right">NEB</th>
                            <th class="py-2 px-2 text-right">OPP</th>
                            <th class="py-2 px-2 text-left">OT</th>
                            <th class="py-2 px-2 text-center">Record</th>
                            <th class="py-2 px-2 text-left">Streak</th>
                            <th class="py-2 px-2 text-left">Arena</th>
                          </tr>
                        </thead>
                        <tbody>
                          ${season.games.map(g => {
                            const loc = g.location === '@' ? '@ ' : g.location === 'N' ? 'N ' : '';
                            const resultClass = g.result === 'W' ? 'text-green-700 font-semibold' : 'text-red-600 font-semibold';
                            return `
                              <tr class="border-b border-gray-200 hover:bg-gray-100">
                                <td class="py-1.5 px-2">${g.gameNum}</td>
                                <td class="py-1.5 px-2 whitespace-nowrap">${g.date}</td>
                                <td class="py-1.5 px-2">${g.type}</td>
                                <td class="py-1.5 px-2 font-medium">${loc}${g.opponent}</td>
                                <td class="py-1.5 px-2 text-gray-500">${g.conf}</td>
                                <td class="py-1.5 px-2 text-center ${resultClass}">${g.result}</td>
                                <td class="py-1.5 px-2 text-right">${g.teamScore}</td>
                                <td class="py-1.5 px-2 text-right">${g.oppScore}</td>
                                <td class="py-1.5 px-2">${g.ot}</td>
                                <td class="py-1.5 px-2 text-center">${g.wins}-${g.losses}</td>
                                <td class="py-1.5 px-2">${g.streak}</td>
                                <td class="py-1.5 px-2 text-gray-500 max-w-[200px] truncate">${g.arena}</td>
                              </tr>
                            `;
                          }).join('')}
                        </tbody>
                      </table>
                    </div>
                  </div>
                </td>
              </tr>
            `;
          }
        }

        tbody.innerHTML = html;

        // Attach click handlers for expand/collapse
        document.querySelectorAll('.season-row').forEach(row => {
          row.addEventListener('click', () => {
            const year = (row as HTMLElement).dataset.year || '';
            expandedYear = expandedYear === year ? null : year;
            renderTable();
          });
        });
      }

      function updateSortArrows() {
        document.querySelectorAll('#season-table .sortable').forEach(th => {
          const col = (th as HTMLElement).dataset.sort;
          const arrow = th.querySelector('.sort-arrow');
          if (arrow) {
            if (col === currentSort.column) {
              arrow.textContent = currentSort.direction === 'asc' ? '\u25B2' : '\u25BC';
            } else {
              arrow.textContent = '';
            }
          }
        });
      }

      function renderChart(stat: string) {
        const canvas = document.getElementById('stats-chart') as HTMLCanvasElement;
        if (!canvas) return;

        // Sort by year ascending for the chart
        const sorted = [...seasons].sort((a, b) => a.year.localeCompare(b.year));
        const labels = sorted.map(s => s.year);
        const data = sorted.map(s => s[stat as keyof SeasonData] as number);

        const statLabels: Record<string, string> = {
          wins: 'Wins',
          losses: 'Losses',
          winPct: 'Win %',
          psG: 'Points Scored / Game',
          paG: 'Points Against / Game',
          srs: 'SRS',
          sos: 'Strength of Schedule',
          oRtg: 'Offensive Rating',
          dRtg: 'Defensive Rating'
        };

        if (chartInstance) {
          chartInstance.destroy();
        }

        const ctx = canvas.getContext('2d');
        chartInstance = new (window as any).Chart(ctx, {
          type: 'line',
          data: {
            labels,
            datasets: [{
              label: statLabels[stat] || stat,
              data,
              borderColor: '#b91c1c',
              backgroundColor: 'rgba(185, 28, 28, 0.1)',
              fill: true,
              tension: 0.3,
              pointRadius: 2,
              pointHoverRadius: 6,
              pointBackgroundColor: '#b91c1c',
              borderWidth: 2
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function(context: any) {
                    const val = context.parsed.y;
                    if (stat === 'winPct') return `${(val * 100).toFixed(1)}%`;
                    return `${statLabels[stat]}: ${val}`;
                  }
                }
              }
            },
            scales: {
              x: {
                ticks: {
                  maxRotation: 90,
                  autoSkip: true,
                  maxTicksLimit: 30,
                  font: { size: 10 }
                },
                grid: { display: false }
              },
              y: {
                beginAtZero: stat === 'wins' || stat === 'losses' || stat === 'winPct',
                ticks: {
                  callback: function(value: any) {
                    if (stat === 'winPct') return (value * 100).toFixed(0) + '%';
                    return value;
                  }
                }
              }
            },
            interaction: {
              intersect: false,
              mode: 'index'
            }
          }
        });
      }

      async function loadData() {
        try {
          const response = await fetch(CSV_URL);
          const text = await response.text();
          const rows = parseCSV(text);
          processData(rows);

          // Setup sort headers
          document.querySelectorAll('#season-table .sortable').forEach(th => {
            th.addEventListener('click', () => {
              const col = (th as HTMLElement).dataset.sort || 'year';
              if (currentSort.column === col) {
                currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
              } else {
                currentSort.column = col;
                currentSort.direction = col === 'year' ? 'desc' : 'desc';
              }
              updateSortArrows();
              renderTable();
            });
          });

          // Setup chart stat selector
          document.getElementById('chart-stat')?.addEventListener('change', (e) => {
            renderChart((e.target as HTMLSelectElement).value);
          });

          // Initial render
          updateSortArrows();
          renderTable();
          renderChart('wins');

          loading?.classList.add('hidden');
          content?.classList.remove('hidden');
          dataSource?.classList.remove('hidden');

        } catch (error) {
          console.error('Error loading data:', error);
          if (loading) {
            loading.innerHTML = '<p class="text-red-500">Error loading data. Please refresh.</p>';
          }
        }
      }

      loadData();
    });
  </script>
</Layout>
