---
import Layout from '../layouts/Layout.astro';

const popularPages = [
  { title: "UX Portfolio", href: "/ux-portfolio" },
  { title: "Logos", href: "/logos" },
  { title: "Apps", href: "/apps" },
  { title: "Lacrosse Photos", href: "/images/lacrosse" },
  { title: "Box Lacrosse", href: "/images/boxlacrosse" }
];
---

<Layout title="404 - Page Not Found">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="flex items-center justify-between gap-4 pb-4 border-b border-ink/15 eyebrow text-ink/60">
      <span>§ Error</span>
      <span class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-marker"></span>
        Page not found
      </span>
    </div>

    <div class="mt-10 md:mt-14 grid grid-cols-1 md:grid-cols-12 gap-10">
      <div class="md:col-span-7">
        {/* 404 Number */}
        <h1 class="display-xl text-[clamp(6rem,22vw,14rem)]"><span class="accent-bar">404</span></h1>

        {/* Main Message */}
        <h2 class="mt-6 text-3xl md:text-4xl font-bold tracking-tight">Page Not Found</h2>

        {/* Description */}
        <p class="mt-4 text-lg text-ink/70 max-w-md">
          Sorry, the page you're looking for doesn't exist or has been moved.
        </p>

        {/* Action Buttons */}
        <div class="mt-10 flex flex-col sm:flex-row gap-3">
          <a
            href="/"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-ink text-paper eyebrow hover:bg-ink/85 transition-colors duration-200"
          >
            Back to Home <span aria-hidden="true">→</span>
          </a>

          <a
            href="/images"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 border border-ink text-ink eyebrow hover:bg-ink hover:text-paper transition-colors duration-200"
          >
            View Images <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      {/* Popular Links */}
      <div class="md:col-start-9 md:col-span-4 self-end">
        <p class="eyebrow text-ink/60 pb-3 border-b border-ink">Popular pages:</p>
        <ul>
          {popularPages.map((page, index) => (
            <li>
              <a href={page.href} class="group flex items-baseline gap-4 py-4 border-b border-ink/15">
                <span class="eyebrow text-ink/40">{String(index + 1).padStart(2, '0')}</span>
                <span class="flex-1 font-display text-xl font-bold tracking-tight transition-colors group-hover:text-accent">{page.title}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</Layout>
