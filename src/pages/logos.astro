---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { baseUrl } from '../config';

const logoItems = [
  {
    title: "DevObsessed",
    description: "Logo design for a software development consulting company.",
    logo: "/logos/devobsessed/3_logo_variations.png",
    slug: "devobsessed"
  },
  {
    title: "I-80 Club",
    description: "Logo design for a social club focused on community engagement.",
    logo: "/logos/i80club/3_logo_variations.png",
    slug: "i80club"
  },
  {
    title: "Connectaha",
    description: "Logo design for a community-focused organization in Omaha.",
    logo: "/logos/connectaha/ConnectahaBugOnly_R.png",
    slug: "connectaha"
  },
  {
    title: "King Creek Woodworks",
    description: "Logo design for a custom woodworking business.",
    logo: "/logos/kingcreekwoodworks/Logocard.png",
    slug: "kingcreekwoodworks"
  }
];

console.log('DevObsessed logo URL:', `${baseUrl}/images/logos/devobsessedcard.png`);
---

<Layout title="Logos">
  <div class="w-full max-w-full overflow-x-hidden">
    {/* Page header */}
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 md:pt-20 pb-12 md:pb-16">
      <div class="flex items-center justify-between gap-4 pb-4 border-b border-ink/15 eyebrow text-ink/60">
        <span>§ Logos</span>
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-marker"></span>
          {String(logoItems.length).padStart(2, '0')} identities
        </span>
      </div>
      <h1 class="display-xl mt-10 md:mt-14"><span class="accent-bar">Logos</span></h1>
      <p class="mt-8 max-w-xl text-lg md:text-xl text-ink/75">
        Logo designs and branding work.
      </p>
    </section>

    {/* Logo Grid */}
    <section id="logo-cards" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-20 md:pt-12 md:pb-28">
      <div class="flex items-end justify-between gap-6 pb-6 mb-12 border-b border-ink">
        <div>
          <p class="eyebrow text-ink/60 mb-4">§ Index — Identities</p>
          <h2 class="display-lg">Branding work.</h2>
        </div>
        <p class="eyebrow text-ink/60 text-right">{String(logoItems.length).padStart(2, '0')} logos</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-16">
        {logoItems.map((item, index) => (
          <a
            href={`${baseUrl}/logos/${item.slug}`}
            class="group grid grid-rows-subgrid row-span-3 gap-y-0 scroll-fade-in magnetic-card"
            data-index={index}
            style="opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease-out, transform 0.6s ease-out;"
          >
            <div class="relative h-64 md:h-80 bg-white border border-ink/10 flex items-center justify-center p-12">
              <img
                src={item.logo}
                alt={`${item.title} logo`}
                width="144"
                height="144"
                class="object-contain max-h-full w-auto transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <span class="chip absolute top-4 left-4 bg-paper text-ink">N° {String(index + 1).padStart(2, '0')}</span>
            </div>
            <div class="mt-5 flex items-end justify-between gap-4 pb-3 border-b border-ink">
              <h2 class="text-2xl md:text-3xl font-bold tracking-tight transition-colors group-hover:text-accent">{item.title}</h2>
              <span class="text-xl" aria-hidden="true">↗</span>
            </div>
            <p class="mt-3 text-ink/70 leading-relaxed">{item.description}</p>
          </a>
        ))}
      </div>
    </section>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      // Scroll-triggered animations using Intersection Observer
      const animatedCards = document.querySelectorAll('.scroll-fade-in');

      if (animatedCards.length > 0 && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const element = entry.target as HTMLElement;
              const index = parseInt(element.dataset.index || '0');
              setTimeout(() => {
                element.style.opacity = '1';
                element.style.transform = 'translateY(0)';
              }, index * 100);
              observer.unobserve(element);
            }
          });
        }, {
          threshold: 0.1,
          rootMargin: '0px 0px -50px 0px'
        });

        animatedCards.forEach((card) => {
          observer.observe(card);
        });
      } else {
        animatedCards.forEach((card) => {
          (card as HTMLElement).style.opacity = '1';
          (card as HTMLElement).style.transform = 'translateY(0)';
        });
      }

      // Magnetic hover effects
      const magneticCards = document.querySelectorAll('.magnetic-card');
      const magneticStrength = 0.15;

      magneticCards.forEach((card) => {
        const cardElement = card as HTMLElement;
        let currentX = 0;
        let currentY = 0;
        let targetX = 0;
        let targetY = 0;
        let rafId: number | null = null;

        function animate() {
          currentX += (targetX - currentX) * 0.1;
          currentY += (targetY - currentY) * 0.1;

          cardElement.style.transform = `translate(${currentX}px, ${currentY}px)`;

          if (Math.abs(targetX - currentX) > 0.1 || Math.abs(targetY - currentY) > 0.1) {
            rafId = requestAnimationFrame(animate);
          } else {
            rafId = null;
          }
        }

        cardElement.addEventListener('mouseenter', () => {
          cardElement.style.transition = 'none';
        });

        cardElement.addEventListener('mouseleave', () => {
          targetX = 0;
          targetY = 0;
          cardElement.style.transition = 'transform 0.3s ease-out';
          if (rafId) {
            cancelAnimationFrame(rafId);
          }
          animate();
        });

        cardElement.addEventListener('mousemove', (e) => {
          const rect = cardElement.getBoundingClientRect();
          const centerX = rect.left + rect.width / 2;
          const centerY = rect.top + rect.height / 2;

          const deltaX = (e.clientX - centerX) * magneticStrength;
          const deltaY = (e.clientY - centerY) * magneticStrength;

          targetX = deltaX;
          targetY = deltaY;

          if (!rafId) {
            rafId = requestAnimationFrame(animate);
          }
        });
      });
    });
  </script>
</Layout> 