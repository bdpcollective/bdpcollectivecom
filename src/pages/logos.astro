---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { baseUrl } from '../config';

const logoItems = [
  {
    title: "DevObsessed",
    description: "Logo design for a software development consulting company.",
    logo: "/logos/devobsessed/3_logo_variations.png",
    slug: "devobsessed"
  },
  {
    title: "I-80 Club",
    description: "Logo design for a social club focused on community engagement.",
    logo: "/logos/i80club/3_logo_variations.png",
    slug: "i80club"
  },
  {
    title: "Connectaha",
    description: "Logo design for a community-focused organization in Omaha.",
    logo: "/logos/connectaha/ConnectahaBugOnly_R.png",
    slug: "connectaha"
  },
  {
    title: "King Creek Woodworks",
    description: "Logo design for a custom woodworking business.",
    logo: "/logos/kingcreekwoodworks/Logocard.png",
    slug: "kingcreekwoodworks"
  }
];

console.log('DevObsessed logo URL:', `${baseUrl}/images/logos/devobsessedcard.png`);
---

<Layout title="Logos">
  <main>
    {/* Hero Section */}
    <section class="relative h-[50vh] bg-black">
      {/* Hero Content */}
      <div class="relative z-10 flex flex-col items-center h-full">
        <div class="flex-1 flex items-center">
          <div class="text-center px-4">
            <h1 class="text-4xl md:text-6xl font-bold mb-6 text-white">
              Logos
            </h1>
            <p class="text-lg md:text-xl text-gray-200 mb-8 max-w-2xl mx-auto">
              Logo designs and branding work.
            </p>
          </div>
        </div>
        
        {/* Chevron */}
        <button
          id="scroll-to-logos"
          class="animate-bounce p-2 rounded-full bg-white/10 hover:bg-white/20 transition-colors mb-8"
          aria-label="Scroll to logo categories"
        >
          <svg
            class="w-8 h-8 text-white"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </button>
      </div>
    </section>

    {/* Logo Grid */}
    <section id="logo-cards" class="container mx-auto px-4 py-20">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {logoItems.map((item, index) => (
          <a
            href={`${baseUrl}/logos/${item.slug}`}
            class="group h-full scroll-fade-in magnetic-card"
            data-index={index}
            style="opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease-out, transform 0.6s ease-out;"
          >
            <div class="relative overflow-hidden rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-all hover:shadow-md h-full flex flex-col">
              <div class="h-36 mb-4 flex items-center justify-center">
                <img
                  src={item.logo}
                  alt={`${item.title} logo`}
                  width="144"
                  height="144"
                  class="object-contain max-h-full transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <h2 class="text-xl font-semibold mb-2 text-gray-900">{item.title}</h2>
              <p class="text-gray-700">{item.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <script>
    document.addEventListener('astro:page-load', () => {
      // Scroll to logos button
      const scrollBtn = document.getElementById('scroll-to-logos');
      const target = document.getElementById('logo-cards');
      if (scrollBtn && target) {
        scrollBtn.addEventListener('click', () => {
          target.scrollIntoView({ behavior: 'smooth' });
        }, { passive: true });
      }

      // Scroll-triggered animations using Intersection Observer
      const animatedCards = document.querySelectorAll('.scroll-fade-in');

      if (animatedCards.length > 0 && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const element = entry.target as HTMLElement;
              const index = parseInt(element.dataset.index || '0');
              setTimeout(() => {
                element.style.opacity = '1';
                element.style.transform = 'translateY(0)';
              }, index * 100);
              observer.unobserve(element);
            }
          });
        }, {
          threshold: 0.1,
          rootMargin: '0px 0px -50px 0px'
        });

        animatedCards.forEach((card) => {
          observer.observe(card);
        });
      } else {
        animatedCards.forEach((card) => {
          (card as HTMLElement).style.opacity = '1';
          (card as HTMLElement).style.transform = 'translateY(0)';
        });
      }

      // Magnetic hover effects
      const magneticCards = document.querySelectorAll('.magnetic-card');
      const magneticStrength = 0.15;

      magneticCards.forEach((card) => {
        const cardElement = card as HTMLElement;
        let currentX = 0;
        let currentY = 0;
        let targetX = 0;
        let targetY = 0;
        let rafId: number | null = null;

        function animate() {
          currentX += (targetX - currentX) * 0.1;
          currentY += (targetY - currentY) * 0.1;

          cardElement.style.transform = `translate(${currentX}px, ${currentY}px)`;

          if (Math.abs(targetX - currentX) > 0.1 || Math.abs(targetY - currentY) > 0.1) {
            rafId = requestAnimationFrame(animate);
          } else {
            rafId = null;
          }
        }

        cardElement.addEventListener('mouseenter', () => {
          cardElement.style.transition = 'none';
        });

        cardElement.addEventListener('mouseleave', () => {
          targetX = 0;
          targetY = 0;
          cardElement.style.transition = 'transform 0.3s ease-out';
          if (rafId) {
            cancelAnimationFrame(rafId);
          }
          animate();
        });

        cardElement.addEventListener('mousemove', (e) => {
          const rect = cardElement.getBoundingClientRect();
          const centerX = rect.left + rect.width / 2;
          const centerY = rect.top + rect.height / 2;

          const deltaX = (e.clientX - centerX) * magneticStrength;
          const deltaY = (e.clientY - centerY) * magneticStrength;

          targetX = deltaX;
          targetY = deltaY;

          if (!rafId) {
            rafId = requestAnimationFrame(animate);
          }
        });
      });
    });
  </script>
</Layout> 