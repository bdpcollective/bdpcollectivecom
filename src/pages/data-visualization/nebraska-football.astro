---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Nebraska Football Analytics">
  <main>
    {/* Hero Section */}
    <section class="relative h-[25vh] bg-black pt-16">
      <div class="relative z-10 flex flex-col justify-center h-full px-4 container mx-auto">
        <div class="max-w-7xl mx-auto w-full">
          <h1 class="text-4xl md:text-6xl font-bold mb-4 text-white">
            Nebraska Football Analytics
          </h1>
          <p class="text-lg md:text-xl text-gray-300 mb-4 max-w-2xl">
            Interactive visualizations of Nebraska football statistics and trends
          </p>
        </div>
      </div>
    </section>

    {/* Content Section */}
    <section class="container mx-auto px-4 py-20">
      <div class="max-w-7xl mx-auto">
        <a
          href="/apps"
          class="inline-flex items-center text-gray-600 hover:text-[#E41E3F] transition-colors mb-8"
        >
          <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Apps
        </a>

        <div class="bg-white rounded-lg shadow-lg p-6 mb-8">
          <h2 class="text-2xl font-bold mb-4">20 Years of Nebraska Football | Statistics by Week | 2005-2024</h2>
          <div id="nebraska-football-chart">
            <!-- Chart will be rendered here -->
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  // Import and initialize the chart component
  import NebraskaFootballChart from '../../components/NebraskaFootballChart';
  
  // Initialize the chart when the page loads
  document.addEventListener('DOMContentLoaded', () => {
    const chartContainer = document.getElementById('nebraska-football-chart');
    if (chartContainer) {
      NebraskaFootballChart(chartContainer);
    }
  });
</script> 