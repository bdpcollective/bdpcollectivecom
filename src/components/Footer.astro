---
import { baseUrl } from '../config';
---

<footer class="bg-black text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="text-lg font-semibold mb-4">About Us</h3>
        <p class="text-gray-300">Brian Pope is a Principal UX Designer at DevObsessed, an IT services and consulting company based in Omaha, Nebraska. With over 13 years of experience, he specializes in delivering user-centered solutions across industries such as retail, finance, government, and healthcare. Brian has been involved in the software development industry for more than 15 years. He earned his degree from the University of Nebraska-Lincoln.</p>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-4">Quick Links</h3>
        <ul class="space-y-2">
          <li><a href={`${baseUrl}/`} class="text-gray-300 hover:text-white">Home</a></li>
          <li><a href={`${baseUrl}/ux-portfolio`} class="text-gray-300 hover:text-white">UX Portfolio</a></li>
          <li><a href={`${baseUrl}/data-visualization`} class="text-gray-300 hover:text-white">Data Visualization</a></li>
          <li><a href={`${baseUrl}/images`} class="text-gray-300 hover:text-white">Images</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-4">Contact</h3>
        <div class="flex space-x-4">
          <a href="https://www.linkedin.com/in/popeb/" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white">
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="https://bsky.app/profile/bdpcollective.bsky.social" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white">
            <img src={`${baseUrl}/logos/bluesky.svg`} alt="Bluesky" class="w-8 h-8" />
          </a>
        </div>
      </div>
    </div>
    <div class="mt-8 pt-8 border-t border-gray-700 text-left text-gray-300">
      <p>&copy; {new Date().getFullYear()} Your Company. All rights reserved.</p>
    </div>
  </div>
</footer> 