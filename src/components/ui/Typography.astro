---
interface Props {
  variant?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'body' | 'small' | 'caption';
  weight?: 'normal' | 'medium' | 'semibold' | 'bold';
  color?: 'default' | 'primary' | 'secondary' | 'muted';
  align?: 'left' | 'center' | 'right';
  class?: string;
}

const {
  variant = 'body',
  weight = 'normal',
  color = 'default',
  align = 'left',
  class: className = '',
} = Astro.props;

const variantClasses: Record<string, string> = {
  h1: 'text-4xl md:text-5xl font-bold',
  h2: 'text-3xl md:text-4xl font-bold',
  h3: 'text-2xl md:text-3xl font-bold',
  h4: 'text-xl md:text-2xl font-bold',
  h5: 'text-lg md:text-xl font-bold',
  h6: 'text-base md:text-lg font-bold',
  body: 'text-base',
  small: 'text-sm',
  caption: 'text-xs',
};

const weightClasses: Record<string, string> = {
  normal: 'font-normal',
  medium: 'font-medium',
  semibold: 'font-semibold',
  bold: 'font-bold',
};

const colorClasses: Record<string, string> = {
  default: 'text-gray-900',
  primary: 'text-primary',
  secondary: 'text-secondary',
  muted: 'text-gray-500',
};

const alignClasses: Record<string, string> = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right',
};

const classes = `${variantClasses[variant]} ${weightClasses[weight]} ${colorClasses[color]} ${alignClasses[align]} ${className}`;
---

{variant.startsWith('h') ? (
  <Fragment set:html={`<h${variant.slice(1)} class="${classes}"><slot /></h${variant.slice(1)}>`} />
) : (
  <p class={classes}>
    <slot />
  </p>
)} 